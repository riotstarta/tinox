// amqps:// (AMQP-0-9-1 über TLS) — TLS-Variante von amqp_publish_consume.tnx.
// Braucht einen Broker mit aktiviertem TLS-Listener (Port 5671), z. B. eine
// RabbitMQ-Instanz mit RABBITMQ_SSL_CERTFILE/KEYFILE/CACERTFILE konfiguriert.
// OpenSSL ist standardmäßig gelinkt, kein Extra-Build-Flag nötig.
//
// verify=true (unten) prüft die Broker-Zertifikatskette + den Hostnamen
// gegen die System-CA-Stores — für ein selbstsigniertes Testzertifikat
// (ohne eigene CA im System-Trust-Store) auf false setzen, sonst schlägt
// der Handshake mit "certificate verify failed" fehl (das ist beabsichtigt,
// kein Bug — s. bugs.md).
//
// Start:  tinox run examples/amqps_publish_consume.tnx

import tinox.core.amqp091;

class Main
{
    fnc main() -> Int32 {
        let conn = AmqpConnection091::connectTls("127.0.0.1", 5671, "/", "guest", "guest", true);
        if conn.conn <= 0 {
            println("Verbindung fehlgeschlagen: " + conn.errorMessage);
            return 1;
        }

        let ch = AmqpChannel091::open(conn);
        if ch.chanId <= 0 {
            println("Channel fehlgeschlagen: " + ch.errorMessage);
            return 1;
        }

        let queueName = ch.declareQueue("tinox-tls-demo-queue", true, false, false);
        if queueName.len() == 0 {
            println("queue.declare fehlgeschlagen: " + ch.errorMessage);
            return 1;
        }
        println("Queue: " + queueName);

        ch.qos(10);

        var i: Int64 = 0;
        while i < 3 {
            var body: List<Int64> = [];
            let text = "Nachricht ueber TLS #" + i.toString();
            for j in 0..text.len() {
                body.push(text.charCodeAt(j) & 0xFF);
            }
            ch.publish("", queueName, body, "text/plain");
            println("gesendet: " + text);
            i = i + 1;
        }

        let consumerTag = ch.consume(queueName);
        if consumerTag.len() == 0 {
            println("basic.consume fehlgeschlagen: " + ch.errorMessage);
            return 1;
        }

        var received: Int64 = 0;
        while received < 3 {
            let m = ch.nextMessage();
            if !m.ok {
                println("Empfang fehlgeschlagen: " + m.errorMessage);
                return 1;
            }
            var text: String = "";
            for j in 0..m.body.len() {
                text = text + fromCharCode(m.body[j]);
            }
            println("empfangen: " + text + " (Tag " + m.deliveryTag.toString() + ")");
            ch.ack(m.deliveryTag);
            received = received + 1;
        }

        conn.close();
        println("fertig");
        return 0;
    }
}
