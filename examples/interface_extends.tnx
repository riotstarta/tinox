interface IShape
{
    fn area() -> Int64;
}

interface IDrawable extends IShape
{
    fn draw() -> Nothing;
}

class Circle implements IDrawable
{
    package fn draw() -> Nothing
    {
    }

    package fn area() -> Int64
    {
        return 42;
    }
}

fn main() -> Int64
{
    let c = Circle {};
    let d: IDrawable = c;
    d.draw();
    println(d.area());
    return 0;
}
