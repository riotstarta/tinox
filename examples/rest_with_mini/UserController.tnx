import tinox.core.http_server;
import tinox.core.json;
import User;

// Auto-serialize mode throughout (no @HttpContext param, return type is
// the real domain object) -- the compiler serializes the returned
// List<User>/User as the JSON response body itself, replacing the
// manual Json::serialize(...)/ctx.response.body= wiring this example
// used to demonstrate.
class UserController
{
    @GET
    @Path("/users")
    @Produces("application/json")
    @StatusCode(200)
    fn listUsers() -> List<User>
    {
        return [User { id: 1, name: "Alice" }, User { id: 2, name: "Bob" }];
    }

    @POST
    @Path("/users")
    @Consumes("application/json")
    @StatusCode(201)
    fn createUser(@PostParam user: User) -> User
    {
        return user;
    }
}
