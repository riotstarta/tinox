// Standalone opaque HTTP-client response handle for this app's outbound
// request to the IdP's JWKS endpoint. Deliberately NOT using
// tinox.core.http's `Http`/`HttpResponse` (or tinox.core.jwt's `Jwks`,
// which uses it internally): that module's `HttpResponse` class shares
// its bare name with tinox.core.http_server's `HttpResponse` (this app's
// REST framework), and the compiler's codegen-level class-layout table is
// not namespace-qualified -- importing both in the same program silently
// corrupts one of the two classes' field layout (found while building
// this example; filed as issue #139, a known compiler limitation, not
// specific to this app). Declaring our own extern bindings to the same
// runtime.c symbols under a distinct class name sidesteps it entirely.
extern fn httpGet(url: String) -> IdpHttpResponse;
extern fn httpStatusCode(resp: IdpHttpResponse) -> Int64;
extern fn httpBody(resp: IdpHttpResponse) -> String;

class IdpHttpResponse {}
