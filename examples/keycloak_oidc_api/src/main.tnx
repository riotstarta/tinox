// Example: a REST endpoint that only lets requests through whose OIDC
// access token contains a specific realm role -- and verifies that token
// live against a real IdP (Keycloak, via docker-compose.yml in this
// directory) rather than trusting a client-supplied claim. Every piece of
// IdP config (issuer, JWKS endpoint, expected audience, required role) is
// read from the environment, so this same code works against any
// Keycloak realm (or any other RS256/JWKS-based IdP) without a rebuild.
//
// See README.md for how to start Keycloak, obtain a token, and call this
// endpoint.
//
// This is a *resource server* validating a Bearer token that some other
// client already obtained -- there is no login/redirect here, so
// tinox.core.oidc's OidcClient (built for the Authorization Code + PKCE
// *login* flow) is not the right tool. The natural fit would otherwise be
// tinox.core.jwt's `Jwt`/`Jwks` (RS256 verification + JWKS lookup by
// kid), but that module's `Jwks` pulls in tinox.core.http, whose
// `HttpResponse` class collides with tinox.core.http_server's
// same-named class in the compiler's (not namespace-qualified) codegen
// layout table -- see issue #139, found while building this example.
// Until that's fixed, this file inlines the same RS256/JWKS verification
// logic using only non-colliding primitives (Base64, Json, and its own
// extern HTTP bindings in IdpHttpResponse.tnx) instead of importing
// tinox.core.jwt.

import tinox.core.http_server;
import tinox.core.base64;
import tinox.core.json;
import tinox.core.env;
import tinox.core.process;
import tinox.core.time;
import IdpHttpResponse;

extern fn rsaVerifySha256(message: List<Int64>, signature: List<Int64>, modulus: List<Int64>, exponent: List<Int64>) -> Bool;

fn requiredEnv(name: String) -> String
{
    let value: String = Env::getVar(name);
    if value == ""
    {
        println("Missing required environment variable: " + name);
        Process::exit(1);
    }
    return value;
}

fn stringToBytes(s: String) -> List<Int64>
{
    var bytes: List<Int64> = [];
    var i: Int64 = 0;
    while i < s.len()
    {
        bytes.push(s.charCodeAt(i) & 0xFF);
        i = i + 1;
    }
    return bytes;
}

fn bytesToString(b: List<Int64>) -> String
{
    var s: String = "";
    var i: Int64 = 0;
    while i < b.len()
    {
        s = s + fromCharCode(b[i]);
        i = i + 1;
    }
    return s;
}

// Decodes a base64url JWS segment (RFC 7515 §3) into its JSON object.
fn decodeSegment(part: String) -> Map<String, JsonValue>
{
    let json: String = bytesToString(Base64::decodeUrlBytes(part));
    return Json::parse(json).asTable();
}

// Fetches the IdP's JWKS document (RFC 7517 §5) and returns the RSA
// public key (still base64url-encoded, as JWKS serves it) matching `kid`.
// `kid == ""` is only unambiguous if the JWKS contains exactly one RSA
// key -- otherwise this throws rather than silently picking the first
// match, same reasoning as tinox.core.jwt's Jwks::fetchRsaKey.
fn fetchJwksKey(jwksUri: String, kid: String) -> Map<String, String>
{
    let resp: IdpHttpResponse = httpGet(jwksUri);
    if httpStatusCode(resp) == 0
    {
        throw "network error fetching JWKS from " + jwksUri;
    }
    if httpStatusCode(resp) < 200 || httpStatusCode(resp) >= 300
    {
        throw "JWKS endpoint " + jwksUri + " returned HTTP " + httpStatusCode(resp).toString();
    }

    let doc: Map<String, JsonValue> = Json::parse(httpBody(resp)).asTable();
    if !doc.contains("keys")
    {
        throw "JWKS document from " + jwksUri + " has no 'keys' field";
    }
    let keys: List<JsonValue> = doc["keys"].asList();

    var foundN: String = "";
    var foundE: String = "";
    var matches: Int64 = 0;
    var i: Int64 = 0;
    while i < keys.len()
    {
        let entry: Map<String, JsonValue> = keys[i].asTable();
        if entry.contains("kty") && entry["kty"].getString() == "RSA" && entry.contains("n") && entry.contains("e")
        {
            var entryKid: String = "";
            if entry.contains("kid")
            {
                entryKid = entry["kid"].getString();
            }
            if kid == "" || entryKid == kid
            {
                foundN = entry["n"].getString();
                foundE = entry["e"].getString();
                matches = matches + 1;
            }
        }
        i = i + 1;
    }

    if matches == 0
    {
        throw "no matching RSA key found in JWKS for kid \"" + kid + "\"";
    }
    if matches > 1
    {
        throw "ambiguous JWKS: multiple RSA keys match kid \"" + kid + "\"";
    }

    var result: Map<String, String> = Map::new();
    result.insert("n", foundN);
    result.insert("e", foundE);
    return result;
}

// Verifies an RS256 access token's signature (against the IdP's JWKS,
// matched by the token's own "kid" header) plus its exp/nbf/iss/aud
// claims, and returns the verified claims. Throws (String) on any
// failure -- an alg other than RS256 is rejected outright (alg-confusion
// hardening: never verify a token under a different scheme than the one
// this app was told to trust).
fn verifyAccessToken(token: String, issuer: String, jwksUri: String, audience: String) -> Map<String, JsonValue>
{
    let parts: List<String> = token.split(".");
    if parts.len() != 3
    {
        throw "invalid JWT format";
    }

    let header: Map<String, JsonValue> = decodeSegment(parts[0]);
    if !header.contains("alg") || header["alg"].getString() != "RS256"
    {
        throw "unsupported token alg (expected RS256)";
    }
    var kid: String = "";
    if header.contains("kid")
    {
        kid = header["kid"].getString();
    }

    // No key material is ever hardcoded in this app -- Keycloak's
    // routine key rotation just works.
    let key: Map<String, String> = fetchJwksKey(jwksUri, kid);
    let message: String = parts[0] + "." + parts[1];
    let sigBytes: List<Int64> = Base64::decodeUrlBytes(parts[2]);
    let nBytes: List<Int64> = Base64::decodeUrlBytes(key["n"]);
    let eBytes: List<Int64> = Base64::decodeUrlBytes(key["e"]);
    if !rsaVerifySha256(stringToBytes(message), sigBytes, nBytes, eBytes)
    {
        throw "invalid signature";
    }

    let claims: Map<String, JsonValue> = decodeSegment(parts[1]);

    let now: Int64 = Time::now() / 1000;
    if claims.contains("exp") && now > claims["exp"].asInt()
    {
        throw "token expired";
    }
    if claims.contains("nbf") && now < claims["nbf"].asInt()
    {
        throw "token not yet valid (nbf)";
    }

    if !claims.contains("iss") || claims["iss"].getString() != issuer
    {
        throw "token issuer mismatch";
    }

    var audMatches: Bool = false;
    if claims.contains("aud")
    {
        if claims["aud"].isString()
        {
            audMatches = claims["aud"].getString() == audience;
        }
        else if claims["aud"].isArray()
        {
            let auds: List<JsonValue> = claims["aud"].asList();
            var i: Int64 = 0;
            while i < auds.len()
            {
                if auds[i].getString() == audience
                {
                    audMatches = true;
                }
                i = i + 1;
            }
        }
    }
    if !audMatches
    {
        throw "token audience mismatch";
    }

    return claims;
}

// Verifies the Authorization: Bearer <token> header against the configured
// IdP and checks that `requiredRole` is present in the token's Keycloak-
// style `realm_access.roles` claim. On any failure this sets ctx.response
// itself (401 for a missing/unverifiable token, 403 for a valid token
// missing the role) and returns false -- callers must `return;`
// immediately when this returns false, without writing any other response.
fn requireRole(ctx: HttpContext, issuer: String, jwksUri: String, audience: String, requiredRole: String) -> Bool
{
    let auth: String = ctx.request.getHeader("Authorization");
    if !auth.startsWith("Bearer ")
    {
        ctx.response.status(401).json("{\"error\":\"missing bearer token\"}");
        return false;
    }
    let token: String = auth.substring(7, auth.len());

    var claims: Map<String, JsonValue> = Map::new();
    var verifyError: String = "";
    try
    {
        claims = verifyAccessToken(token, issuer, jwksUri, audience);
    }
    catch e: String
    {
        verifyError = e;
    }

    if verifyError != ""
    {
        ctx.response.status(401).json("{\"error\":\"invalid token: " + verifyError + "\"}");
        return false;
    }

    var hasRole: Bool = false;
    if claims.contains("realm_access")
    {
        let realmAccess: Map<String, JsonValue> = claims["realm_access"].asTable();
        if realmAccess.contains("roles")
        {
            let roles: List<JsonValue> = realmAccess["roles"].asList();
            var i: Int64 = 0;
            while i < roles.len()
            {
                if roles[i].getString() == requiredRole
                {
                    hasRole = true;
                }
                i = i + 1;
            }
        }
    }
    if !hasRole
    {
        ctx.response.status(403).json("{\"error\":\"missing required role: " + requiredRole + "\"}");
        return false;
    }

    return true;
}

fn main() -> Int32
{
    let issuer: String = requiredEnv("OIDC_ISSUER");
    let jwksUri: String = requiredEnv("OIDC_JWKS_URI");
    let audience: String = requiredEnv("OIDC_AUDIENCE");
    let requiredRole: String = requiredEnv("OIDC_REQUIRED_ROLE");

    var port: Int64 = 8090;
    let portEnv: String = Env::getVar("PORT");
    if portEnv != ""
    {
        port = portEnv.toInt();
    }

    let server: HttpServer = HttpServer::new(port);

    server.get("/api/hello", ctx => {
        if !requireRole(ctx, issuer, jwksUri, audience, requiredRole)
        {
            return;
        }
        ctx.response.status(200).json("{\"message\":\"Hello, you are authorized!\",\"requiredRole\":\"" + requiredRole + "\"}");
    });

    println("Listening on http://localhost:" + port.toString());
    println("  issuer:        " + issuer);
    println("  jwks:          " + jwksUri);
    println("  audience:      " + audience);
    println("  required role: " + requiredRole);
    server.listen();

    return 0;
}
