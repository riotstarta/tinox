// WebSocket-Echo-Server über Annotationen (tasklist.md Phase 6).
// Start:  tinox run examples/ws_echo_annotated.tnx
// Test:   Browser-Konsole:  s = new WebSocket("ws://localhost:8793/echo");
//         s.onmessage = e => console.log(e.data); s.onopen = () => s.send("hallo");
//
// @WebsocketEndpoint generiert den kompletten Accept/Handshake/Message-Loop als
// main (nur gültig, wenn die Datei kein eigenes `main` definiert und genau
// eine @WebsocketEndpoint-Klasse enthält). Kein Lambda-Handler nötig — die
// @OnOpen/@OnMessage/@OnClose-Methoden werden vom Compiler direkt beim Namen
// aufgerufen. Nur Text-Frames (Opcode 1) gehen an @OnMessage; alles andere
// (Binary, Close, EOF, Protokollfehler) beendet die Verbindung.

import tinox.core.websocket;

@WebsocketEndpoint("/echo", 8793)
class EchoEndpoint
{
    @OnOpen
    fn onOpen(conn: Int64) -> Nothing
    {
        println("Client verbunden");
    }

    @OnMessage
    fn onMessage(conn: Int64, msg: String) -> Nothing
    {
        println("empfangen: " + msg);
        Ws::sendText(conn, "echo: " + msg);
    }

    @OnClose
    fn onClose(conn: Int64) -> Nothing
    {
        println("Client getrennt");
    }
}
