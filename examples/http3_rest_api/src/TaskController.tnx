// Declarative counterpart to main.tnx's hand-written Http3Server::new()/
// .get()/.post()/... version -- same Task CRUD surface, but every route
// is just a @GET/@POST/@PUT/@PATCH/@DELETE + @Path method, exactly like
// the plain (TCP) REST annotations in examples/rest_minimal. The single
// @Http3RestController(port, cert, key) annotation is what routes these
// through tinox.core.http3_server.Http3Server (QUIC) instead of the
// TCP auto-server -- the compiler generates the entire Http3Server::new/
// .get/.post/.../listen() wiring that main.tnx writes out by hand.
//
// @ApplicationComponent makes the compiler reuse ONE TaskController
// instance across every request (via a generated _di_get() singleton
// getter) instead of allocating a fresh, zeroed instance per call --
// required here since `tasks` needs to persist between requests. That
// getter zero-allocates the instance (it does not call any constructor),
// so `tasks`/`initialized` start out as null/false; ensureInit() lazily
// seeds `tasks` on first use rather than relying on a constructor that
// never runs.
import tinox.core.http3_server;
import tinox.core.json;
import Task;

@ApplicationComponent
@Http3RestController(8843, "cert.pem", "key.pem")
class TaskController
{
    var tasks: List<Task>;
    var initialized: Bool;

    // Issue #149 stage 2: these three were free top-level functions;
    // now static `fnc` siblings, called bare from the instance methods
    // below exactly as before (resolved via check_call's same-class
    // fallback, not `this.` -- they don't need a TaskController receiver).
    fnc findTaskIndex(tasks: List<Task>, id: Int64) -> Int64
    {
        var i: Int64 = 0;
        while i < tasks.len()
        {
            if tasks[i].id == id
            {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    fnc nextTaskId(tasks: List<Task>) -> Int64
    {
        var maxId: Int64 = 0;
        var i: Int64 = 0;
        while i < tasks.len()
        {
            if tasks[i].id > maxId
            {
                maxId = tasks[i].id;
            }
            i = i + 1;
        }
        return maxId + 1;
    }

    fnc removeTaskAt(tasks: List<Task>, index: Int64) -> Nothing
    {
        var i: Int64 = index;
        while i < tasks.len() - 1
        {
            tasks[i] = tasks[i + 1];
            i = i + 1;
        }
        tasks.pop();
    }

    fn ensureInit() -> Nothing
    {
        if !this.initialized
        {
            this.tasks = [
                Task { id: 1, title: "Try tinox.core.http3_server", done: false },
                Task { id: 2, title: "curl --http3-only this API", done: false }
            ];
            this.initialized = true;
        }
    }

    @GET
    @Path("/tasks")
    fn listTasks(ctx: HttpContext) -> Nothing
    {
        this.ensureInit();
        ctx.response.json(Json::serialize(this.tasks));
    }

    @GET
    @Path("/tasks/:id")
    fn getTask(ctx: HttpContext) -> Nothing
    {
        this.ensureInit();
        let id: Int64 = ctx.request.getParam("id").toInt();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if idx < 0
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return;
        }
        ctx.response.json(Json::serialize(this.tasks[idx]));
    }

    @POST
    @Path("/tasks")
    @StatusCode(201)
    fn createTask(ctx: HttpContext) -> Nothing
    {
        this.ensureInit();
        let incoming: Task = Json::deserialize<Task>(ctx.request.body);
        incoming.id = nextTaskId(this.tasks);
        this.tasks.push(incoming);
        ctx.response.json(Json::serialize(incoming));
    }

    @PUT
    @Path("/tasks/:id")
    fn updateTask(ctx: HttpContext) -> Nothing
    {
        this.ensureInit();
        let id: Int64 = ctx.request.getParam("id").toInt();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if idx < 0
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return;
        }
        let updated: Task = Json::deserialize<Task>(ctx.request.body);
        updated.id = id;
        this.tasks[idx] = updated;
        ctx.response.json(Json::serialize(updated));
    }

    @PATCH
    @Path("/tasks/:id/done")
    fn toggleDone(ctx: HttpContext) -> Nothing
    {
        this.ensureInit();
        let id: Int64 = ctx.request.getParam("id").toInt();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if idx < 0
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return;
        }
        this.tasks[idx].done = !this.tasks[idx].done;
        ctx.response.json(Json::serialize(this.tasks[idx]));
    }

    @DELETE
    @Path("/tasks/:id")
    @StatusCode(204)
    fn deleteTask(ctx: HttpContext) -> Nothing
    {
        this.ensureInit();
        let id: Int64 = ctx.request.getParam("id").toInt();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if idx < 0
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return;
        }
        removeTaskAt(this.tasks, idx);
        ctx.response.text("");
    }
}
