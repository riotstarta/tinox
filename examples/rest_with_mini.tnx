import tinox.core.http_server;
import tinox.core.json;

@JsonSerializable
class User
{
    var id: Int64;
    var name: String;
}

class UserController
{
    @GET
    @Path("/users")
    @Produces("application/json")
    @StatusCode(200)
    fn listUsers(ctx: HttpContext) -> Nothing
    {
        let users: User[] = [User { id: 1, name: "Alice" }, User { id: 2, name: "Bob" }];
        ctx.response.body = Json::serialize(users);
    }

    @POST
    @Path("/users")
    @Consumes("application/json")
    @StatusCode(201)
    fn createUser(ctx: HttpContext) -> Nothing
    {
        let user: User = Json::deserialize<User>(ctx.request.body);
        ctx.response.body = Json::serialize(user);
    }
}
