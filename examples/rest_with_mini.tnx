import mini_http;

class UserController
{
    @GET
    @Path("/users")
    @Produces("application/json")
    @StatusCode(200)
    fnc listUsers(ctx: HttpContext) -> Unit
    {
        ctx.response.body = "[{\"id\":1}]";
    }

    @POST
    @Path("/users")
    @Consumes("application/json")
    @StatusCode(201)
    fnc createUser(ctx: HttpContext) -> Unit
    {
        ctx.response.body = "{\"id\":2}";
    }
}
