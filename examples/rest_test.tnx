import tinox.core.http_server;

class UserController
{
    @GET
    @Path("/users")
    @Produces("application/json")
    @StatusCode(200)
    fn listUsers(ctx: HttpContext) -> Nothing
    {
        ctx.response.body = "[{\"id\":1,\"name\":\"Alice\"}]";
    }

    @POST
    @Path("/users")
    @Consumes("application/json")
    @Produces("application/json")
    @StatusCode(201)
    fn createUser(ctx: HttpContext) -> Nothing
    {
        ctx.response.body = "{\"id\":2,\"name\":\"Bob\"}";
    }
}
