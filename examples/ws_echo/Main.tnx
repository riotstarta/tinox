// WebSocket-Echo-Server (tasklist.md Phase 4.3).
// Start:  tinox run examples/ws_echo.tnx
// Test:   Browser-Konsole:  s = new WebSocket("ws://localhost:8790");
//         s.onmessage = e => console.log(e.data); s.onopen = () => s.send("hallo");
// Bedient eine Verbindung nach der anderen (blocking, v1 — s. tasklist.md 4.2).

import tinox.core.websocket;

class Main
{
    fnc main() -> Int32 {
        let srv = WsServer::listen(8790);
        if srv < 0 {
            println("Port 8790 belegt");
            return 1;
        }
        println("ws://localhost:8790 bereit");
        while true {
            let conn = WsServer::accept(srv);
            if conn <= 0 {
                continue;
            }
            println("Client verbunden");
            while true {
                let f = Ws::readMessage(conn);
                if f.opcode == 1 {
                    let msg = Ws::text(f);
                    println("empfangen: " + msg);
                    Ws::sendText(conn, "echo: " + msg);
                    continue;
                }
                if f.opcode == 2 {
                    Ws::sendBinary(conn, f.payload);
                    continue;
                }
                // Close (8), EOF (-1) oder Protokollfehler (-2): Verbindung beenden
                break;
            }
            Ws::close(conn);
            println("Client getrennt");
        }
        return 0;
    }
}
