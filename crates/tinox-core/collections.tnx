/**
 * Tinox Standard Library - Collections Module
 * Generic data structure implementations: Stack<T>, Queue<T>, Pair<T, U>
 */
module tinox.core.collections;

namespace tinox.core.collections
{
    class Collections
    {
        fn newStack<T>() -> Stack<T>
        {
            return Stack<T>::new();
        }

        fn newQueue<T>() -> Queue<T>
        {
            return Queue<T>::new();
        }

        fn newPair<T, U>(first: T, second: U) -> Pair<T, U>
        {
            return Pair<T, U>::new(first, second);
        }
    }

    /**
     * A Last-In-First-Out (LIFO) stack of elements of type T.
     */
    class Stack<T>
    {
        var data: List<T>;

        fn new() -> Stack<T>
        {
            return Stack<T> { data: [] };
        }

        fn push(value: T) -> Nothing
        {
            this.data.push(value);
        }

        fn pop() -> T
        {
            let len: Int64 = this.data.len();
            if len == 0
            {
                throw "Stack is empty";
            }
            let value: T = this.data[len - 1];
            this.data.pop();
            return value;
        }

        fn peek() -> T
        {
            let len: Int64 = this.data.len();
            if len == 0
            {
                throw "Stack is empty";
            }
            return this.data[len - 1];
        }

        fn isEmpty() -> Bool
        {
            return this.data.len() == 0;
        }

        fn size() -> Int64
        {
            return this.data.len();
        }
    }

    /**
     * A First-In-First-Out (FIFO) queue of elements of type T.
     */
    class Queue<T>
    {
        var data: List<T>;

        fn new() -> Queue<T>
        {
            return Queue<T> { data: [] };
        }

        fn enqueue(value: T) -> Nothing
        {
            this.data.push(value);
        }

        fn dequeue() -> T
        {
            let len: Int64 = this.data.len();
            if len == 0
            {
                throw "Queue is empty";
            }
            let value: T = this.data[0];
            this.data.removeAt(0);
            return value;
        }

        fn peek() -> T
        {
            if this.data.len() == 0
            {
                throw "Queue is empty";
            }
            return this.data[0];
        }

        fn isEmpty() -> Bool
        {
            return this.data.len() == 0;
        }

        fn size() -> Int64
        {
            return this.data.len();
        }
    }

    /**
     * A pair of two values of potentially different types.
     */
    class Pair<T, U>
    {
        first: T;
        second: U;

        fn new(first: T, second: U) -> Pair<T, U>
        {
            return Pair<T, U> { first: first, second: second };
        }

        fn getFirst() -> T
        {
            return this.first;
        }

        fn getSecond() -> U
        {
            return this.second;
        }
    }
}
