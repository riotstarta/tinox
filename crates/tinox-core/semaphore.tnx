module tinox.core.semaphore;

namespace tinox.core.semaphore
{
    class Semaphore
    {
        var count: Int64;
        var waiting: List<Int64>;

        fn new(count: Int64) -> Semaphore
        {
            return Semaphore { count: count, waiting: [] };
        }

        fn acquire(sem: Semaphore) -> Nothing
        {
            if sem.count > 0
            {
                sem.count = sem.count - 1;
                return;
            }
            throw "Semaphore locked";
        }

        fn release(sem: Semaphore) -> Nothing
        {
            sem.count = sem.count + 1;
        }

        fn tryAcquire(sem: Semaphore) -> Bool
        {
            if sem.count > 0
            {
                sem.count = sem.count - 1;
                return true;
            }
            return false;
        }
    }

    class Mutex
    {
        var locked: Bool;
        var queue: List<Int64>;

        fn new() -> Mutex
        {
            return Mutex { locked: false, queue: [] };
        }

        fn lock(mutex: Mutex) -> Nothing
        {
            if mutex.locked == false
            {
                mutex.locked = true;
                return;
            }
            throw "Mutex already locked";
        }

        fn unlock(mutex: Mutex) -> Nothing
        {
            mutex.locked = false;
        }

        fn tryLock(mutex: Mutex) -> Bool
        {
            if mutex.locked == false
            {
                mutex.locked = true;
                return true;
            }
            return false;
        }
    }

    class RWLock
    {
        var readers: Int64;
        var writers: Int64;

        fn new() -> RWLock
        {
            return RWLock { readers: 0, writers: 0 };
        }

        fn readLock(lock: RWLock) -> Nothing
        {
            if lock.writers > 0
            {
                throw "Write lock held";
            }
            lock.readers = lock.readers + 1;
        }

        fn readUnlock(lock: RWLock) -> Nothing
        {
            lock.readers = lock.readers - 1;
        }

        fn writeLock(lock: RWLock) -> Nothing
        {
            lock.writers = lock.writers + 1;
        }

        fn writeUnlock(lock: RWLock) -> Nothing
        {
            lock.writers = lock.writers - 1;
        }
    }
}