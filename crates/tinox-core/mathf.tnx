module tinox.core.mathf;

namespace tinox.core.mathf
{
    class Mathf
    {
        fnc pi() -> Float64
        {
            return 3.14159265358979;
        }

        fnc e() -> Float64
        {
            return 2.71828182845904;
        }

        fnc sqrt(x: Float64) -> Float64
        {
            if x < 0.0
            {
                throw "Cannot compute square root of negative number";
            }
            var guess: Float64 = x / 2.0;
            var i: Int64 = 0;
            while i < 100
            {
                let nextGuess: Float64 = (guess + x / guess) / 2.0;
                if Mathf::abs(nextGuess - guess) < 0.0000001
                {
                    return nextGuess;
                }
                guess = nextGuess;
                i = i + 1;
            }
            return guess;
        }

        fnc pow(base: Float64, exp: Float64) -> Float64
        {
            var result: Float64 = 1.0;
            var i: Int64 = 0;
            while i < (Int64)exp
            {
                result = result * base;
                i = i + 1;
            }
            return result;
        }

        fnc abs(x: Float64) -> Float64
        {
            if x < 0.0
            {
                return -x;
            }
            return x;
        }

        fnc floor(x: Float64) -> Int64
        {
            return (Int64)x;
        }

        fnc ceil(x: Float64) -> Int64
        {
            if (Float64)(Int64)x == x
            {
                return (Int64)x;
            }
            if x > 0.0
            {
                return (Int64)x + 1;
            }
            return (Int64)x;
        }

        fnc round(x: Float64) -> Int64
        {
            let floorVal: Int64 = Mathf::floor(x);
            let frac: Float64 = x - (Float64)floorVal;
            if frac >= 0.5
            {
                return floorVal + 1;
            }
            return floorVal;
        }

        fnc min(a: Float64, b: Float64) -> Float64
        {
            if a < b
            {
                return a;
            }
            return b;
        }

        fnc max(a: Float64, b: Float64) -> Float64
        {
            if a > b
            {
                return a;
            }
            return b;
        }

        fnc clamp(value: Float64, min: Float64, max: Float64) -> Float64
        {
            if value < min
            {
                return min;
            }
            if value > max
            {
                return max;
            }
            return value;
        }

        fnc lerp(a: Float64, b: Float64, t: Float64) -> Float64
        {
            return a + (b - a) * t;
        }

        fnc sin(x: Float64) -> Float64
        {
            return sinf(x);
        }

        fnc cos(x: Float64) -> Float64
        {
            return cosf(x);
        }

        fnc tan(x: Float64) -> Float64
        {
            return tanf(x);
        }

        fnc log(x: Float64) -> Float64
        {
            return logf(x);
        }

        fnc log10(x: Float64) -> Float64
        {
            return log10f(x);
        }
    }
}