module tinox.core.pool;

namespace tinox.core.pool
{
    class Pool<T>
    {
        fn new(maxSize: Int64) -> Pool<T>
        {
            return Pool<T> { available: [], inUse: [], maxSize: maxSize };
        }

        fn acquire(pool: Pool<T>) -> T
        {
            if pool.available.len() > 0
            {
                return pool.available.pop();
            }
            if pool.inUse.len() < pool.maxSize
            {
                let obj: T = pool.factory();
                pool.inUse.push(obj);
                return obj;
            }
            throw "Pool exhausted";
        }

        fn release(pool: Pool<T>, obj: T) -> Nothing
        {
            var found: Bool = false;
            var i: Int64 = 0;
            while i < pool.inUse.len()
            {
                if pool.inUse[i] == obj
                {
                    found = true;
                    break;
                }
                i = i + 1;
            }
            if found
            {
                pool.inUse.removeAt(i);
                pool.available.push(obj);
            }
        }

        fn clear(pool: Pool<T>) -> Nothing
        {
            pool.available = [];
            pool.inUse = [];
        }
    }
}