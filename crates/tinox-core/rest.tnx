/**
 * Tinox Standard Library - REST Module
 * RESTful client implementation for building and executing
 * HTTP requests with JSON support, headers, and error handling
 */
module tinox.core.rest;

namespace tinox.core.rest
{
    /**
     * REST client for making HTTP requests to RESTful APIs
     *
     * Supports building requests with custom headers,
     * query parameters, and JSON request/response bodies.
     */
    class RestClient
    {
        /** The base URL for all requests */
        var baseUrl: String;

        /** Default headers applied to every request */
        var headers: List<String>;

        /** Request timeout in milliseconds */
        var timeout: Int64;

        /**
         * Creates a new RestClient with the given base URL
         *
         * @param baseUrl the base URL for all requests (e.g., "https://api.example.com")
         * @return a new RestClient instance
         */
        fnc new(baseUrl: String) -> RestClient
        {
            return RestClient { baseUrl: baseUrl, headers: [], timeout: 30000 };
        }

        /**
         * Creates a new RestClient with base URL and default headers
         *
         * @param baseUrl the base URL for all requests
         * @param defaultHeaders list of "Key: Value" header strings
         * @return a new RestClient instance
         */
        fnc newWithHeaders(baseUrl: String, defaultHeaders: List<String>) -> RestClient
        {
            return RestClient { baseUrl: baseUrl, headers: defaultHeaders, timeout: 30000 };
        }

        /**
         * Sets the request timeout
         *
         * @param timeoutMs timeout in milliseconds
         */
        fn setTimeout(timeoutMs: Int64) -> Unit
        {
            this.timeout = timeoutMs;
        }

        /**
         * Adds a default header to all requests
         *
         * @param name the header name
         * @param value the header value
         */
        fn addHeader(name: String, value: String) -> Unit
        {
            this.headers.push(name + ": " + value);
        }

        /**
         * Clears all default headers
         */
        fn clearHeaders() -> Unit
        {
            this.headers = [];
        }

        /**
         * Performs a GET request
         *
         * @param path the endpoint path (appended to baseUrl)
         * @return the server response
         */
        fn get(path: String) -> RestResponse
        {
            let url: String = Url::build(this.baseUrl, path);
            let i: Int64 = 0;
            while i < this.headers.len()
            {
                let header: String = this.headers[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
            let response: HttpResponse = Http::get(url);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Performs a GET request with query parameters
         *
         * @param path the endpoint path
         * @param params map of query parameter key-value pairs
         * @return the server response
         */
        fn getWithParams(path: String, params: Map<String, String>) -> RestResponse
        {
            let url: String = Url::buildWithParams(this.baseUrl, path, params);
            let i: Int64 = 0;
            while i < this.headers.len()
            {
                let header: String = this.headers[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
            let response: HttpResponse = Http::get(url);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Performs a POST request with a JSON body
         *
         * @param path the endpoint path
         * @param body the request body as a string
         * @return the server response
         */
        fn post(path: String, body: String) -> RestResponse
        {
            let url: String = Url::build(this.baseUrl, path);
            Http::setHeader("Content-Type", "application/json");
            let i: Int64 = 0;
            while i < this.headers.len()
            {
                let header: String = this.headers[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
            let response: HttpResponse = Http::post(url, body);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Performs a PUT request with a JSON body
         *
         * @param path the endpoint path
         * @param body the request body as a string
         * @return the server response
         */
        fn put(path: String, body: String) -> RestResponse
        {
            let url: String = Url::build(this.baseUrl, path);
            Http::setHeader("Content-Type", "application/json");
            let i: Int64 = 0;
            while i < this.headers.len()
            {
                let header: String = this.headers[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
            let response: HttpResponse = Http::put(url, body);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Performs a PATCH request with a JSON body
         *
         * @param path the endpoint path
         * @param body the request body as a string
         * @return the server response
         */
        fn patch(path: String, body: String) -> RestResponse
        {
            let url: String = Url::build(this.baseUrl, path);
            Http::setHeader("Content-Type", "application/json");
            let i: Int64 = 0;
            while i < this.headers.len()
            {
                let header: String = this.headers[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
            let response: HttpResponse = Http::patch(url, body);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Performs a DELETE request
         *
         * @param path the endpoint path
         * @return the server response
         */
        fn delete(path: String) -> RestResponse
        {
            let url: String = Url::build(this.baseUrl, path);
            let i: Int64 = 0;
            while i < this.headers.len()
            {
                let header: String = this.headers[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
            let response: HttpResponse = Http::delete(url);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Adds Bearer token authentication header
         *
         * @param token the bearer token
         */
        fn bearerAuth(token: String) -> Unit
        {
            this.addHeader("Authorization", "Bearer " + token);
        }

        /**
         * Adds Basic authentication header
         *
         * @param username the username
         * @param password the password
         */
        fn basicAuth(username: String, password: String) -> Unit
        {
            let credentials: String = Base64::encode(username + ":" + password);
            this.addHeader("Authorization", "Basic " + credentials);
        }
    }

    /**
     * REST response wrapper providing convenient access to
     * status codes, headers, and parsed JSON bodies
     */
    class RestResponse
    {
        /** The HTTP status code */
        var statusCode: Int64;

        /** The response body as a string */
        var body: String;

        /** Whether the request was successful (status 2xx) */
        var ok: Bool;

        /**
         * Creates a new RestResponse
         *
         * @param statusCode the HTTP status code
         * @param body the response body
         * @return a new RestResponse instance
         */
        fnc new(statusCode: Int64, body: String) -> RestResponse
        {
            let isOk: Bool = statusCode >= 200 && statusCode < 300;
            return RestResponse { statusCode: statusCode, body: body, ok: isOk };
        }

        /**
         * Creates a RestResponse from an HttpResponse
         *
         * @param response the raw HTTP response
         * @return a RestResponse instance
         */
        fnc fromHttp(response: HttpResponse) -> RestResponse
        {
            let code: Int64 = response.statusCode();
            let bodyText: String = response.body();
            let isOk: Bool = code >= 200 && code < 300;
            return RestResponse { statusCode: code, body: bodyText, ok: isOk };
        }

        /**
         * Returns the response body as a string
         *
         * @return the response body
         */
        fn text() -> String
        {
            return this.body;
        }

        /**
         * Parses the response body as JSON
         *
         * @return a JsonValue representing the parsed JSON
         */
        fn json() -> JsonValue
        {
            return Json::parse(this.body);
        }

        /**
         * Checks if the response status is a success (2xx)
         *
         * @return true if status code is between 200 and 299
         */
        fn isOk() -> Bool
        {
            return this.ok;
        }

        /**
         * Checks if the response status is a client error (4xx)
         *
         * @return true if status code is between 400 and 499
         */
        fn isClientError() -> Bool
        {
            return this.statusCode >= 400 && this.statusCode < 500;
        }

        /**
         * Checks if the response status is a server error (5xx)
         *
         * @return true if status code is between 500 and 599
         */
        fn isServerError() -> Bool
        {
            return this.statusCode >= 500;
        }

        /**
         * Returns the HTTP status code
         *
         * @return the status code (e.g., 200, 404, 500)
         */
        fn status() -> Int64
        {
            return this.statusCode;
        }

        /**
         * Throws an error if the response was not successful
         *
         * @return this response for chaining
         * @throws an error message with status code and body if not 2xx
         */
        fn ensureSuccess() -> RestResponse
        {
            if this.ok == false
            {
                let msg: String = "HTTP " + this.statusCode.toString() + ": " + this.body;
                throw msg;
            }
            return this;
        }
    }

    /**
     * URL builder utility for constructing URLs with
     * path segments, query parameters, and fragments
     */
    class Url
    {
        /**
         * Builds a full URL from a base URL and a path
         *
         * @param baseUrl the base URL (e.g., "https://api.example.com")
         * @param path the path to append (e.g., "/users")
         * @return the combined URL
         */
        fnc build(baseUrl: String, path: String) -> String
        {
            let base: String = baseUrl.trim();
            if base.endsWith("/") && path.startsWith("/")
            {
                return base.substring(0, base.len() - 1) + path;
            }
            if base.endsWith("/") || path.startsWith("/")
            {
                return base + path;
            }
            return base + "/" + path;
        }

        /**
         * Builds a URL with query parameters
         *
         * @param baseUrl the base URL
         * @param path the endpoint path
         * @param params map of query parameter key-value pairs
         * @return the full URL with encoded query string
         */
        fnc buildWithParams(baseUrl: String, path: String, params: Map<String, String>) -> String
        {
            let url: String = Url::build(baseUrl, path);
            if params.len() == 0
            {
                return url;
            }
            let result: String = url + "?";
            let first: Bool = true;
            let keys: List<String> = params.keys();
            let i: Int64 = 0;
            while i < keys.len()
            {
                if first == false
                {
                    result = result + "&";
                }
                result = result + Url::encode(keys[i]) + "=" + Url::encode(params.get(keys[i]));
                first = false;
                i = i + 1;
            }
            return result;
        }

        /**
         * Encodes a string for use in a URL (percent-encoding)
         *
         * Replaces reserved characters with their percent-encoded equivalents.
         * Characters A-Z, a-z, 0-9, -, _, ., ~ are left unencoded.
         *
         * @param s the string to encode
         * @return the percent-encoded string
         */
        fnc encode(s: String) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < s.len()
            {
                let ch: String = s.substring(i, i + 1);
                let code: Int64 = ch.charAt(0);
                if Url::isUnreserved(ch)
                {
                    result = result + ch;
                }
                else
                {
                    result = result + "%" + Url::toHex(code);
                }
                i = i + 1;
            }
            return result;
        }

        /**
         * Checks if a character is unreserved in URL encoding
         *
         * Unreserved characters are A-Z, a-z, 0-9, -, _, ., ~
         *
         * @param ch a single character string
         * @return true if the character is unreserved
         */
        fnc isUnreserved(ch: String) -> Bool
        {
            let code: Int64 = ch.charAt(0);
            if code >= 65 && code <= 90
            {
                return true;
            }
            if code >= 97 && code <= 122
            {
                return true;
            }
            if code >= 48 && code <= 57
            {
                return true;
            }
            if ch == "-" || ch == "_" || ch == "." || ch == "~"
            {
                return true;
            }
            return false;
        }

        /**
         * Converts an integer to a two-digit uppercase hex string
         *
         * @param n the value to convert (0-255)
         * @return the hex string (e.g., "0F" for 15)
         */
        fnc toHex(n: Int64) -> String
        {
            let hex: String = "0123456789ABCDEF";
            let high: Int64 = (n / 16) % 16;
            let low: Int64 = n % 16;
            return hex.substring(high, high + 1) + hex.substring(low, low + 1);
        }

        /**
         * Joins multiple path segments into a single path
         *
         * Removes duplicate slashes between segments
         *
         * @param segments list of path segments
         * @return a clean joined path
         */
        fnc joinPath(segments: List<String>) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < segments.len()
            {
                let seg: String = segments[i].trim();
                if seg.len() > 0
                {
                    if result.len() > 0 && result.endsWith("/") == false && seg.startsWith("/") == false
                    {
                        result = result + "/";
                    }
                    result = result + seg;
                }
                i = i + 1;
            }
            return result;
        }
    }

    /**
     * HTTP request builder for constructing requests
     * with a fluent API (method chaining pattern)
     *
     * Example usage:
     *   RequestBuilder::new("https://api.example.com")
     *       .header("Accept", "application/json")
     *       .get("/users")
     */
    class RequestBuilder
    {
        /** The base URL */
        var baseUrl: String;

        /** Custom headers for this request */
        var reqHeaders: List<String>;

        /** Query parameters for this request */
        var queryParams: List<String>;

        /** The request body */
        var reqBody: String;

        /**
         * Creates a new RequestBuilder
         *
         * @param baseUrl the base URL for requests
         * @return a new RequestBuilder instance
         */
        fnc new(baseUrl: String) -> RequestBuilder
        {
            return RequestBuilder { baseUrl: baseUrl, reqHeaders: [], queryParams: [], reqBody: "" };
        }

        /**
         * Adds a header to the request
         *
         * @param name the header name
         * @param value the header value
         * @return this builder for chaining
         */
        fn header(name: String, value: String) -> RequestBuilder
        {
            this.reqHeaders.push(name + ": " + value);
            return this;
        }

        /**
         * Adds a query parameter
         *
         * @param key the parameter key
         * @param value the parameter value
         * @return this builder for chaining
         */
        fn query(key: String, value: String) -> RequestBuilder
        {
            this.queryParams.push(Url::encode(key) + "=" + Url::encode(value));
            return this;
        }

        /**
         * Sets the request body
         *
         * @param body the request body string
         * @return this builder for chaining
         */
        fn body(body: String) -> RequestBuilder
        {
            this.reqBody = body;
            return this;
        }

        /**
         * Sets the request body as JSON with Content-Type header
         *
         * @param jsonBody the JSON string to send
         * @return this builder for chaining
         */
        fn jsonBody(jsonBody: String) -> RequestBuilder
        {
            this.reqHeaders.push("Content-Type: application/json");
            this.reqBody = jsonBody;
            return this;
        }

        /**
         * Adds Bearer authentication header
         *
         * @param token the bearer token
         * @return this builder for chaining
         */
        fn bearer(token: String) -> RequestBuilder
        {
            this.reqHeaders.push("Authorization: Bearer " + token);
            return this;
        }

        /**
         * Executes a GET request
         *
         * @param path the endpoint path
         * @return the REST response
         */
        fn get(path: String) -> RestResponse
        {
            let url: String = this.buildUrl(path);
            this.applyHeaders();
            let response: HttpResponse = Http::get(url);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Executes a POST request
         *
         * @param path the endpoint path
         * @return the REST response
         */
        fn post(path: String) -> RestResponse
        {
            let url: String = this.buildUrl(path);
            this.applyHeaders();
            let response: HttpResponse = Http::post(url, this.reqBody);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Executes a PUT request
         *
         * @param path the endpoint path
         * @return the REST response
         */
        fn put(path: String) -> RestResponse
        {
            let url: String = this.buildUrl(path);
            this.applyHeaders();
            let response: HttpResponse = Http::put(url, this.reqBody);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Executes a PATCH request
         *
         * @param path the endpoint path
         * @return the REST response
         */
        fn patch(path: String) -> RestResponse
        {
            let url: String = this.buildUrl(path);
            this.applyHeaders();
            let response: HttpResponse = Http::patch(url, this.reqBody);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Executes a DELETE request
         *
         * @param path the endpoint path
         * @return the REST response
         */
        fn delete(path: String) -> RestResponse
        {
            let url: String = this.buildUrl(path);
            this.applyHeaders();
            let response: HttpResponse = Http::delete(url);
            Http::clearHeaders();
            return RestResponse::fromHttp(response);
        }

        /**
         * Builds the full URL with query parameters
         *
         * @param path the endpoint path
         * @return the complete URL string
         */
        fn buildUrl(path: String) -> String
        {
            let url: String = Url::build(this.baseUrl, path);
            if this.queryParams.len() > 0
            {
                url = url + "?";
                var i: Int64 = 0;
                while i < this.queryParams.len()
                {
                    if i > 0
                    {
                        url = url + "&";
                    }
                    url = url + this.queryParams[i];
                    i = i + 1;
                }
            }
            return url;
        }

        /**
         * Applies all stored headers to the HTTP client
         */
        fn applyHeaders() -> Unit
        {
            var i: Int64 = 0;
            while i < this.reqHeaders.len()
            {
                let header: String = this.reqHeaders[i];
                let colonPos: Int64 = header.indexOf(":");
                let name: String = header.substring(0, colonPos).trim();
                let value: String = header.substring(colonPos + 1, header.len()).trim();
                Http::setHeader(name, value);
                i = i + 1;
            }
        }
    }

    /**
     * HTTP status code enum for readable status code comparisons
     *
     * Usage:
     *   if response.status() == HttpStatus::Ok
     *   match response.status() {
     *       HttpStatus::Ok => ...
     *       HttpStatus::NotFound => ...
     *   }
     */
    enum HttpStatus
    {
        Continue;           // 100
        SwitchingProtocols; // 101
        Ok;                 // 200
        Created;            // 201
        Accepted;           // 202
        NoContent;          // 204
        MovedPermanently;   // 301
        Found;              // 302
        NotModified;        // 304
        BadRequest;         // 400
        Unauthorized;       // 401
        Forbidden;          // 403
        NotFound;           // 404
        MethodNotAllowed;   // 405
        Conflict;           // 409
        UnprocessableEntity;// 422
        TooManyRequests;    // 429
        InternalServerError;// 500
        BadGateway;         // 502
        ServiceUnavailable; // 503
        GatewayTimeout;     // 504
    }

    /**
     * Helper to convert between HttpStatus enum and status code integers
     */
    class HttpStatusHelper
    {
        /**
         * Converts an HTTP status integer to a HttpStatus enum value
         *
         * @param code the numeric status code
         * @return the matching HttpStatus enum value, or NotFound as fallback
         */
        fnc fromCode(code: Int64) -> HttpStatus
        {
            match code
            {
                100 => return Continue;
                101 => return SwitchingProtocols;
                200 => return Ok;
                201 => return Created;
                202 => return Accepted;
                204 => return NoContent;
                301 => return MovedPermanently;
                302 => return Found;
                304 => return NotModified;
                400 => return BadRequest;
                401 => return Unauthorized;
                403 => return Forbidden;
                404 => return NotFound;
                405 => return MethodNotAllowed;
                409 => return Conflict;
                422 => return UnprocessableEntity;
                429 => return TooManyRequests;
                500 => return InternalServerError;
                502 => return BadGateway;
                503 => return ServiceUnavailable;
                504 => return GatewayTimeout;
            }
            return NotFound;
        }

        /**
         * Converts a HttpStatus enum value to its numeric status code
         *
         * @param status the HttpStatus enum value
         * @return the numeric HTTP status code
         */
        fnc toCode(status: HttpStatus) -> Int64
        {
            match status
            {
                Continue => return 100;
                SwitchingProtocols => return 101;
                Ok => return 200;
                Created => return 201;
                Accepted => return 202;
                NoContent => return 204;
                MovedPermanently => return 301;
                Found => return 302;
                NotModified => return 304;
                BadRequest => return 400;
                Unauthorized => return 401;
                Forbidden => return 403;
                NotFound => return 404;
                MethodNotAllowed => return 405;
                Conflict => return 409;
                UnprocessableEntity => return 422;
                TooManyRequests => return 429;
                InternalServerError => return 500;
                BadGateway => return 502;
                ServiceUnavailable => return 503;
                GatewayTimeout => return 504;
            }
        }

        /**
         * Checks if a status code represents a success (2xx)
         *
         * @param code the numeric status code
         * @return true if the code is in the 200-299 range
         */
        fnc isSuccess(code: Int64) -> Bool
        {
            return code >= 200 && code < 300;
        }

        /**
         * Checks if a status code represents a client error (4xx)
         *
         * @param code the numeric status code
         * @return true if the code is in the 400-499 range
         */
        fnc isClientError(code: Int64) -> Bool
        {
            return code >= 400 && code < 500;
        }

        /**
         * Checks if a status code represents a server error (5xx)
         *
         * @param code the numeric status code
         * @return true if the code is in the 500-599 range
         */
        fnc isServerError(code: Int64) -> Bool
        {
            return code >= 500 && code < 600;
        }
    }

    /**
     * Common MIME type enum for Content-Type headers
     *
     * Usage:
     *   RestClient::new("https://api.example.com")
     *       .header("Content-Type", MediaType::ApplicationJson)
     *       .post("/users")
     */
    enum MediaType
    {
        ApplicationJson;
        ApplicationXml;
        ApplicationFormUrlencoded;
        TextPlain;
        TextHtml;
        TextCsv;
        MultipartFormData;
    }

    /**
     * Helper to convert MediaType enum values to their string representations
     */
    class MediaTypeHelper
    {
        /**
         * Converts a MediaType enum value to its MIME type string
         *
         * @param mediaType the MediaType enum value
         * @return the MIME type string (e.g., "application/json")
         */
        fnc toString(mediaType: MediaType) -> String
        {
            match mediaType
            {
                ApplicationJson => return "application/json";
                ApplicationXml => return "application/xml";
                ApplicationFormUrlencoded => return "application/x-www-form-urlencoded";
                TextPlain => return "text/plain";
                TextHtml => return "text/html";
                TextCsv => return "text/csv";
                MultipartFormData => return "multipart/form-data";
            }
        }
    }
}