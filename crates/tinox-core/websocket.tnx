module tinox.core.websocket;

/*
 * WebSocket-Server (RFC 6455) über der Conn-Handle-Architektur des
 * HTTP-Servers. Aufbau siehe tasklist.md (Phasen 2-4).
 *
 * Bytes laufen als List<Int64> (ein Byte 0..255 pro Slot) über die
 * binärsicheren Primitiven httpConnReadN/httpConnWriteBytes — die
 * C-String-basierten Pfade (httpConnReadRequest/SendRaw) werden NUR für den
 * textuellen Handshake benutzt.
 *
 * Bewusste v1-Lücken (tasklist.md "Später"): keine Fragmentierung
 * (Continuation-Frames -> Close 1003), kein Client, kein permessage-deflate.
 *
 * Verwendung (Echo-Server):
 *   let srv = WsServer::listen(8080);
 *   let conn = WsServer::accept(srv);        // inkl. Handshake, -1 bei Fehler
 *   while true {
 *       let f = Ws::readMessage(conn);        // Ping/Pong+Close automatisch
 *       if f.opcode != 1 { break; }           // 1 = Text
 *       Ws::sendText(conn, Ws::text(f));
 *   }
 *   Ws::close(conn);
 */

namespace tinox.core.websocket
{
    /*
     * Ein gelesener Frame. opcode wie RFC 6455 (1 Text, 2 Binary, 8 Close,
     * 9 Ping, 10 Pong); zusätzlich als Lese-Ergebnis:
     *   -1 = Verbindung zu/EOF, -2 = Protokollfehler (Verbindung wurde
     *   von readMessage bereits mit Close beantwortet).
     */
    class WsFrame
    {
        var fin: Bool;
        var opcode: Int64;
        var payload: List<Int64>;
    }

    class Ws
    {
        /*
         * Handshake auf einer frisch akzeptierten Verbindung (RFC 6455 §4.2.2):
         * liest den HTTP-Request, prüft Upgrade+Key+Version 13 und antwortet
         * mit 101. Negativ-Pfade hart: 400 + false (Aufrufer schließt).
         */
        fn handshake(conn: Int64) -> Bool
        {
            let req = httpConnReadRequest(conn);
            if req.len() == 0 {
                return false;
            }
            var key: String = "";
            var version: String = "";
            var hasUpgrade: Bool = false;
            let lines = req.split("\r\n");
            for i in 0..lines.len() {
                let line = lines[i];
                let lower = line.toLowerCase();
                if lower.startsWith("sec-websocket-key:") {
                    key = line.substring(18, line.len()).trim();
                }
                if lower.startsWith("sec-websocket-version:") {
                    version = line.substring(22, line.len()).trim();
                }
                if lower.startsWith("upgrade:") {
                    if lower.contains("websocket") {
                        hasUpgrade = true;
                    }
                }
            }
            if !hasUpgrade || key.len() == 0 || version != "13" {
                httpConnSendRaw(conn, "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n");
                return false;
            }
            let accept = wsAcceptKey(key);
            httpConnSendRaw(conn, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n");
            return true;
        }

        /*
         * Liest genau EINEN Frame (blockierend). Client-Frames MÜSSEN
         * maskiert sein (RFC 6455 §5.1) — unmaskiert ist ein Protokollfehler.
         * EOF/kurzer Read -> opcode -1; Protokollfehler -> opcode -2
         * (Close sendet hier NICHT — das macht readMessage).
         */
        fn readFrame(conn: Int64) -> WsFrame
        {
            let bad = WsFrame { fin: true, opcode: -1, payload: [] };
            let hdr = httpConnReadN(conn, 2);
            if hdr.len() < 2 {
                return bad;
            }
            let b0 = hdr[0];
            let b1 = hdr[1];
            let fin = (b0 & 0x80) != 0;
            let rsv = b0 & 0x70;
            let opcode = b0 & 0x0F;
            let masked = (b1 & 0x80) != 0;
            var plen: Int64 = b1 & 0x7F;
            // RSV-Bits ohne Extension und unmaskierte Client-Frames: Protokollfehler
            if rsv != 0 || !masked {
                return WsFrame { fin: true, opcode: -2, payload: [] };
            }
            if plen == 126 {
                let ext = httpConnReadN(conn, 2);
                if ext.len() < 2 {
                    return bad;
                }
                plen = (ext[0] << 8) | ext[1];
            } else if plen == 127 {
                let ext = httpConnReadN(conn, 8);
                if ext.len() < 8 {
                    return bad;
                }
                // 64-bit big-endian; Werte über 2^53 sind praxisfern, wir
                // lehnen >16 MB ohnehin ab (Speicherschutz).
                plen = 0;
                for i in 0..8 {
                    plen = (plen << 8) | ext[i];
                }
            }
            if plen < 0 || plen > 16777216 {
                return WsFrame { fin: true, opcode: -2, payload: [] };
            }
            let mask = httpConnReadN(conn, 4);
            if mask.len() < 4 {
                return bad;
            }
            var payload: List<Int64> = [];
            if plen > 0 {
                let raw = httpConnReadN(conn, plen);
                if raw.len() < plen {
                    return bad;
                }
                for i in 0..plen {
                    payload.push(raw[i] ^ mask[i % 4]);
                }
            }
            return WsFrame { fin: fin, opcode: opcode, payload: payload };
        }

        /*
         * Schreibt einen Frame Server->Client (unmaskiert, FIN=1).
         */
        fn writeFrame(conn: Int64, opcode: Int64, payload: List<Int64>) -> Nothing
        {
            var out: List<Int64> = [];
            out.push(0x80 | (opcode & 0x0F));
            let n = payload.len();
            if n < 126 {
                out.push(n);
            } else if n < 65536 {
                out.push(126);
                out.push((n >> 8) & 0xFF);
                out.push(n & 0xFF);
            } else {
                out.push(127);
                var shift: Int64 = 56;
                while shift >= 0 {
                    out.push((n >> shift) & 0xFF);
                    shift = shift - 8;
                }
            }
            for i in 0..n {
                out.push(payload[i] & 0xFF);
            }
            httpConnWriteBytes(conn, out);
        }

        /*
         * Liest die nächste DATEN-Nachricht: beantwortet Ping automatisch mit
         * Pong (Payload gespiegelt), quittiert Close mit Close und liefert
         * den Close-Frame zurück (Aufrufer beendet die Schleife und schließt).
         * Continuation/fragmentierte Frames: bewusst nicht unterstützt ->
         * Close 1003 + opcode -2 (s. tasklist.md).
         */
        fn readMessage(conn: Int64) -> WsFrame
        {
            while true {
                let f = Ws::readFrame(conn);
                if f.opcode == 9 {
                    Ws::writeFrame(conn, 10, f.payload);
                    continue;
                }
                if f.opcode == 10 {
                    continue;
                }
                if f.opcode == 8 {
                    Ws::writeFrame(conn, 8, f.payload);
                    return f;
                }
                if f.opcode == 0 || !f.fin {
                    Ws::sendClose(conn, 1003);
                    return WsFrame { fin: true, opcode: -2, payload: [] };
                }
                if f.opcode == -2 {
                    Ws::sendClose(conn, 1002);
                    return f;
                }
                return f;
            }
            return WsFrame { fin: true, opcode: -1, payload: [] };
        }

        /*
         * Text-Payload eines Frames als String. Byte-für-Byte (fromCharCode) —
         * für ASCII korrekt; Multi-Byte-UTF-8 kommt als Einzelbytes an
         * (dokumentierte v1-Vereinfachung).
         */
        fn text(f: WsFrame) -> String
        {
            var s: String = "";
            for i in 0..f.payload.len() {
                s = s + fromCharCode(f.payload[i]);
            }
            return s;
        }

        fn textToBytes(s: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            for i in 0..s.len() {
                bytes.push(s.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        fn sendText(conn: Int64, s: String) -> Nothing
        {
            Ws::writeFrame(conn, 1, Ws::textToBytes(s));
        }

        fn sendBinary(conn: Int64, bytes: List<Int64>) -> Nothing
        {
            Ws::writeFrame(conn, 2, bytes);
        }

        fn sendPing(conn: Int64) -> Nothing
        {
            Ws::writeFrame(conn, 9, []);
        }

        fn sendClose(conn: Int64, code: Int64) -> Nothing
        {
            var payload: List<Int64> = [];
            payload.push((code >> 8) & 0xFF);
            payload.push(code & 0xFF);
            Ws::writeFrame(conn, 8, payload);
        }

        fn close(conn: Int64) -> Nothing
        {
            httpConnClose(conn);
        }
    }

    /*
     * Minimaler Server-Einstieg: listen + accept-mit-Handshake. Bewusst als
     * explizite Schleifen-API (kein Lambda-Handler in v1, s. tasklist.md 4.1).
     */
    class WsServer
    {
        fn listen(port: Int64) -> Int64
        {
            return httpServerCreate(port);
        }

        /*
         * Akzeptiert die nächste Verbindung und führt den Handshake durch.
         * Rückgabe: Conn-Handle (>0) oder -1 (Handshake fehlgeschlagen,
         * Verbindung ist dann bereits geschlossen).
         */
        fn accept(srv: Int64) -> Int64
        {
            let conn = httpServerAcceptConnHandle(srv);
            if conn <= 0 {
                return -1;
            }
            if !Ws::handshake(conn) {
                httpConnClose(conn);
                return -1;
            }
            return conn;
        }
    }
}
