module tinox.core.asm;

namespace tinox.core.asm
{
    class Assembler
    {
        fn new() -> Assembler
        {
            return Assembler { bytecode: [], labels: Map::new() };
        }

        fn emit(asm: Assembler, op: Int64) -> Nothing
        {
            asm.bytecode.push(op);
        }

        fn emitInt(asm: Assembler, value: Int64) -> Nothing
        {
            var i: Int64 = 0;
            while i < 8
            {
                asm.bytecode.push((value >> (i * 8)) & 255);
                i = i + 1;
            }
        }

        fn emitLabel(asm: Assembler, name: String) -> Nothing
        {
            asm.labels[name] = asm.bytecode.len();
        }

        fn resolveLabels(asm: Assembler) -> List<Int64>
        {
            return asm.bytecode;
        }

        fn toBytes(asm: Assembler) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < asm.bytecode.len()
            {
                result = result + fromCharCode(asm.bytecode[i]);
                i = i + 1;
            }
            return result;
        }
    }

    class Ops
    {
        fn Nop() -> Int64 { return 0; }
        fn Halt() -> Int64 { return 1; }
        fn Load() -> Int64 { return 2; }
        fn Store() -> Int64 { return 3; }
        fn Push() -> Int64 { return 4; }
        fn Pop() -> Int64 { return 5; }
        fn Add() -> Int64 { return 6; }
        fn Sub() -> Int64 { return 7; }
        fn Mul() -> Int64 { return 8; }
        fn Div() -> Int64 { return 9; }
        fn Jmp() -> Int64 { return 10; }
        fn Jz() -> Int64 { return 11; }
        fn Jnz() -> Int64 { return 12; }
        fn Cmp() -> Int64 { return 13; }
        fn Call() -> Int64 { return 14; }
        fn Ret() -> Int64 { return 15; }
    }
}