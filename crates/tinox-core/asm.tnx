module tinox.core.asm;

namespace tinox.core.asm
{
    class Assembler
    {
        fnc new() -> Assembler
        {
            return Assembler { bytecode: [], labels: Map::new() };
        }

        fnc emit(asm: Assembler, op: Int64) -> Unit
        {
            asm.bytecode.push(op);
        }

        fnc emitInt(asm: Assembler, value: Int64) -> Unit
        {
            var i: Int64 = 0;
            while i < 8
            {
                asm.bytecode.push((value >> (i * 8)) && 255);
                i = i + 1;
            }
        }

        fnc emitLabel(asm: Assembler, name: String) -> Unit
        {
            asm.labels[name] = asm.bytecode.len();
        }

        fnc resolveLabels(asm: Assembler) -> List<Int64>
        {
            return asm.bytecode;
        }

        fnc toBytes(asm: Assembler) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < asm.bytecode.len()
            {
                result = result + fromCharCode(asm.bytecode[i]);
                i = i + 1;
            }
            return result;
        }
    }

    class Ops
    {
        fnc Nop() -> Int64 { return 0; }
        fnc Halt() -> Int64 { return 1; }
        fnc Load() -> Int64 { return 2; }
        fnc Store() -> Int64 { return 3; }
        fnc Push() -> Int64 { return 4; }
        fnc Pop() -> Int64 { return 5; }
        fnc Add() -> Int64 { return 6; }
        fnc Sub() -> Int64 { return 7; }
        fnc Mul() -> Int64 { return 8; }
        fnc Div() -> Int64 { return 9; }
        fnc Jmp() -> Int64 { return 10; }
        fnc Jz() -> Int64 { return 11; }
        fnc Jnz() -> Int64 { return 12; }
        fnc Cmp() -> Int64 { return 13; }
        fnc Call() -> Int64 { return 14; }
        fnc Ret() -> Int64 { return 15; }
    }
}