module tinox.core.yaml;

namespace tinox.core.yaml
{
    class Yaml
    {
        fn parse(content: String) -> YamlValue
        {
            return YamlParser::parse(content);
        }

        fn stringify(value: YamlValue) -> String
        {
            return YamlRenderer::render(value, 0);
        }
    }

    class YamlValue
    {
        kind: String;
        stringValue: String;
        intValue: Int64;
        floatValue: Float64;
        boolValue: Bool;
        listValue: List<YamlValue>;
        mapValue: Map<String, YamlValue>;

        fn isString() -> Bool { return this.kind == "string"; }
        fn isInt() -> Bool { return this.kind == "int"; }
        fn isFloat() -> Bool { return this.kind == "float"; }
        fn isBool() -> Bool { return this.kind == "bool"; }
        fn isList() -> Bool { return this.kind == "list"; }
        fn isMap() -> Bool { return this.kind == "map"; }
    }

    class YamlParser
    {
        fn parse(content: String) -> YamlValue
        {
            return YamlValue { kind: "map", mapValue: Map::new() };
        }
    }

    class YamlRenderer
    {
        fn render(value: YamlValue, indent: Int64) -> String
        {
            if value.isMap()
            {
                var result: String = "";
                let keys: List<String> = value.mapValue.keys();
                var i: Int64 = 0;
                while i < keys.len()
                {
                    result = result + YamlRenderer::indent(indent) + keys[i] + ":\n";
                    result = result + YamlRenderer::render(value.mapValue[keys[i]], indent + 1);
                    i = i + 1;
                }
                return result;
            }
            if value.isList()
            {
                var result: String = "";
                var i: Int64 = 0;
                while i < value.listValue.len()
                {
                    result = result + YamlRenderer::indent(indent) + "-\n";
                    result = result + YamlRenderer::render(value.listValue[i], indent + 1);
                    i = i + 1;
                }
                return result;
            }
            if value.isString()
            {
                return YamlRenderer::indent(indent) + value.stringValue + "\n";
            }
            if value.isInt()
            {
                return YamlRenderer::indent(indent) + value.intValue.toString() + "\n";
            }
            return YamlRenderer::indent(indent) + "\n";
        }

        fn indent(level: Int64) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < level * 2
            {
                result = result + " ";
                i = i + 1;
            }
            return result;
        }
    }
}