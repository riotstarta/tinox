module tinox.core.http;

namespace tinox.core.http
{
    // Blockierender HTTP/1.1-Client (nur http://, kein TLS). Antworten sind
    // opake C-Structs (TinoxHttpResponse*), auf die HttpResponse durchgereicht
    // wird. Request-Header werden thread-lokal via httpSetHeader gesammelt.
    extern fn httpGet(url: String) -> HttpResponse;
    extern fn httpPost(url: String, body: String) -> HttpResponse;
    extern fn httpPut(url: String, body: String) -> HttpResponse;
    extern fn httpDelete(url: String) -> HttpResponse;
    extern fn httpPatch(url: String, body: String) -> HttpResponse;
    extern fn httpSetHeader(name: String, value: String) -> Nothing;
    extern fn httpClearHeaders() -> Nothing;
    extern fn httpStatusCode(resp: HttpResponse) -> Int64;
    extern fn httpBody(resp: HttpResponse) -> String;
    extern fn httpHeader(resp: HttpResponse, name: String) -> String;

    class Http
    {
        fn get(url: String) -> HttpResponse
        {
            return httpGet(url);
        }

        fn post(url: String, body: String) -> HttpResponse
        {
            return httpPost(url, body);
        }

        fn put(url: String, body: String) -> HttpResponse
        {
            return httpPut(url, body);
        }

        fn delete(url: String) -> HttpResponse
        {
            return httpDelete(url);
        }

        fn patch(url: String, body: String) -> HttpResponse
        {
            return httpPatch(url, body);
        }

        fn setHeader(name: String, value: String) -> Nothing
        {
            httpSetHeader(name, value);
        }

        fn clearHeaders() -> Nothing
        {
            httpClearHeaders();
        }
    }

    class HttpResponse
    {
        fn statusCode() -> Int64
        {
            return httpStatusCode(this);
        }

        fn body() -> String
        {
            return httpBody(this);
        }

        fn header(name: String) -> String
        {
            return httpHeader(this, name);
        }
    }
}
