module tinox.core.option;

namespace tinox.core.option
{
    class Option
    {
        fn none() -> Option
        {
            return Option { hasValue: false, value: 0 };
        }

        fn some(value: Int64) -> Option
        {
            return Option { hasValue: true, value: value };
        }

        fn isSome() -> Bool
        {
            return this.hasValue;
        }

        fn isNone() -> Bool
        {
            return this.hasValue == false;
        }

        fn unwrap() -> Int64
        {
            if this.hasValue == false
            {
                throw "Option is None";
            }
            return this.value;
        }

        fn unwrapOr(defaultValue: Int64) -> Int64
        {
            if this.hasValue == false
            {
                return defaultValue;
            }
            return this.value;
        }

        fn map(transform: fnc(Int64) -> Int64) -> Option
        {
            if this.hasValue == false
            {
                return Option::none();
            }
            return Option::some(transform(this.value));
        }
    }
}