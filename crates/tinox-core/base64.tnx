module tinox.core.base64;

namespace tinox.core.base64
{
    class Base64
    {
        fn encode(data: String) -> String
        {
            return base64Encode(data);
        }

        fn decode(encoded: String) -> String
        {
            return base64Decode(encoded);
        }

        fn encodeBytes(data: List<Int64>) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < data.len()
            {
                result = result + base64EncodeChar(data[i]);
                i = i + 1;
            }
            return result;
        }
    }
}