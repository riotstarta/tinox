module tinox.core.result;

namespace tinox.core.result
{
    class Result
    {
        fn ok(value: Int64) -> Result
        {
            return Result { isOk: true, value: value, error: "" };
        }

        fn err(error: String) -> Result
        {
            return Result { isOk: false, value: 0, error: error };
        }

        fn isOk() -> Bool
        {
            return this.isOk;
        }

        fn isErr() -> Bool
        {
            return this.isOk == false;
        }

        fn unwrap() -> Int64
        {
            if this.isOk == false
            {
                throw this.error;
            }
            return this.value;
        }

        fn unwrapOr(defaultValue: Int64) -> Int64
        {
            if this.isOk == false
            {
                return defaultValue;
            }
            return this.value;
        }

        fn map(transform: fnc(Int64) -> Int64) -> Result
        {
            if this.isOk == false
            {
                return Result::err(this.error);
            }
            return Result::ok(transform(this.value));
        }
    }
}