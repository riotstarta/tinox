module tinox.core.uri;

namespace tinox.core.uri
{
    class Uri
    {
        fnc encode(s: String) -> String
        {
            return uriEncode(s);
        }

        fnc decode(s: String) -> String
        {
            return uriDecode(s);
        }

        fnc encodeComponent(s: String) -> String
        {
            return uriEncodeComponent(s);
        }

        fnc decodeComponent(s: String) -> String
        {
            return uriDecodeComponent(s);
        }

        fnc parse(url: String) -> UriParts
        {
            let schemeEnd: Int64 = url.indexOf("://");
            if schemeEnd == -1
            {
                return UriParts { scheme: "", host: "", path: "", query: "", fragment: "" };
            }
            let scheme: String = url.substring(0, schemeEnd);
            var remaining: String = url.substring(schemeEnd + 3, url.len());
            let pathStart: Int64 = remaining.indexOf("/");
            let queryStart: Int64 = remaining.indexOf("?");
            let fragmentStart: Int64 = remaining.indexOf("#");
            var host: String = "";
            var path: String = "";
            var query: String = "";
            var fragment: String = "";
            if pathStart == -1 && queryStart == -1 && fragmentStart == -1
            {
                host = remaining;
            }
            else
            {
                if pathStart != -1 && (queryStart == -1 || pathStart < queryStart) && (fragmentStart == -1 || pathStart < fragmentStart)
                {
                    host = remaining.substring(0, pathStart);
                    let remainingPath: String = remaining.substring(pathStart, remaining.len());
                    if fragmentStart != -1 && queryStart != -1 && fragmentStart < queryStart
                    {
                        path = remainingPath.substring(0, fragmentStart - pathStart);
                        fragment = remainingPath.substring(fragmentStart - pathStart + 1, remainingPath.len());
                    }
                    else if queryStart != -1
                    {
                        path = remainingPath.substring(0, queryStart - pathStart);
                        query = remainingPath.substring(queryStart - pathStart + 1, remainingPath.len());
                    }
                    else
                    {
                        path = remainingPath;
                    }
                }
                else if queryStart != -1 && (fragmentStart == -1 || queryStart < fragmentStart)
                {
                    host = remaining.substring(0, queryStart);
                    query = remaining.substring(queryStart + 1, fragmentStart);
                    if fragmentStart != -1
                    {
                        fragment = remaining.substring(fragmentStart + 1, remaining.len());
                    }
                }
                else if fragmentStart != -1
                {
                    host = remaining.substring(0, fragmentStart);
                    fragment = remaining.substring(fragmentStart + 1, remaining.len());
                }
            }
            return UriParts { scheme: scheme, host: host, path: path, query: query, fragment: fragment };
        }
    }

    class UriParts
    {
        scheme: String;
        host: String;
        path: String;
        query: String;
        fragment: String;
    }
}