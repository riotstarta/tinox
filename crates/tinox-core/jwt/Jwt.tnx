module tinox.core.jwt;

import tinox.core.base64;
import tinox.core.crypto;
import tinox.core.json;
import tinox.core.time;

namespace tinox.core.jwt
{
    class Jwt
    {
        fn encode(payload: Map<String, JsonValue>, secret: String) -> String
        {
            let header: String = Base64::encode("{\"alg\":\"HS256\",\"typ\":\"JWT\"}");
            let payloadJson: String = Json::stringify(Json::fromMap(payload));
            let payloadB64: String = Base64::encode(payloadJson);
            let message: String = header + "." + payloadB64;
            let signature: String = Crypto::hmacSha256(message, secret);
            return message + "." + signature;
        }

        fn decode(token: String, secret: String) -> Map<String, JsonValue>
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                throw "Invalid JWT format";
            }
            let message: String = parts[0] + "." + parts[1];
            let expectedSig: String = Crypto::hmacSha256(message, secret);
            if expectedSig != parts[2]
            {
                throw "Invalid signature";
            }
            let payloadJson: String = Base64::decode(parts[1]);
            let payload: Map<String, JsonValue> = Json::parse(payloadJson).asTable();
            // Bug 105: a correctly-signed token was accepted regardless of
            // its exp/nbf claims -- isExpired() existed but neither verify()
            // nor decode() (the two actual authentication gates) called it.
            Jwt::checkTemporalClaims(payload);
            return payload;
        }

        fn verify(token: String, secret: String) -> Bool
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                return false;
            }
            let message: String = parts[0] + "." + parts[1];
            let expectedSig: String = Crypto::hmacSha256(message, secret);
            if expectedSig != parts[2]
            {
                return false;
            }
            let payloadJson: String = Base64::decode(parts[1]);
            let payload: Map<String, JsonValue> = Json::parse(payloadJson).asTable();
            let now: Int64 = Time::now() / 1000;
            if payload.contains("exp") && now > payload["exp"].asInt()
            {
                return false;
            }
            if payload.contains("nbf") && now < payload["nbf"].asInt()
            {
                return false;
            }
            return true;
        }

        /*
         * Bug 105: shared exp/nbf check for decode() (throws, since decode()
         * already throws on format/signature errors). verify() inlines the
         * same two checks since it returns Bool instead.
         */
        fn checkTemporalClaims(payload: Map<String, JsonValue>) -> Nothing
        {
            let now: Int64 = Time::now() / 1000;
            if payload.contains("exp") && now > payload["exp"].asInt()
            {
                throw "Token expired";
            }
            if payload.contains("nbf") && now < payload["nbf"].asInt()
            {
                throw "Token not yet valid (nbf)";
            }
        }

        fn extractPayload(token: String) -> Map<String, JsonValue>
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                throw "Invalid JWT format";
            }
            let payloadJson: String = Base64::decode(parts[1]);
            return Json::parse(payloadJson).asTable();
        }

        fn isExpired(token: String) -> Bool
        {
            let payload: Map<String, JsonValue> = Jwt::extractPayload(token);
            if payload.contains("exp")
            {
                let exp: Int64 = payload["exp"].asInt();
                let now: Int64 = Time::now() / 1000;
                return now > exp;
            }
            return false;
        }
    }
}