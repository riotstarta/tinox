module tinox.core.toml;

namespace tinox.core.toml
{
    class Toml
    {
        fnc parse(content: String) -> TomlValue
        {
            return TomlParser::parse(content);
        }

        fnc stringify(value: TomlValue) -> String
        {
            return TomlRenderer::render(value);
        }
    }

    class TomlValue
    {
        fnc isString() -> Bool { return this.kind == "string"; }
        fnc isInt() -> Bool { return this.kind == "int"; }
        fnc isFloat() -> Bool { return this.kind == "float"; }
        fnc isBool() -> Bool { return this.kind == "bool"; }
        fnc isTable() -> Bool { return this.kind == "table"; }
        fnc isArray() -> Bool { return this.kind == "array"; }

        fnc asString() -> String { return this.stringValue; }
        fnc asInt() -> Int64 { return this.intValue; }
        fnc asFloat() -> Float64 { return this.floatValue; }
        fnc asBool() -> Bool { return this.boolValue; }
        fnc asTable() -> Map<String, TomlValue> { return this.tableValue; }
        fnc asArray() -> List<TomlValue> { return this.arrayValue; }

        kind: String;
        stringValue: String;
        intValue: Int64;
        floatValue: Float64;
        boolValue: Bool;
        tableValue: Map<String, TomlValue>;
        arrayValue: List<TomlValue>;
    }

    class TomlParser
    {
        fnc parse(content: String) -> TomlValue
        {
            let root: Map<String, TomlValue> = Map::new();
            var currentSection: String = "";
            let lines: List<String> = content.split("\n");
            var i: Int64 = 0;
            while i < lines.len()
            {
                let line: String = Strings::trim(lines[i]);
                if line.len() == 0 || line.startsWith("#")
                {
                    i = i + 1;
                    continue;
                }
                if line.startsWith("[")
                {
                    let endSection: Int64 = line.indexOf("]");
                    if endSection != -1
                    {
                        currentSection = line.substring(1, endSection);
                        root[currentSection] = TomlValue { kind: "table", tableValue: Map::new() };
                    }
                }
                else
                {
                    let eqPos: Int64 = line.indexOf("=");
                    if eqPos != -1
                    {
                        let key: String = Strings::trim(line.substring(0, eqPos));
                        let value: String = Strings::trim(line.substring(eqPos + 1, line.len()));
                        let tomv: TomlValue = TomlParser::parseValue(value);
                        root[key] = tomv;
                    }
                }
                i = i + 1;
            }
            return TomlValue { kind: "table", tableValue: root };
        }

        fnc parseValue(value: String) -> TomlValue
        {
            if value.startsWith("\"")
            {
                return TomlValue { kind: "string", stringValue: value.replace("\"", "") };
            }
            if value == "true"
            {
                return TomlValue { kind: "bool", boolValue: true };
            }
            if value == "false"
            {
                return TomlValue { kind: "bool", boolValue: false };
            }
            if value.indexOf(".") != -1
            {
                return TomlValue { kind: "float", floatValue: (Float64)value };
            }
            return TomlValue { kind: "int", intValue: (Int64)value };
        }
    }

    class TomlRenderer
    {
        fnc render(value: TomlValue) -> String
        {
            return "";
        }
    }
}