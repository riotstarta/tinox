module tinox.core.websocket;

namespace tinox.core.websocket
{
    // permessage-deflate (RFC 7692, issue #122) native helpers.
    // wsSetCompressed/wsIsCompressed store the per-connection negotiation
    // result directly on the runtime's conn handle (no side-table, no fd-
    // reuse hazard — see runtime.c's TinoxConn.wsCompressed comment).
    // tinoxDeflateRaw/tinoxInflateRaw are deliberately stateless per call:
    // this module always negotiates client_no_context_takeover +
    // server_no_context_takeover (see handshake() below), so every
    // message gets a fresh DEFLATE context — there is no persistent
    // z_stream to leak or wire into the connection lifecycle. This is a
    // deliberate scope reduction from full permessage-deflate (which
    // defaults to context takeover, requiring genuinely persistent
    // per-connection compression state — see issue #122's investigation
    // history for why that shape was ruled out for v1) rather than an
    // oversight: RFC 7692 §7.1.1 explicitly allows a server to include
    // both no-context-takeover parameters in its handshake response
    // regardless of what the client's offer contained, so this is a
    // fully spec-compliant, interoperable-with-real-browsers negotiation
    // outcome, just one with a slightly lower compression ratio for a
    // stream of many small messages than context takeover would give.
    extern fn wsSetCompressed(conn: Int64, enabled: Bool) -> Nothing;
    extern fn wsIsCompressed(conn: Int64) -> Bool;
    extern fn tinoxDeflateRaw(bytes: List<Int64>) -> List<Int64>;
    extern fn tinoxInflateRaw(bytes: List<Int64>) -> List<Int64>;
    extern fn wsLastInflateOk() -> Bool;

    class Ws
    {
        /*
         * Handshake auf einer frisch akzeptierten Verbindung (RFC 6455 §4.2.2):
         * liest den HTTP-Request, prüft Upgrade+Key+Version 13 und antwortet
         * mit 101. Negativ-Pfade hart: 400 + false (Aufrufer schließt).
         *
         * permessage-deflate (issue #122): wenn der Request
         * `Sec-WebSocket-Extensions: permessage-deflate` anbietet, wird das
         * IMMER mit `client_no_context_takeover; server_no_context_takeover`
         * angenommen (RFC 7692 §7.1.1 erlaubt dem Server, diese Parameter
         * unilateral in seine Response zu setzen, unabhängig davon, ob der
         * Client sie im Offer hatte) — s. Modul-Kommentar oben für die
         * Begründung dieser bewussten v1-Vereinfachung.
         */
        fn handshake(conn: Int64) -> Bool
        {
            let req = httpConnReadRequest(conn);
            if req.len() == 0 {
                return false;
            }
            var key: String = "";
            var version: String = "";
            var hasUpgrade: Bool = false;
            var offeredDeflate: Bool = false;
            let lines = req.split("\r\n");
            for i in 0..lines.len() {
                let line = lines[i];
                let lower = line.toLowerCase();
                if lower.startsWith("sec-websocket-key:") {
                    key = line.substring(18, line.len()).trim();
                }
                if lower.startsWith("sec-websocket-version:") {
                    version = line.substring(22, line.len()).trim();
                }
                if lower.startsWith("upgrade:") {
                    if lower.contains("websocket") {
                        hasUpgrade = true;
                    }
                }
                if lower.startsWith("sec-websocket-extensions:") {
                    if lower.contains("permessage-deflate") {
                        offeredDeflate = true;
                    }
                }
            }
            if !hasUpgrade || key.len() == 0 || version != "13" {
                httpConnSendRaw(conn, "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n");
                return false;
            }
            let accept = wsAcceptKey(key);
            var response = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n";
            if offeredDeflate {
                wsSetCompressed(conn, true);
                response = response + "Sec-WebSocket-Extensions: permessage-deflate; client_no_context_takeover; server_no_context_takeover\r\n";
            }
            response = response + "\r\n";
            httpConnSendRaw(conn, response);
            return true;
        }

        /*
         * Liest genau EINEN Frame (blockierend). requireMasked steuert die
         * Rollen-Erwartung (RFC 6455 §5.1: Client->Server MUSS maskiert
         * sein, Server->Client MUSS unmaskiert sein) — readFrame() (Server-
         * Rolle, unverändert) ruft dies mit true, WsClient mit false.
         * EOF/kurzer Read -> opcode -1; Protokollfehler (falsche
         * Maskierungsrichtung, RSV-Bits, fragmentiertes/übergroßes Control-
         * Frame) -> opcode -2 (Close sendet hier NICHT — das macht der
         * jeweilige readMessage-Aufrufer).
         *
         * RSV1 (issue #122): nur erlaubt auf einem Nicht-Control-Frame,
         * wenn diese Verbindung permessage-deflate ausgehandelt hat
         * (wsIsCompressed) — sonst Protokollfehler wie jedes andere
         * unerwartete RSV-Bit. Das eigentliche De-/Komprimieren passiert
         * NICHT hier (ein Frame trägt bei fragmentierten Nachrichten nur
         * einen Teil des komprimierten Bytestreams), sondern erst in
         * readMessageGeneric nach vollständiger Reassemblierung — dieses
         * Frame liefert das RSV1-Bit nur über WsFrame.rsv1 weiter.
         */
        fn readFrameGeneric(conn: Int64, requireMasked: Bool) -> WsFrame
        {
            let bad = WsFrame { fin: true, opcode: -1, payload: [], rsv1: false };
            let hdr = httpConnReadN(conn, 2);
            if hdr.len() < 2 {
                return bad;
            }
            let b0 = hdr[0];
            let b1 = hdr[1];
            let fin = (b0 & 0x80) != 0;
            let rsv1 = (b0 & 0x40) != 0;
            let rsvOther = (b0 & 0x30) != 0;
            let opcode = b0 & 0x0F;
            let masked = (b1 & 0x80) != 0;
            var plen: Int64 = b1 & 0x7F;
            // Bug 92 (RFC 6455 §5.5): control frames (8=Close, 9=Ping,
            // 10=Pong) MUST have FIN set and payload length <= 125 — they
            // can never use the 126/127 extended-length encoding and must
            // never be fragmented. Computed before the RSV check below
            // since RSV1 must never appear on a control frame either way.
            let isControlFrame = opcode >= 8 && opcode <= 10;
            // RSV2/RSV3 (no extension ever uses them here), RSV1 without
            // negotiated compression or on a control frame, and
            // Maskierung in der falschen Richtung für diese Rolle:
            // Protokollfehler.
            if rsvOther || (rsv1 && (isControlFrame || !wsIsCompressed(conn))) || masked != requireMasked {
                return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
            }
            if isControlFrame && (!fin || plen > 125) {
                return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
            }
            if plen == 126 {
                let ext = httpConnReadN(conn, 2);
                if ext.len() < 2 {
                    return bad;
                }
                plen = (ext[0] << 8) | ext[1];
            } else if plen == 127 {
                let ext = httpConnReadN(conn, 8);
                if ext.len() < 8 {
                    return bad;
                }
                // 64-bit big-endian; Werte über 2^53 sind praxisfern, wir
                // lehnen >16 MB ohnehin ab (Speicherschutz).
                plen = 0;
                for i in 0..8 {
                    plen = (plen << 8) | ext[i];
                }
            }
            if plen < 0 || plen > 16777216 {
                return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
            }
            // Das Mask-Feld existiert auf der Leitung nur, wenn das
            // Mask-Bit gesetzt ist (masked == requireMasked, s.o.) — bei
            // unmaskierten Frames (Server->Client) direkt den Payload lesen.
            var mask: List<Int64> = [0, 0, 0, 0];
            if masked {
                let readMask = httpConnReadN(conn, 4);
                if readMask.len() < 4 {
                    return bad;
                }
                mask = readMask;
            }
            var payload: List<Int64> = [];
            if plen > 0 {
                let raw = httpConnReadN(conn, plen);
                if raw.len() < plen {
                    return bad;
                }
                if masked {
                    for i in 0..plen {
                        payload.push(raw[i] ^ mask[i % 4]);
                    }
                } else {
                    payload = raw;
                }
            }
            return WsFrame { fin: fin, opcode: opcode, payload: payload, rsv1: rsv1 };
        }

        /*
         * Liest genau EINEN Frame als Server (Client-Frames MÜSSEN maskiert
         * sein, RFC 6455 §5.1) — unverändertes Verhalten/Signatur ggü. vor
         * WsClient (issue #121), s. readFrameGeneric.
         */
        fn readFrame(conn: Int64) -> WsFrame
        {
            return Ws::readFrameGeneric(conn, true);
        }

        /*
         * Schreibt einen Frame (FIN=1). masked steuert die Rollen-Erwartung
         * (RFC 6455 §5.1: Client->Server MUSS maskiert sein mit einer
         * zufälligen 32-Bit-Maske, Server->Client MUSS unmaskiert sein) —
         * writeFrame() (Server-Rolle, unverändert) ruft dies mit false,
         * WsClient mit true.
         *
         * permessage-deflate (issue #122): Text/Binary-Payloads werden
         * komprimiert und RSV1 gesetzt, wenn diese Verbindung die Extension
         * ausgehandelt hat (wsIsCompressed) — Control-Frames (Ping/Pong/
         * Close, Opcode 8-10) werden laut RFC 7692 NIE komprimiert. v1
         * fragmentiert ausgehende Nachrichten nie (unverändert), daher
         * trägt bei einer komprimierten Nachricht immer genau dieser eine
         * Frame den kompletten komprimierten Bytestream.
         */
        fn writeFrameGeneric(conn: Int64, opcode: Int64, payload: List<Int64>, masked: Bool) -> Nothing
        {
            var actualPayload: List<Int64> = payload;
            var rsv1Bit: Int64 = 0;
            let isDataFrame = opcode == 1 || opcode == 2;
            if isDataFrame && wsIsCompressed(conn) {
                actualPayload = tinoxDeflateRaw(payload);
                rsv1Bit = 0x40;
            }
            var out: List<Int64> = [];
            out.push(0x80 | rsv1Bit | (opcode & 0x0F));
            let n = actualPayload.len();
            let maskBit: Int64 = masked ? 0x80 : 0;
            if n < 126 {
                out.push(maskBit | n);
            } else if n < 65536 {
                out.push(maskBit | 126);
                out.push((n >> 8) & 0xFF);
                out.push(n & 0xFF);
            } else {
                out.push(maskBit | 127);
                var shift: Int64 = 56;
                while shift >= 0 {
                    out.push((n >> shift) & 0xFF);
                    shift = shift - 8;
                }
            }
            if masked {
                var maskBytes: List<Int64> = [];
                for i in 0..4 {
                    maskBytes.push(randomInt(0, 256));
                }
                for i in 0..4 {
                    out.push(maskBytes[i]);
                }
                for i in 0..n {
                    out.push((actualPayload[i] & 0xFF) ^ maskBytes[i % 4]);
                }
            } else {
                for i in 0..n {
                    out.push(actualPayload[i] & 0xFF);
                }
            }
            httpConnWriteBytes(conn, out);
        }

        /*
         * Schreibt einen Frame Server->Client (unmaskiert, FIN=1). Unverändertes
         * Verhalten/Signatur ggü. vor WsClient (issue #121), s. writeFrameGeneric.
         */
        fn writeFrame(conn: Int64, opcode: Int64, payload: List<Int64>) -> Nothing
        {
            Ws::writeFrameGeneric(conn, opcode, payload, false);
        }

        /*
         * Liest die nächste DATEN-Nachricht: beantwortet Ping automatisch mit
         * Pong (Payload gespiegelt), quittiert Close mit Close und liefert
         * den Close-Frame zurück (Aufrufer beendet die Schleife und schließt).
         *
         * Fragmentierte Nachrichten (RFC 6455 §5.4): ein Start-Frame
         * (Text/Binary, FIN=0) gefolgt von null oder mehr Continuation-Frames
         * (Opcode 0), das letzte davon mit FIN=1, werden hier zu EINER
         * WsFrame mit dem Opcode des Start-Frames und den aneinandergehängten
         * Payloads zusammengesetzt — für Aufrufer nicht von einer
         * unfragmentierten Nachricht zu unterscheiden. Control-Frames
         * (Ping/Pong/Close) dürfen zwischen den Fragmenten auftauchen (§5.5,
         * bereits in readFrameGeneric erzwungen: FIN=1, payload<=125) und
         * werden hier wie gewohnt sofort behandelt, ohne die laufende
         * Assemblierung zu stören. Protokollfehler (Continuation ohne
         * Start-Frame, neues Text/Binary-Frame mitten in einer laufenden
         * Fragmentierung, zusammengesetzte Nachricht über dem Speicher-Cap)
         * -> Close + opcode -2, wie bei den bestehenden Protokollfehlern.
         *
         * requireMasked/maskOutgoing steuern die Rollen-Erwartung wie bei
         * readFrameGeneric/writeFrameGeneric — readMessage() (Server-Rolle,
         * unverändert) ruft dies mit (true, false), WsClient mit
         * (false, true).
         *
         * permessage-deflate (issue #122): RSV1 wird nur auf dem ERSTEN
         * Frame einer Nachricht gesetzt (nie auf Continuation-Frames) und
         * gilt für den GESAMTEN komprimierten Bytestream über alle
         * Fragmente hinweg — deshalb wird hier erst NACH vollständiger
         * Reassemblierung dekomprimiert, nicht pro Frame in
         * readFrameGeneric. Ein Dekompressions-Fehler (kaputter/zu großer
         * Bytestream, wsLastInflateOk()==false) wird wie jeder andere
         * Protokollfehler behandelt: Close 1002 + opcode -2.
         */
        fn readMessageGeneric(conn: Int64, requireMasked: Bool, maskOutgoing: Bool) -> WsFrame
        {
            var assembling: Bool = false;
            var msgOpcode: Int64 = -1;
            var msgCompressed: Bool = false;
            var payload: List<Int64> = [];
            while true {
                let f = Ws::readFrameGeneric(conn, requireMasked);
                if f.opcode == 9 {
                    Ws::writeFrameGeneric(conn, 10, f.payload, maskOutgoing);
                    continue;
                }
                if f.opcode == 10 {
                    continue;
                }
                if f.opcode == 8 {
                    Ws::writeFrameGeneric(conn, 8, f.payload, maskOutgoing);
                    return f;
                }
                if f.opcode == -1 {
                    return f;
                }
                if f.opcode == -2 {
                    Ws::sendCloseGeneric(conn, 1002, maskOutgoing);
                    return f;
                }
                if !assembling {
                    if f.opcode == 0 {
                        // Continuation-Frame ohne vorausgehendes Start-Frame
                        Ws::sendCloseGeneric(conn, 1002, maskOutgoing);
                        return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
                    }
                    if f.fin {
                        return Ws::finishMessage(conn, maskOutgoing, f.opcode, f.payload, f.rsv1);
                    }
                    assembling = true;
                    msgOpcode = f.opcode;
                    msgCompressed = f.rsv1;
                    payload = f.payload;
                } else {
                    if f.opcode != 0 {
                        // Neues Text/Binary-Frame mitten in laufender Fragmentierung
                        Ws::sendCloseGeneric(conn, 1002, maskOutgoing);
                        return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
                    }
                    for i in 0..f.payload.len() {
                        payload.push(f.payload[i]);
                    }
                    if f.fin {
                        return Ws::finishMessage(conn, maskOutgoing, msgOpcode, payload, msgCompressed);
                    }
                }
                // Speicher-Cap für die zusammengesetzte Nachricht — dieselbe
                // 16-MB-Grenze wie für einen einzelnen Frame in readFrameGeneric.
                if payload.len() > 16777216 {
                    Ws::sendCloseGeneric(conn, 1009, maskOutgoing);
                    return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
                }
            }
            return WsFrame { fin: true, opcode: -1, payload: [], rsv1: false };
        }

        /*
         * Letzter Schritt von readMessageGeneric: dekomprimiert die
         * vollständig zusammengesetzte Nachricht, wenn compressed=true
         * (RSV1 auf dem ersten Frame gesetzt) — sonst reine Passthrough.
         * Ein Dekompressions-Fehler wird wie jeder andere Protokollfehler
         * behandelt (Close 1002 + opcode -2), s. readMessageGeneric.
         */
        fn finishMessage(conn: Int64, maskOutgoing: Bool, opcode: Int64, payload: List<Int64>, compressed: Bool) -> WsFrame
        {
            if !compressed {
                return WsFrame { fin: true, opcode: opcode, payload: payload, rsv1: false };
            }
            let decompressed = tinoxInflateRaw(payload);
            if !wsLastInflateOk() {
                Ws::sendCloseGeneric(conn, 1002, maskOutgoing);
                return WsFrame { fin: true, opcode: -2, payload: [], rsv1: false };
            }
            return WsFrame { fin: true, opcode: opcode, payload: decompressed, rsv1: false };
        }

        /*
         * Liest die nächste DATEN-Nachricht als Server: beantwortet Ping
         * automatisch mit Pong (Payload gespiegelt), quittiert Close mit
         * Close und liefert den Close-Frame zurück (Aufrufer beendet die
         * Schleife und schließt). Unverändertes Verhalten/Signatur ggü. vor
         * WsClient (issue #121), s. readMessageGeneric für Details zur
         * Fragment-Zusammensetzung (§5.4) und Protokollfehlern.
         */
        fn readMessage(conn: Int64) -> WsFrame
        {
            return Ws::readMessageGeneric(conn, true, false);
        }

        /*
         * Text-Payload eines Frames als String. Byte-für-Byte (fromCharCode) —
         * für ASCII korrekt; Multi-Byte-UTF-8 kommt als Einzelbytes an
         * (dokumentierte v1-Vereinfachung).
         */
        fn text(f: WsFrame) -> String
        {
            var s: String = "";
            for i in 0..f.payload.len() {
                s = s + fromCharCode(f.payload[i]);
            }
            return s;
        }

        fn textToBytes(s: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            for i in 0..s.len() {
                bytes.push(s.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        fn sendText(conn: Int64, s: String) -> Nothing
        {
            Ws::writeFrame(conn, 1, Ws::textToBytes(s));
        }

        fn sendBinary(conn: Int64, bytes: List<Int64>) -> Nothing
        {
            Ws::writeFrame(conn, 2, bytes);
        }

        fn sendPing(conn: Int64) -> Nothing
        {
            Ws::writeFrame(conn, 9, []);
        }

        fn sendCloseGeneric(conn: Int64, code: Int64, masked: Bool) -> Nothing
        {
            var payload: List<Int64> = [];
            payload.push((code >> 8) & 0xFF);
            payload.push(code & 0xFF);
            Ws::writeFrameGeneric(conn, 8, payload, masked);
        }

        fn sendClose(conn: Int64, code: Int64) -> Nothing
        {
            Ws::sendCloseGeneric(conn, code, false);
        }

        fn close(conn: Int64) -> Nothing
        {
            httpConnClose(conn);
        }
    }
}
