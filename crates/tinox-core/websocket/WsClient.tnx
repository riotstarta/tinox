module tinox.core.websocket;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.websocket
{
    /*
     * WebSocket-CLIENT-Einstieg (issue #121): verbindet nach außen zu einem
     * WS-Server, statt (wie WsServer) eingehende Verbindungen anzunehmen.
     *
     * Rollenumkehr ggü. Ws/WsServer (die den Server-Fall abdecken, RFC 6455
     * §5.1): ausgehende Frames MÜSSEN maskiert sein, eingehende Frames vom
     * Server MÜSSEN unmaskiert sein — beides über Ws::readFrameGeneric/
     * writeFrameGeneric/readMessageGeneric/sendCloseGeneric mit vertauschten
     * Rollen-Flags, keine Kopie der Frame-Codec-Logik. Ws::text/textToBytes
     * (rollen-unabhängig) werden unverändert wiederverwendet.
     *
     * Verwendung (Echo-Client):
     *   let conn = WsClient::connect("example.org", 8080, "/chat");
     *   if conn < 0 { ... Verbindung/Handshake fehlgeschlagen ... }
     *   WsClient::sendText(conn, "hello");
     *   let f = WsClient::readMessage(conn);
     *   println(WsClient::text(f));
     *   WsClient::close(conn);
     */
    class WsClient
    {
        /*
         * Öffnet eine TCP-Verbindung zu host:port und führt den Client-
         * seitigen Handshake durch (RFC 6455 §4.1): sendet den Upgrade-
         * Request für path mit einem frisch erzeugten Sec-WebSocket-Key und
         * prüft die 101-Antwort samt Sec-WebSocket-Accept gegen den selbst
         * berechneten Erwartungswert (wsAcceptKey — dieselbe Runtime-
         * Funktion, die der Server zum Erzeugen von Accept aus Key nutzt).
         * Rückgabe: Conn-Handle (>0) oder -1 (Verbindungsaufbau/Handshake
         * fehlgeschlagen — Verbindung ist dann bereits geschlossen).
         */
        fn connect(host: String, port: Int64, path: String) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                return -1;
            }
            let conn = httpConnFromFd(fd);

            var keyBytes: List<Int64> = [];
            for i in 0..16 {
                keyBytes.push(randomInt(0, 256));
            }
            let key = Base64::encodeBytes(keyBytes);
            let expectedAccept = wsAcceptKey(key);

            httpConnSendRaw(conn, "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n\r\n");

            let resp = httpConnReadRequest(conn);
            if resp.len() == 0 || !resp.contains("101") {
                httpConnClose(conn);
                return -1;
            }
            var actualAccept: String = "";
            let lines = resp.split("\r\n");
            for i in 0..lines.len() {
                let line = lines[i];
                if line.toLowerCase().startsWith("sec-websocket-accept:") {
                    actualAccept = line.substring(21, line.len()).trim();
                }
            }
            if actualAccept != expectedAccept {
                httpConnClose(conn);
                return -1;
            }
            return conn;
        }

        /*
         * Liest die nächste DATEN-Nachricht vom Server (inkl. automatischem
         * Ping->Pong, Close-Quittierung und Fragment-Zusammensetzung) — wie
         * Ws::readMessage, nur mit vertauschter Maskierungsrichtung
         * (eingehend unmaskiert erwartet, ausgehende Control-Antworten
         * maskiert). Siehe Ws::readMessageGeneric für das volle Verhalten.
         */
        fn readMessage(conn: Int64) -> WsFrame
        {
            return Ws::readMessageGeneric(conn, false, true);
        }

        /*
         * Liest genau EINEN rohen Frame vom Server (kein automatisches
         * Ping/Pong/Close-Handling — dafür readMessage) — wie Ws::readFrame,
         * nur mit vertauschter Maskierungsrichtung (Server->Client MUSS
         * unmaskiert sein).
         */
        fn readFrame(conn: Int64) -> WsFrame
        {
            return Ws::readFrameGeneric(conn, false);
        }

        fn text(f: WsFrame) -> String
        {
            return Ws::text(f);
        }

        fn sendText(conn: Int64, s: String) -> Nothing
        {
            Ws::writeFrameGeneric(conn, 1, Ws::textToBytes(s), true);
        }

        fn sendBinary(conn: Int64, bytes: List<Int64>) -> Nothing
        {
            Ws::writeFrameGeneric(conn, 2, bytes, true);
        }

        fn sendPing(conn: Int64) -> Nothing
        {
            Ws::writeFrameGeneric(conn, 9, [], true);
        }

        fn sendClose(conn: Int64, code: Int64) -> Nothing
        {
            Ws::sendCloseGeneric(conn, code, true);
        }

        fn close(conn: Int64) -> Nothing
        {
            httpConnClose(conn);
        }
    }
}
