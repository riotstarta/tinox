module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * Gegenstück zu AmqpWriter091: liest big-endian aus `bytes` ab einer
     * internen Cursor-Position `pos`. Kein Bounds-Check auf Array-Ebene
     * (Aufrufer MUSS die Frame-Größe vorher kennen, s. AmqpFrame091.payload
     * — die Länge kommt immer aus dem äußeren Frame-Header).
     */
    class AmqpReader091
    {
        var bytes: List<Int64>;
        var pos: Int64;

        fn new(bytes: List<Int64>) -> AmqpReader091
        {
            return AmqpReader091 { bytes: bytes, pos: 0 };
        }

        fn remaining() -> Int64
        {
            return this.bytes.len() - this.pos;
        }

        fn octet() -> Int64
        {
            let v = this.bytes[this.pos];
            this.pos = this.pos + 1;
            return v;
        }

        fn short() -> Int64
        {
            let hi = this.octet();
            let lo = this.octet();
            return (hi << 8) | lo;
        }

        /* Liest 4 Bytes als VORZEICHENLOSER 32-Bit-Wert (0..2^32-1) — für
         * Größenfelder (Table-/Array-/Longstr-Länge). Für den signierten
         * `long-int`-Field-Value-Typ ('I') s. longSigned(). */
        fn long() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..4 {
                v = (v << 8) | this.octet();
            }
            return v;
        }

        /* Liest 4 Bytes als VORZEICHENBEHAFTETER 32-Bit-Wert (Two's
         * Complement) — für den Field-Value-Typ 'I' (long-int). long()
         * baut den Wert unsigned auf; ohne Korrektur würde ein gesetztes
         * Bit 31 (jeder negative Int32) als riesiger positiver Int64
         * fehlinterpretiert (z. B. -42 -> 4294967254). */
        fn longSigned() -> Int64
        {
            let v = this.long();
            if v >= 2147483648 {
                return v - 4294967296;
            }
            return v;
        }

        fn longlong() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..8 {
                v = (v << 8) | this.octet();
            }
            return v;
        }

        fn rawStr(n: Int64) -> String
        {
            var s: String = "";
            for i in 0..n {
                // Bug 66 (gefixt): fromCharCode(this.octet()) direkt wertete
                // das seiteneffektbehaftete Argument doppelt aus. Fix liegt
                // in codegen.rs, aber andere Builtin-Argumente sind
                // vermutlich analog betroffen (s. bugs.md) — hier trotzdem
                // vorsichtshalber über eine lokale Variable.
                let b = this.octet();
                s = s + fromCharCode(b);
            }
            return s;
        }

        fn shortstr() -> String
        {
            let n = this.octet();
            return this.rawStr(n);
        }

        fn longstr() -> String
        {
            let n = this.long();
            return this.rawStr(n);
        }

        /* Kein Silent-Garbage: ein unbekannter Typmarker liefert
         * ErrorVal(Beschreibung) statt zu raten oder abzubrechen — der
         * Aufrufer entscheidet, ob das fatal ist. */
        fn fieldValue() -> AmqpFieldValue091
        {
            let tag = this.octet();
            if tag == 116 { // 't'
                let b = this.octet();
                return AmqpFieldValue091::BoolVal(b != 0);
            }
            if tag == 73 { // 'I'
                return AmqpFieldValue091::Int32Val(this.longSigned());
            }
            if tag == 76 { // 'L'
                return AmqpFieldValue091::Int64Val(this.longlong());
            }
            if tag == 83 { // 'S'
                return AmqpFieldValue091::StrVal(this.longstr());
            }
            if tag == 84 { // 'T'
                return AmqpFieldValue091::TimestampVal(this.longlong());
            }
            if tag == 70 { // 'F'
                return AmqpFieldValue091::TableVal(this.fieldTable());
            }
            if tag == 65 { // 'A'
                return AmqpFieldValue091::ArrayVal(this.fieldArray());
            }
            if tag == 86 { // 'V'
                return AmqpFieldValue091::VoidVal;
            }
            return AmqpFieldValue091::ErrorVal("unbekannter Field-Value-Typ: " + tag.toString());
        }

        fn fieldTable() -> Map<String, AmqpFieldValue091>
        {
            let tableLen = this.long();
            let endPos = this.pos + tableLen;
            var result: Map<String, AmqpFieldValue091> = Map::new();
            while this.pos < endPos {
                let key = this.shortstr();
                let value = this.fieldValue();
                result.insert(key, value);
            }
            return result;
        }

        fn fieldArray() -> List<AmqpFieldValue091>
        {
            let arrLen = this.long();
            let endPos = this.pos + arrLen;
            var result: List<AmqpFieldValue091> = [];
            while this.pos < endPos {
                result.push(this.fieldValue());
            }
            return result;
        }
    }
}
