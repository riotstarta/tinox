module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * Byte-Builder für die AMQP-0-9-1-Low-Level-Kodierung (Big-Endian,
     * wie das Protokoll es verlangt). Sammelt in `bytes`; wird für
     * Methoden-Argumente UND für verschachtelte Field-Tables/-Arrays
     * genutzt (letztere kodieren erst in einen eigenen Writer, um die
     * vorangestellte Byte-Länge zu kennen, s. fieldTable/fieldArray).
     */
    class AmqpWriter091
    {
        var bytes: List<Int64>;
        var tooLong: Bool;

        fn new() -> AmqpWriter091
        {
            return AmqpWriter091 { bytes: [], tooLong: false };
        }

        /* true, wenn ein `shortstr()`-Aufruf einen String > 255 Byte
         * bekam (siehe shortstr() unten) — Aufrufer MUESSEN das vor dem
         * Versenden pruefen, sonst wuerde ein falscher Laengen-Praefix
         * (octet() maskiert mit `& 0xFF`) den Frame stillschweigend
         * korrumpieren statt hart zu fehlschlagen. */
        fn hasError() -> Bool
        {
            return this.tooLong;
        }

        fn octet(v: Int64) -> Nothing
        {
            this.bytes.push(v & 0xFF);
        }

        fn short(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn long(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 24) & 0xFF);
            this.bytes.push((v >> 16) & 0xFF);
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn longlong(v: Int64) -> Nothing
        {
            var shift: Int64 = 56;
            while shift >= 0 {
                this.bytes.push((v >> shift) & 0xFF);
                shift = shift - 8;
            }
        }

        fn rawStr(s: String) -> Nothing
        {
            for i in 0..s.len() {
                this.bytes.push(s.charCodeAt(i) & 0xFF);
            }
        }

        fn rawBytes(data: List<Int64>) -> Nothing
        {
            for i in 0..data.len() {
                this.bytes.push(data[i] & 0xFF);
            }
        }

        /* Kurzstring: 1-Byte-Länge (max. 255) + Bytes — nur für Feldnamen/
         * Methodenargumente, die die Spec als shortstr deklariert. */
        fn shortstr(s: String) -> Nothing
        {
            if s.len() > 255 {
                this.tooLong = true;
                return;
            }
            this.octet(s.len());
            this.rawStr(s);
        }

        /* Langstring: 4-Byte-Länge (Big-Endian) + Bytes. */
        fn longstr(s: String) -> Nothing
        {
            this.long(s.len());
            this.rawStr(s);
        }

        /* Langstring aus rohen Bytes statt String — für Inhalte mit
         * eingebetteten NUL-Bytes (z. B. SASL-PLAIN-Response), wo eine
         * Tinox-String-Concatenation riskant wäre. */
        fn longstrBytes(data: List<Int64>) -> Nothing
        {
            this.long(data.len());
            this.rawBytes(data);
        }

        fn fieldValue(v: AmqpFieldValue091) -> Nothing
        {
            match v
            {
                BoolVal(b) => {
                    this.octet(116); // 't'
                    if b {
                        this.octet(1);
                    } else {
                        this.octet(0);
                    }
                }
                Int32Val(n) => {
                    this.octet(73); // 'I'
                    this.long(n);
                }
                Int64Val(n) => {
                    this.octet(76); // 'L'
                    this.longlong(n);
                }
                StrVal(s) => {
                    this.octet(83); // 'S'
                    this.longstr(s);
                }
                TimestampVal(t) => {
                    this.octet(84); // 'T'
                    this.longlong(t);
                }
                TableVal(t) => {
                    this.octet(70); // 'F'
                    this.fieldTable(t);
                }
                ArrayVal(a) => {
                    this.octet(65); // 'A'
                    this.fieldArray(a);
                }
                VoidVal => {
                    this.octet(86); // 'V'
                }
                ErrorVal(_msg) => {
                    // Ein ErrorVal wird nie gesendet (nur Decode-Ergebnis) —
                    // kein Silent-Garbage: harter Marker statt Schweigen,
                    // falls doch versehentlich re-encodiert wird.
                    this.octet(0);
                }
            }
        }

        /* Field-Table: 4-Byte-Länge (der folgenden Bytes) + wiederholt
         * { shortstr Schlüssel, getaggter Field-Value }. */
        fn fieldTable(t: Map<String, AmqpFieldValue091>) -> Nothing
        {
            let inner = AmqpWriter091::new();
            let keys = t.keys();
            for i in 0..keys.len() {
                let k = keys[i];
                inner.shortstr(k);
                inner.fieldValue(t.get(k));
            }
            this.long(inner.bytes.len());
            this.rawBytes(inner.bytes);
        }

        /* Field-Array: 4-Byte-Länge (der folgenden Bytes) + wiederholt
         * getaggter Field-Value (ohne Schlüssel). */
        fn fieldArray(a: List<AmqpFieldValue091>) -> Nothing
        {
            let inner = AmqpWriter091::new();
            for i in 0..a.len() {
                inner.fieldValue(a[i]);
            }
            this.long(inner.bytes.len());
            this.rawBytes(inner.bytes);
        }
    }
}
