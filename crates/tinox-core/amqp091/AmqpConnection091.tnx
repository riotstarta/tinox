module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * Eine ausgehandelte AMQP-0-9-1-Verbindung (nach vollständigem
     * connection.start/-ok/tune/-ok/open/-ok-Handshake, §1.4.2.1). `conn`
     * ist -1 bei jedem Fehlschlag (Aufrufer MUSS prüfen, kein
     * Silent-Garbage) — `errorMessage` beschreibt dann die Ursache.
     */
    class AmqpConnection091
    {
        var conn: Int64;
        var frameMax: Int64;
        var channelMax: Int64;
        var heartbeat: Int64;
        var errorMessage: String;
        var heartbeatRunning: Bool;
        var heartbeatHandle: Int64;
        /*
         * Multi-Channel-Frame-Dispatcher (issue #123). Vorher las jeder
         * synchrone Aufruf (declareQueue/qos/consume/...) direkt vom
         * Socket und nahm an, der NÄCHSTE Frame auf der Leitung sei
         * seine eigene Antwort — korrekt bei genau einem Channel, aber
         * falsch sobald ein zweiter Channel unabhängigen Traffic hat
         * (z. B. Channel 2 pusht basic.deliver während Channel 1 auf
         * queue.declare-ok wartet). Jetzt liest EIN Hintergrund-Task
         * (dispatcherHandle, gestartet in finishHandshake) jeden Frame
         * und routet ihn per chanId in die passende Channel-Inbox
         * (channelIds[i] <-> channelInboxes[i], parallele Listen statt
         * Map<Int64,_> — s. issue #129, das Map<Int64,V> segfaultet).
         * chanId==0 (Connection-Level, z. B. broker-initiiertes
         * connection.close) geht an connectionInbox. AmqpChannel091::open()
         * registriert sich selbst über registerChannelInbox() BEVOR es
         * sein channel.open sendet (sonst könnte die -ok-Antwort
         * ankommen, bevor die Inbox existiert, und stillschweigend
         * verworfen werden).
         */
        var channelIds: List<Int64>;
        var channelInboxes: List<Channel<AmqpFrame091>>;
        var connectionInbox: Channel<AmqpFrame091>;
        var dispatcherRunning: Bool;
        var dispatcherHandle: Int64;
        var nextChanId: Int64;

        /*
         * Baut eine komplette AMQP-0-9-1-Verbindung auf: dial + Protokoll-
         * Header + connection.start empfangen + start-ok (SASL PLAIN)
         * senden + tune empfangen + tune-ok senden + open + open-ok.
         * `heartbeat` ist der vom BROKER in tune vorgeschlagene und vom
         * Client in tune-ok bestaetigte Intervall in Sekunden (0 = vom
         * Broker deaktiviert); rein informativ, solange niemand
         * startHeartbeat() aufruft — analog zu amqp10s idleTimeoutMs
         * (s. Amqp10Connection::startHeartbeat()), v1-Tradeoff bewusst
         * identisch: kein automatischer Heartbeat ohne expliziten Aufruf.
         */
        fn connect(host: String, port: Int64, vhost: String, user: String, pass: String) -> AmqpConnection091
        {
            let conn = Amqp091::dial(host, port);
            if conn <= 0 {
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "dial fehlgeschlagen", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            return AmqpConnection091::finishHandshake(conn, vhost, user, pass);
        }

        /*
         * amqps:// — TLS-Variante von connect() (Broker-Standardport 5671).
         * Sonst identisch zu connect(): teilt sich den gesamten Handshake
         * (finishHandshake), weil dieser ausschließlich über httpConn*
         * läuft — TLS- und Plaintext-transparent (s. dial/dialTls).
         * verify=true (empfohlen für echte Broker-Zertifikate) prüft die
         * Zertifikatskette + den Hostnamen gegen die System-CA-Stores;
         * verify=false ist ein bewusster Opt-out für selbstsignierte
         * Testzertifikate.
         */
        fn connectTls(host: String, port: Int64, vhost: String, user: String, pass: String, verify: Bool) -> AmqpConnection091
        {
            let conn = Amqp091::dialTls(host, port, verify);
            if conn <= 0 {
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "dial fehlgeschlagen (TLS)", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            return AmqpConnection091::finishHandshake(conn, vhost, user, pass);
        }

        /*
         * Gemeinsamer Handshake-Kern von connect()/connectTls() nach dem
         * dial: Protokoll-Header + connection.start/-ok/tune/-ok/open/-ok
         * (§1.4.2.1). `conn` ist ein bereits verbundenes Handle (Plaintext
         * ODER TLS — beide sind über httpConn* transparent).
         */
        fn finishHandshake(conn: Int64, vhost: String, user: String, pass: String) -> AmqpConnection091
        {
            Amqp091::sendProtocolHeader(conn);

            // --- connection.start ---
            let f1 = Amqp091::readFrame(conn);
            if f1.frameType != 1 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "Protokoll-Header abgelehnt oder Handshake fehlgeschlagen (frameType=" + f1.frameType.toString() + ")", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            let startMethod = Amqp091::decodeMethodPayload(f1.payload);
            if startMethod.classId != 10 || startMethod.methodId != 10 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.start, bekam class=" + startMethod.classId.toString() + " method=" + startMethod.methodId.toString(), heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            let startArgs = AmqpReader091::new(startMethod.args);
            startArgs.octet(); // version-major (ungeprüft — schon via Protokoll-Header validiert)
            startArgs.octet(); // version-minor
            startArgs.fieldTable(); // server-properties (v1: nicht ausgewertet)
            let mechanisms = startArgs.longstr();
            startArgs.longstr(); // locales (v1: immer en_US angeboten)

            if !mechanisms.contains("PLAIN") {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "Broker bietet SASL-Mechanismus PLAIN nicht an (angeboten: " + mechanisms + ")", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }

            // --- connection.start-ok ---
            let w1 = AmqpWriter091::new();
            var clientProps: Map<String, AmqpFieldValue091> = Map::new();
            clientProps.insert("product", AmqpFieldValue091::StrVal("tinox"));
            clientProps.insert("platform", AmqpFieldValue091::StrVal("tinox-amqp091"));
            clientProps.insert("version", AmqpFieldValue091::StrVal("0.1"));
            w1.fieldTable(clientProps);
            w1.shortstr("PLAIN");
            w1.longstrBytes(Amqp091::saslPlainResponse(user, pass));
            w1.shortstr("en_US");
            let startOkPayload = Amqp091::encodeMethodPayload(10, 11, w1.bytes);
            Amqp091::writeFrame(conn, 1, 0, startOkPayload);

            // --- connection.tune ---
            let f2 = Amqp091::readFrame(conn);
            if f2.frameType != 1 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.tune (frameType=" + f2.frameType.toString() + ")", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            let tuneMethod = Amqp091::decodeMethodPayload(f2.payload);
            if tuneMethod.classId == 10 && tuneMethod.methodId == 50 {
                let msg = Amqp091::describeAndAckClose(conn, 0, tuneMethod, 51);
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "SASL/Handshake fehlgeschlagen: " + msg, heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            if tuneMethod.classId != 10 || tuneMethod.methodId != 30 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.tune, bekam class=" + tuneMethod.classId.toString() + " method=" + tuneMethod.methodId.toString(), heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            let tuneArgs = AmqpReader091::new(tuneMethod.args);
            let serverChannelMax = tuneArgs.short();
            let serverFrameMax = tuneArgs.long();
            let serverHeartbeat = tuneArgs.short();

            // --- connection.tune-ok ---
            var negotiatedFrameMax: Int64 = 131072;
            if serverFrameMax > 0 {
                negotiatedFrameMax = serverFrameMax;
            }
            let w2 = AmqpWriter091::new();
            w2.short(serverChannelMax);
            w2.long(negotiatedFrameMax);
            // Echo the broker's proposed heartbeat interval back as-is
            // (RabbitMQ and most brokers default to 60s; 0 = broker
            // disabled heartbeats). Sending doesn't start automatically —
            // see startHeartbeat() below, same explicit-opt-in v1 design
            // as Amqp10Connection::startHeartbeat().
            w2.short(serverHeartbeat);
            let tuneOkPayload = Amqp091::encodeMethodPayload(10, 31, w2.bytes);
            Amqp091::writeFrame(conn, 1, 0, tuneOkPayload);

            // --- connection.open ---
            let w3 = AmqpWriter091::new();
            w3.shortstr(vhost);
            w3.shortstr(""); // reserved-1 (capabilities, deprecated)
            w3.octet(0);     // reserved-2 (insist, deprecated bit)
            let openPayload = Amqp091::encodeMethodPayload(10, 40, w3.bytes);
            Amqp091::writeFrame(conn, 1, 0, openPayload);

            let f3 = Amqp091::readFrame(conn);
            if f3.frameType != 1 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.open-ok (frameType=" + f3.frameType.toString() + ")", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            let openMethod = Amqp091::decodeMethodPayload(f3.payload);
            if openMethod.classId == 10 && openMethod.methodId == 50 {
                let msg = Amqp091::describeAndAckClose(conn, 0, openMethod, 51);
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "connection.open fehlgeschlagen: " + msg, heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }
            if openMethod.classId != 10 || openMethod.methodId != 41 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.open-ok, bekam class=" + openMethod.classId.toString() + " method=" + openMethod.methodId.toString(), heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: false, dispatcherHandle: -1, nextChanId: 0 };
            }

            // Der Dispatcher (issue #123) muss laufen, BEVOR irgendein
            // AmqpChannel091::open() aufgerufen werden kann — deshalb hier
            // gestartet, direkt bevor die fertige Connection zurückgegeben
            // wird, statt den Aufrufer das explizit anstoßen zu lassen.
            var result = AmqpConnection091 { conn: conn, frameMax: negotiatedFrameMax, channelMax: serverChannelMax, heartbeat: serverHeartbeat, errorMessage: "", heartbeatRunning: false, heartbeatHandle: -1, channelIds: [], channelInboxes: [], connectionInbox: channel, dispatcherRunning: true, dispatcherHandle: -1, nextChanId: 0 };
            result.dispatcherHandle = spawn amqp091DispatchLoop(result);
            return result;
        }

        /*
         * Vergibt eine neue Channel-ID (issue #123): fortlaufend ab 1,
         * niemals wiederverwendet innerhalb einer Connection (v1: kein
         * AmqpChannel091::close() existiert, das eine ID freigeben
         * könnte — s. Modul-Kommentar oben zu channelIds/channelInboxes).
         */
        fn allocateChanId() -> Int64
        {
            this.nextChanId = this.nextChanId + 1;
            return this.nextChanId;
        }

        /*
         * Registriert die Inbox eines frisch geöffneten Channels beim
         * Dispatcher (issue #123). MUSS aufgerufen werden, BEVOR das
         * zugehörige channel.open gesendet wird — sonst könnte
         * channel.open-ok ankommen, bevor die Inbox existiert, und der
         * Dispatcher würde den Frame mangels registrierter chanId
         * verwerfen (s. amqp091DispatchLoop).
         */
        fn registerChannelInbox(chanId: Int64, inbox: Channel<AmqpFrame091>) -> Nothing
        {
            this.channelIds.push(chanId);
            this.channelInboxes.push(inbox);
        }

        /*
         * Sendet EIN Heartbeat-Frame (frameType 8, Channel 0, leerer
         * Payload — §4.2.7). Kann manuell aufgerufen werden, fuer den
         * ueblichen Fall aber s. startHeartbeat().
         */
        fn sendHeartbeat() -> Nothing
        {
            Amqp091::writeFrame(this.conn, 8, 0, []);
        }

        /*
         * Startet einen Hintergrund-Task (echter Thread, s. spawn), der
         * alle `intervalMs` ein Heartbeat sendet, bis stopHeartbeat()
         * (oder close()) aufgerufen wird — identisches Muster zu
         * Amqp10Connection::startHeartbeat() (s. dort fuer die
         * Thread-Sicherheits-Begruendung: httpConnWriteBytes() ist pro
         * Connection-Handle gemutext, Issue 82). `intervalMs` sollte
         * deutlich unter `this.heartbeat * 1000` liegen (Spec-Empfehlung:
         * haeufiger senden als das ausgehandelte Intervall, wegen
         * Taktungenauigkeit) — v1 ueberlaesst die konkrete Wahl bewusst
         * dem Aufrufer statt sie automatisch aus heartbeat abzuleiten,
         * analog zum expliziten grantCredit()-Muster.
         */
        fn startHeartbeat(intervalMs: Int64) -> Nothing
        {
            this.heartbeatRunning = true;
            this.heartbeatHandle = spawn amqp091HeartbeatLoop(this, intervalMs);
        }

        /*
         * Stoppt den Heartbeat-Task und wartet, bis er wirklich beendet
         * ist (await joint den Task) — WICHTIG vor close(), sonst koennte
         * der Heartbeat-Task noch versuchen, ueber ein bereits
         * geschlossenes Handle zu schreiben.
         */
        fn stopHeartbeat() -> Nothing
        {
            if this.heartbeatRunning {
                this.heartbeatRunning = false;
                await this.heartbeatHandle;
            }
        }

        /*
         * Schließt die Verbindung spec-konform: Heartbeat-Task zuerst
         * sauber stoppen (s. stopHeartbeat()), dann connection.close
         * senden und auf close-ok warten (v1 ungeprüft, jetzt über
         * connectionInbox statt direkt vom Socket — issue #123), dann
         * den Socket schließen und den Dispatcher-Task joinen: der
         * Socket-Close lässt dessen laufenden readFrame()-Aufruf mit
         * frameType -1 zurückkehren, wonach er sich selbst beendet — das
         * await hier stellt sicher, dass er wirklich fertig ist (kein
         * unjoined Thread), statt sich einfach auf "läuft schon
         * irgendwann aus" zu verlassen.
         */
        fn close() -> Nothing
        {
            this.stopHeartbeat();
            let w = AmqpWriter091::new();
            w.short(200); // reply-code: normal shutdown (RabbitMQ-Konvention)
            w.shortstr("OK");
            w.short(0); // class-id (kein Bezug)
            w.short(0); // method-id (kein Bezug)
            let closePayload = Amqp091::encodeMethodPayload(10, 50, w.bytes);
            Amqp091::writeFrame(this.conn, 1, 0, closePayload);
            recv this.connectionInbox; // erwartet close-ok, v1 ungeprüft
            httpConnClose(this.conn);
            await this.dispatcherHandle;
        }
    }

    /*
     * Hintergrund-Dispatcher (issue #123): liest jeden Frame direkt vom
     * Socket und routet ihn per chanId an die passende Channel-Inbox
     * (registriert von AmqpChannel091::open() über
     * registerChannelInbox()) statt jeden synchronen Aufruf selbst vom
     * Socket lesen zu lassen — das war der eigentliche Grund, warum
     * mehrere Channels mit unabhängigem Traffic vorher nicht sicher
     * waren (s. Klassen-Kommentar oben). chanId==0 (Connection-Level,
     * z. B. broker-initiiertes connection.close) geht an
     * connectionInbox.
     *
     * Heartbeat-Frames (frameType 8) werden hier abgefangen und NIE
     * weitergeleitet — ein Seiteneffekt, der einen vorbestehenden,
     * nie beobachteten Bug schließt: ohne Dispatcher hätte ein
     * eingehender Heartbeat fälschlich als Antwort auf eine wartende
     * synchrone Anfrage missinterpretiert werden können.
     *
     * Bei EOF/Verbindungsfehler (frameType -1) weckt der Dispatcher
     * JEDEN aktuell registrierten Wartenden (connectionInbox + jede
     * Channel-Inbox) mit demselben synthetischen Fehler-Frame auf,
     * statt sie für immer blockiert zu lassen — ein hängender Reader
     * sähe sonst wie ein Deadlock aus, nicht wie eine sauber erkannte
     * geschlossene Verbindung.
     */
    async fn amqp091DispatchLoop(connection: AmqpConnection091) -> Int64
    {
        while connection.dispatcherRunning {
            let f = Amqp091::readFrame(connection.conn);
            if f.frameType == -1 {
                connection.dispatcherRunning = false;
                send connection.connectionInbox -> f;
                for i in 0..connection.channelInboxes.len() {
                    send connection.channelInboxes[i] -> f;
                }
                break;
            }
            if f.frameType == 8 {
                continue;
            }
            if f.chanId == 0 {
                send connection.connectionInbox -> f;
            } else {
                for i in 0..connection.channelIds.len() {
                    if connection.channelIds[i] == f.chanId {
                        send connection.channelInboxes[i] -> f;
                    }
                }
                // unbekannte chanId (z. B. Race beim Channel-Aufbau) --
                // Frame verwerfen statt den Dispatcher zu blockieren.
            }
        }
        return 1;
    }

    /*
     * Hintergrund-Schleife fuer AmqpConnection091::startHeartbeat() — als
     * freie Funktion statt Instanzmethode, weil spawn eine eigenstaendige
     * Funktion braucht (kein spawnbarer this-gebundener Methodenaufruf);
     * `conn` ist dieselbe (Referenz-)Instanz wie beim Aufrufer, Mutationen
     * an conn.heartbeatRunning sind fuer beide Threads sichtbar (Class-
     * Instanzen sind Heap-Objekte). Identisch zu amqp10HeartbeatLoop.
     */
    async fn amqp091HeartbeatLoop(conn: AmqpConnection091, intervalMs: Int64) -> Int64
    {
        while conn.heartbeatRunning {
            sleep_ms(intervalMs);
            if conn.heartbeatRunning {
                conn.sendHeartbeat();
            }
        }
        return 1;
    }
}
