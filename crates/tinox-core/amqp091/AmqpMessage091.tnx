module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * Eine per `nextMessage()` empfangene Nachricht. `ok == false` bei
     * jedem Fehler (Aufrufer MUSS prüfen, kein Silent-Garbage) —
     * `errorMessage` beschreibt dann die Ursache.
     */
    class AmqpMessage091
    {
        var deliveryTag: Int64;
        var exchange: String;
        var routingKey: String;
        var contentType: String;
        var body: List<Int64>;
        var ok: Bool;
        var errorMessage: String;
    }
}
