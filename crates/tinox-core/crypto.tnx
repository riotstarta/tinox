module tinox.core.crypto;

import tinox.core.random;

namespace tinox.core.crypto
{
    class Crypto
    {
        fn md5(data: String) -> String
        {
            return md5Hash(data);
        }

        fn sha256(data: String) -> String
        {
            return sha256Hash(data);
        }

        fn hmacSha256(data: String, key: String) -> String
        {
            return hmacSha256Hash(data, key);
        }

        // AES ist nicht implementiert. Ein Platzhalter (z. B. XOR-Stream)
        // waere hier gefaehrlich: der Methodenname verspricht echte
        // Verschluesselung, ein schwacher Ersatz wuerde das stillschweigend
        // untergraben. Lieber laut scheitern als falsche Sicherheit bieten.
        fn aesEncrypt(data: String, key: String) -> String
        {
            throw "Crypto::aesEncrypt ist nicht implementiert";
        }

        fn aesDecrypt(data: String, key: String) -> String
        {
            throw "Crypto::aesDecrypt ist nicht implementiert";
        }

        fn generateKey(length: Int64) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < length
            {
                let byte: Int64 = Random::nextInt(256);
                result = result + fromCharCode(byte);
                i = i + 1;
            }
            return result;
        }

        fn pbkdf2(password: String, salt: String, iterations: Int64, keyLength: Int64) -> String
        {
            var result: String = password + salt;
            var i: Int64 = 0;
            while i < iterations
            {
                result = Crypto::sha256(result);
                i = i + 1;
            }
            return result.substring(0, keyLength);
        }
    }
}