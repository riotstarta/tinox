module tinox.core.crypto;

namespace tinox.core.crypto
{
    class Crypto
    {
        fnc md5(data: String) -> String
        {
            return md5Hash(data);
        }

        fnc sha256(data: String) -> String
        {
            return sha256Hash(data);
        }

        fnc hmacSha256(data: String, key: String) -> String
        {
            return hmacSha256Hash(data, key);
        }

        fnc aesEncrypt(data: String, key: String) -> String
        {
            return aesEncrypt(data, key);
        }

        fnc aesDecrypt(data: String, key: String) -> String
        {
            return aesDecrypt(data, key);
        }

        fnc generateKey(length: Int64) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < length
            {
                let byte: Int64 = Random::nextInt(256);
                result = result + fromCharCode(byte);
                i = i + 1;
            }
            return result;
        }

        fnc pbkdf2(password: String, salt: String, iterations: Int64, keyLength: Int64) -> String
        {
            var result: String = password + salt;
            var i: Int64 = 0;
            while i < iterations
            {
                result = Crypto::sha256(result);
                i = i + 1;
            }
            return result.substring(0, keyLength);
        }
    }
}