module tinox.core.amqp091;

import tinox.core.socket;

/*
 * AMQP-0-9-1-Client über der Conn-Handle-Architektur des HTTP-Servers
 * (dieselbe Grundlage wie WebSocket, s. tasklist.md). Kein Broker/Server —
 * nur der Client-seitige Verbindungsaufbau zu einem bestehenden Broker
 * (RabbitMQ etc.).
 *
 * Aufbau siehe tasklist.md (Phasen 1-5). Bytes laufen als List<Int64> (ein
 * Byte 0..255 pro Slot) über die binärsicheren Primitiven
 * httpConnReadN/httpConnWriteBytes — dieselben, die schon für WebSocket
 * genutzt werden. Verbindungsaufbau über socketCreateTcp/socketConnect,
 * dann httpConnFromFd, um den nackten fd binärsicher zu wickeln.
 *
 * Bewusste v1-Lücken (tasklist.md "Später"): kein TLS-Client (nur amqp://,
 * kein amqps://), keine Negotiation (Phase 3), kein Content-Header-
 * Property-Codec (gehört fachlich zu Phase 4 basic.publish, nicht zum
 * generischen Frame-Codec hier).
 */

namespace tinox.core.amqp091
{
    /*
     * Ein gelesener Frame (AMQP 0-9-1 §4.2.3). frameType: 1=METHOD,
     * 2=HEADER, 3=BODY, 4=HEARTBEAT; zusätzlich als Lese-Ergebnis: -1 =
     * Verbindung zu/EOF, -2 = Protokollfehler (fehlender 0xCE-Terminator
     * oder Payload-Cap überschritten).
     */
    class AmqpFrame091
    {
        var frameType: Int64;
        var chanId: Int64;
        var payload: List<Int64>;
    }

    /*
     * Ein getaggter AMQP-Field-Value (Field-Table-/Field-Array-Elemente).
     * Typmarker folgen der RabbitMQ-Konvention (t/I/L/S/T/F/A/V) — s.
     * AmqpWriter091::fieldValue/AmqpReader091::fieldValue für die Bytes.
     * ErrorVal transportiert einen Decode-Fehler (unbekannter Typmarker)
     * als Wert statt einer Exception — Aufrufer MUSS prüfen (kein
     * Silent-Garbage), analog zu WsFrame.opcode -1/-2 bei WebSocket.
     */
    enum AmqpFieldValue091
    {
        BoolVal(Bool);
        Int32Val(Int64);
        Int64Val(Int64);
        StrVal(String);
        TimestampVal(Int64);
        TableVal(Map<String, AmqpFieldValue091>);
        ArrayVal(List<AmqpFieldValue091>);
        VoidVal;
        ErrorVal(String);
    }

    /*
     * Byte-Builder für die AMQP-0-9-1-Low-Level-Kodierung (Big-Endian,
     * wie das Protokoll es verlangt). Sammelt in `bytes`; wird für
     * Methoden-Argumente UND für verschachtelte Field-Tables/-Arrays
     * genutzt (letztere kodieren erst in einen eigenen Writer, um die
     * vorangestellte Byte-Länge zu kennen, s. fieldTable/fieldArray).
     */
    class AmqpWriter091
    {
        var bytes: List<Int64>;
        var tooLong: Bool;

        fn new() -> AmqpWriter091
        {
            return AmqpWriter091 { bytes: [], tooLong: false };
        }

        /* true, wenn ein `shortstr()`-Aufruf einen String > 255 Byte
         * bekam (siehe shortstr() unten) — Aufrufer MUESSEN das vor dem
         * Versenden pruefen, sonst wuerde ein falscher Laengen-Praefix
         * (octet() maskiert mit `& 0xFF`) den Frame stillschweigend
         * korrumpieren statt hart zu fehlschlagen. */
        fn hasError() -> Bool
        {
            return this.tooLong;
        }

        fn octet(v: Int64) -> Nothing
        {
            this.bytes.push(v & 0xFF);
        }

        fn short(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn long(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 24) & 0xFF);
            this.bytes.push((v >> 16) & 0xFF);
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn longlong(v: Int64) -> Nothing
        {
            var shift: Int64 = 56;
            while shift >= 0 {
                this.bytes.push((v >> shift) & 0xFF);
                shift = shift - 8;
            }
        }

        fn rawStr(s: String) -> Nothing
        {
            for i in 0..s.len() {
                this.bytes.push(s.charCodeAt(i) & 0xFF);
            }
        }

        fn rawBytes(data: List<Int64>) -> Nothing
        {
            for i in 0..data.len() {
                this.bytes.push(data[i] & 0xFF);
            }
        }

        /* Kurzstring: 1-Byte-Länge (max. 255) + Bytes — nur für Feldnamen/
         * Methodenargumente, die die Spec als shortstr deklariert. */
        fn shortstr(s: String) -> Nothing
        {
            if s.len() > 255 {
                this.tooLong = true;
                return;
            }
            this.octet(s.len());
            this.rawStr(s);
        }

        /* Langstring: 4-Byte-Länge (Big-Endian) + Bytes. */
        fn longstr(s: String) -> Nothing
        {
            this.long(s.len());
            this.rawStr(s);
        }

        /* Langstring aus rohen Bytes statt String — für Inhalte mit
         * eingebetteten NUL-Bytes (z. B. SASL-PLAIN-Response), wo eine
         * Tinox-String-Concatenation riskant wäre. */
        fn longstrBytes(data: List<Int64>) -> Nothing
        {
            this.long(data.len());
            this.rawBytes(data);
        }

        fn fieldValue(v: AmqpFieldValue091) -> Nothing
        {
            match v
            {
                BoolVal(b) => {
                    this.octet(116); // 't'
                    if b {
                        this.octet(1);
                    } else {
                        this.octet(0);
                    }
                }
                Int32Val(n) => {
                    this.octet(73); // 'I'
                    this.long(n);
                }
                Int64Val(n) => {
                    this.octet(76); // 'L'
                    this.longlong(n);
                }
                StrVal(s) => {
                    this.octet(83); // 'S'
                    this.longstr(s);
                }
                TimestampVal(t) => {
                    this.octet(84); // 'T'
                    this.longlong(t);
                }
                TableVal(t) => {
                    this.octet(70); // 'F'
                    this.fieldTable(t);
                }
                ArrayVal(a) => {
                    this.octet(65); // 'A'
                    this.fieldArray(a);
                }
                VoidVal => {
                    this.octet(86); // 'V'
                }
                ErrorVal(_msg) => {
                    // Ein ErrorVal wird nie gesendet (nur Decode-Ergebnis) —
                    // kein Silent-Garbage: harter Marker statt Schweigen,
                    // falls doch versehentlich re-encodiert wird.
                    this.octet(0);
                }
            }
        }

        /* Field-Table: 4-Byte-Länge (der folgenden Bytes) + wiederholt
         * { shortstr Schlüssel, getaggter Field-Value }. */
        fn fieldTable(t: Map<String, AmqpFieldValue091>) -> Nothing
        {
            let inner = AmqpWriter091::new();
            let keys = t.keys();
            for i in 0..keys.len() {
                let k = keys[i];
                inner.shortstr(k);
                inner.fieldValue(t.get(k));
            }
            this.long(inner.bytes.len());
            this.rawBytes(inner.bytes);
        }

        /* Field-Array: 4-Byte-Länge (der folgenden Bytes) + wiederholt
         * getaggter Field-Value (ohne Schlüssel). */
        fn fieldArray(a: List<AmqpFieldValue091>) -> Nothing
        {
            let inner = AmqpWriter091::new();
            for i in 0..a.len() {
                inner.fieldValue(a[i]);
            }
            this.long(inner.bytes.len());
            this.rawBytes(inner.bytes);
        }
    }

    /*
     * Gegenstück zu AmqpWriter091: liest big-endian aus `bytes` ab einer
     * internen Cursor-Position `pos`. Kein Bounds-Check auf Array-Ebene
     * (Aufrufer MUSS die Frame-Größe vorher kennen, s. AmqpFrame091.payload
     * — die Länge kommt immer aus dem äußeren Frame-Header).
     */
    class AmqpReader091
    {
        var bytes: List<Int64>;
        var pos: Int64;

        fn new(bytes: List<Int64>) -> AmqpReader091
        {
            return AmqpReader091 { bytes: bytes, pos: 0 };
        }

        fn remaining() -> Int64
        {
            return this.bytes.len() - this.pos;
        }

        fn octet() -> Int64
        {
            let v = this.bytes[this.pos];
            this.pos = this.pos + 1;
            return v;
        }

        fn short() -> Int64
        {
            let hi = this.octet();
            let lo = this.octet();
            return (hi << 8) | lo;
        }

        /* Liest 4 Bytes als VORZEICHENLOSER 32-Bit-Wert (0..2^32-1) — für
         * Größenfelder (Table-/Array-/Longstr-Länge). Für den signierten
         * `long-int`-Field-Value-Typ ('I') s. longSigned(). */
        fn long() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..4 {
                v = (v << 8) | this.octet();
            }
            return v;
        }

        /* Liest 4 Bytes als VORZEICHENBEHAFTETER 32-Bit-Wert (Two's
         * Complement) — für den Field-Value-Typ 'I' (long-int). long()
         * baut den Wert unsigned auf; ohne Korrektur würde ein gesetztes
         * Bit 31 (jeder negative Int32) als riesiger positiver Int64
         * fehlinterpretiert (z. B. -42 -> 4294967254). */
        fn longSigned() -> Int64
        {
            let v = this.long();
            if v >= 2147483648 {
                return v - 4294967296;
            }
            return v;
        }

        fn longlong() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..8 {
                v = (v << 8) | this.octet();
            }
            return v;
        }

        fn rawStr(n: Int64) -> String
        {
            var s: String = "";
            for i in 0..n {
                // Bug 66 (gefixt): fromCharCode(this.octet()) direkt wertete
                // das seiteneffektbehaftete Argument doppelt aus. Fix liegt
                // in codegen.rs, aber andere Builtin-Argumente sind
                // vermutlich analog betroffen (s. bugs.md) — hier trotzdem
                // vorsichtshalber über eine lokale Variable.
                let b = this.octet();
                s = s + fromCharCode(b);
            }
            return s;
        }

        fn shortstr() -> String
        {
            let n = this.octet();
            return this.rawStr(n);
        }

        fn longstr() -> String
        {
            let n = this.long();
            return this.rawStr(n);
        }

        /* Kein Silent-Garbage: ein unbekannter Typmarker liefert
         * ErrorVal(Beschreibung) statt zu raten oder abzubrechen — der
         * Aufrufer entscheidet, ob das fatal ist. */
        fn fieldValue() -> AmqpFieldValue091
        {
            let tag = this.octet();
            if tag == 116 { // 't'
                let b = this.octet();
                return AmqpFieldValue091::BoolVal(b != 0);
            }
            if tag == 73 { // 'I'
                return AmqpFieldValue091::Int32Val(this.longSigned());
            }
            if tag == 76 { // 'L'
                return AmqpFieldValue091::Int64Val(this.longlong());
            }
            if tag == 83 { // 'S'
                return AmqpFieldValue091::StrVal(this.longstr());
            }
            if tag == 84 { // 'T'
                return AmqpFieldValue091::TimestampVal(this.longlong());
            }
            if tag == 70 { // 'F'
                return AmqpFieldValue091::TableVal(this.fieldTable());
            }
            if tag == 65 { // 'A'
                return AmqpFieldValue091::ArrayVal(this.fieldArray());
            }
            if tag == 86 { // 'V'
                return AmqpFieldValue091::VoidVal;
            }
            return AmqpFieldValue091::ErrorVal("unbekannter Field-Value-Typ: " + tag.toString());
        }

        fn fieldTable() -> Map<String, AmqpFieldValue091>
        {
            let tableLen = this.long();
            let endPos = this.pos + tableLen;
            var result: Map<String, AmqpFieldValue091> = Map::new();
            while this.pos < endPos {
                let key = this.shortstr();
                let value = this.fieldValue();
                result.insert(key, value);
            }
            return result;
        }

        fn fieldArray() -> List<AmqpFieldValue091>
        {
            let arrLen = this.long();
            let endPos = this.pos + arrLen;
            var result: List<AmqpFieldValue091> = [];
            while this.pos < endPos {
                result.push(this.fieldValue());
            }
            return result;
        }
    }

    /*
     * Generische Hülle eines METHOD-Frame-Payloads (§4.2.4): class-id +
     * method-id + Argument-Bytes. Die konkrete Argument-Reihenfolge pro
     * Methode (z. B. connection.start-ok) baut/liest Phase 3 über einen
     * frischen AmqpWriter091/AmqpReader091 auf `args`.
     */
    class AmqpMethodFrame091
    {
        var classId: Int64;
        var methodId: Int64;
        var args: List<Int64>;
    }

    class Amqp091
    {
        /*
         * Verbindet zum Broker (rohes TCP), noch OHNE Protokoll-Handshake.
         * Rückgabe: Conn-Handle (>0) oder -1 bei Verbindungsfehler.
         */
        fn dial(host: String, port: Int64) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                return -1;
            }
            return httpConnFromFd(fd);
        }

        /*
         * Sendet den 8-Byte-Protokoll-Header (AMQP 0-9-1 §4.2.2):
         * "AMQP" 0x00 0x00 0x09 0x01.
         */
        fn sendProtocolHeader(conn: Int64) -> Nothing
        {
            let header: List<Int64> = [65, 77, 81, 80, 0, 0, 9, 1];
            httpConnWriteBytes(conn, header);
        }

        /*
         * Prüft die Antwort auf den Protokoll-Header: liest das erste Byte
         * der Antwort. Unterstützt der Broker 0-9-1, ist das der Beginn
         * eines echten METHOD-Frames (Typ-Oktett 1, das Frame ist
         * `connection.start` — Parsing folgt in Phase 2). Bei
         * Versions-Mismatch echot der Broker denselben 8-Byte-Header-Aufbau
         * zurück und schließt (erstes Byte 'A' = 65) — das UND jeder
         * andere Wert ≠ 1 sowie EOF/Kurzread gelten als harter Fehlschlag.
         */
        fn checkHandshakeResponse(conn: Int64) -> Bool
        {
            let resp = httpConnReadN(conn, 1);
            if resp.len() < 1 {
                return false;
            }
            return resp[0] == 1;
        }

        /*
         * Liest genau EINEN Frame (blockierend): Typ-Oktett + Channel
         * (short) + Größe (long) + Payload + 0xCE-Terminator (§4.2.3).
         * EOF/Kurzread -> frameType -1; fehlender 0xCE ODER Payload > Cap
         * -> frameType -2 (Protokollfehler, Aufrufer schließt).
         */
        fn readFrame(conn: Int64) -> AmqpFrame091
        {
            let bad = AmqpFrame091 { frameType: -1, chanId: 0, payload: [] };
            let hdr = httpConnReadN(conn, 7);
            if hdr.len() < 7 {
                return bad;
            }
            let frameType = hdr[0];
            let chanId = (hdr[1] << 8) | hdr[2];
            let size = (hdr[3] << 24) | (hdr[4] << 16) | (hdr[5] << 8) | hdr[6];
            if size < 0 || size > 16777216 {
                return AmqpFrame091 { frameType: -2, chanId: chanId, payload: [] };
            }
            var payload: List<Int64> = [];
            if size > 0 {
                let raw = httpConnReadN(conn, size);
                if raw.len() < size {
                    return bad;
                }
                payload = raw;
            }
            let end = httpConnReadN(conn, 1);
            if end.len() < 1 {
                return bad;
            }
            if end[0] != 0xCE {
                return AmqpFrame091 { frameType: -2, chanId: chanId, payload: [] };
            }
            return AmqpFrame091 { frameType: frameType, chanId: chanId, payload: payload };
        }

        /*
         * Schreibt einen Frame Client->Broker (§4.2.3).
         */
        fn writeFrame(conn: Int64, frameType: Int64, chanId: Int64, payload: List<Int64>) -> Nothing
        {
            let w = AmqpWriter091::new();
            w.octet(frameType);
            w.short(chanId);
            w.long(payload.len());
            w.rawBytes(payload);
            w.octet(0xCE);
            httpConnWriteBytes(conn, w.bytes);
        }

        /*
         * Baut den Payload eines METHOD-Frames (§4.2.4): class-id +
         * method-id + bereits kodierte Argument-Bytes (Aufrufer nutzt
         * einen eigenen AmqpWriter091 für die methodenspezifische
         * Argument-Reihenfolge, s. Phase 3).
         */
        fn encodeMethodPayload(classId: Int64, methodId: Int64, args: List<Int64>) -> List<Int64>
        {
            let w = AmqpWriter091::new();
            w.short(classId);
            w.short(methodId);
            w.rawBytes(args);
            return w.bytes;
        }

        /*
         * Zerlegt einen METHOD-Frame-Payload in class-id/method-id +
         * restliche Argument-Bytes (zum Weiterverarbeiten mit einem
         * frischen AmqpReader091).
         */
        fn decodeMethodPayload(payload: List<Int64>) -> AmqpMethodFrame091
        {
            let r = AmqpReader091::new(payload);
            let classId = r.short();
            let methodId = r.short();
            var args: List<Int64> = [];
            while r.remaining() > 0 {
                args.push(r.octet());
            }
            return AmqpMethodFrame091 { classId: classId, methodId: methodId, args: args };
        }

        /*
         * Baut den SASL-PLAIN-Response-Byte-String: NUL + Username + NUL +
         * Passwort (RFC 4616). Als List<Int64> statt String, weil das
         * eingebettete NUL-Byte eine Tinox-String-Concatenation riskant
         * machen würde (s. longstrBytes).
         */
        fn saslPlainResponse(user: String, pass: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            bytes.push(0);
            for i in 0..user.len() {
                bytes.push(user.charCodeAt(i) & 0xFF);
            }
            bytes.push(0);
            for i in 0..pass.len() {
                bytes.push(pass.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        /*
         * Behandelt eine unerwartete `connection.close`/`channel.close`
         * (z. B. SASL-Fehler, unbekannter vhost): quittiert spec-konform
         * mit close-ok (reply-code/reply-text-Felder haben in beiden
         * Klassen dieselbe Position: short + shortstr zuerst) und liefert
         * eine Fehlermeldung zum Weiterreichen.
         */
        fn describeAndAckClose(conn: Int64, chanId: Int64, mf: AmqpMethodFrame091, closeOkMethodId: Int64) -> String
        {
            let r = AmqpReader091::new(mf.args);
            let replyCode = r.short();
            let replyText = r.shortstr();
            let closeOkPayload = Amqp091::encodeMethodPayload(mf.classId, closeOkMethodId, []);
            Amqp091::writeFrame(conn, 1, chanId, closeOkPayload);
            return "Broker schloss mit Code " + replyCode.toString() + ": " + replyText;
        }
    }

    /*
     * Eine ausgehandelte AMQP-0-9-1-Verbindung (nach vollständigem
     * connection.start/-ok/tune/-ok/open/-ok-Handshake, §1.4.2.1). `conn`
     * ist -1 bei jedem Fehlschlag (Aufrufer MUSS prüfen, kein
     * Silent-Garbage) — `errorMessage` beschreibt dann die Ursache.
     */
    class AmqpConnection091
    {
        var conn: Int64;
        var frameMax: Int64;
        var channelMax: Int64;
        var heartbeat: Int64;
        var errorMessage: String;

        /*
         * Baut eine komplette AMQP-0-9-1-Verbindung auf: dial + Protokoll-
         * Header + connection.start empfangen + start-ok (SASL PLAIN)
         * senden + tune empfangen + tune-ok senden + open + open-ok.
         * v1: übernimmt die Server-Vorschläge aus tune (channel-max,
         * frame-max), Heartbeat wird auf 0 (deaktiviert) geklemmt — es gibt
         * noch keinen Heartbeat-Sender (s. tasklist.md "Später").
         */
        fn connect(host: String, port: Int64, vhost: String, user: String, pass: String) -> AmqpConnection091
        {
            let conn = Amqp091::dial(host, port);
            if conn <= 0 {
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "dial fehlgeschlagen" };
            }
            Amqp091::sendProtocolHeader(conn);

            // --- connection.start ---
            let f1 = Amqp091::readFrame(conn);
            if f1.frameType != 1 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "Protokoll-Header abgelehnt oder Handshake fehlgeschlagen (frameType=" + f1.frameType.toString() + ")" };
            }
            let startMethod = Amqp091::decodeMethodPayload(f1.payload);
            if startMethod.classId != 10 || startMethod.methodId != 10 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.start, bekam class=" + startMethod.classId.toString() + " method=" + startMethod.methodId.toString() };
            }
            let startArgs = AmqpReader091::new(startMethod.args);
            startArgs.octet(); // version-major (ungeprüft — schon via Protokoll-Header validiert)
            startArgs.octet(); // version-minor
            startArgs.fieldTable(); // server-properties (v1: nicht ausgewertet)
            let mechanisms = startArgs.longstr();
            startArgs.longstr(); // locales (v1: immer en_US angeboten)

            if !mechanisms.contains("PLAIN") {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "Broker bietet SASL-Mechanismus PLAIN nicht an (angeboten: " + mechanisms + ")" };
            }

            // --- connection.start-ok ---
            let w1 = AmqpWriter091::new();
            var clientProps: Map<String, AmqpFieldValue091> = Map::new();
            clientProps.insert("product", AmqpFieldValue091::StrVal("tinox"));
            clientProps.insert("platform", AmqpFieldValue091::StrVal("tinox-amqp091"));
            clientProps.insert("version", AmqpFieldValue091::StrVal("0.1"));
            w1.fieldTable(clientProps);
            w1.shortstr("PLAIN");
            w1.longstrBytes(Amqp091::saslPlainResponse(user, pass));
            w1.shortstr("en_US");
            let startOkPayload = Amqp091::encodeMethodPayload(10, 11, w1.bytes);
            Amqp091::writeFrame(conn, 1, 0, startOkPayload);

            // --- connection.tune ---
            let f2 = Amqp091::readFrame(conn);
            if f2.frameType != 1 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.tune (frameType=" + f2.frameType.toString() + ")" };
            }
            let tuneMethod = Amqp091::decodeMethodPayload(f2.payload);
            if tuneMethod.classId == 10 && tuneMethod.methodId == 50 {
                let msg = Amqp091::describeAndAckClose(conn, 0, tuneMethod, 51);
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "SASL/Handshake fehlgeschlagen: " + msg };
            }
            if tuneMethod.classId != 10 || tuneMethod.methodId != 30 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.tune, bekam class=" + tuneMethod.classId.toString() + " method=" + tuneMethod.methodId.toString() };
            }
            let tuneArgs = AmqpReader091::new(tuneMethod.args);
            let serverChannelMax = tuneArgs.short();
            let serverFrameMax = tuneArgs.long();

            // --- connection.tune-ok ---
            var negotiatedFrameMax: Int64 = 131072;
            if serverFrameMax > 0 {
                negotiatedFrameMax = serverFrameMax;
            }
            let w2 = AmqpWriter091::new();
            w2.short(serverChannelMax);
            w2.long(negotiatedFrameMax);
            w2.short(0); // Heartbeat deaktiviert (v1: kein Heartbeat-Sender)
            let tuneOkPayload = Amqp091::encodeMethodPayload(10, 31, w2.bytes);
            Amqp091::writeFrame(conn, 1, 0, tuneOkPayload);

            // --- connection.open ---
            let w3 = AmqpWriter091::new();
            w3.shortstr(vhost);
            w3.shortstr(""); // reserved-1 (capabilities, deprecated)
            w3.octet(0);     // reserved-2 (insist, deprecated bit)
            let openPayload = Amqp091::encodeMethodPayload(10, 40, w3.bytes);
            Amqp091::writeFrame(conn, 1, 0, openPayload);

            let f3 = Amqp091::readFrame(conn);
            if f3.frameType != 1 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.open-ok (frameType=" + f3.frameType.toString() + ")" };
            }
            let openMethod = Amqp091::decodeMethodPayload(f3.payload);
            if openMethod.classId == 10 && openMethod.methodId == 50 {
                let msg = Amqp091::describeAndAckClose(conn, 0, openMethod, 51);
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "connection.open fehlgeschlagen: " + msg };
            }
            if openMethod.classId != 10 || openMethod.methodId != 41 {
                httpConnClose(conn);
                return AmqpConnection091 { conn: -1, frameMax: 0, channelMax: 0, heartbeat: 0, errorMessage: "erwartete connection.open-ok, bekam class=" + openMethod.classId.toString() + " method=" + openMethod.methodId.toString() };
            }

            return AmqpConnection091 { conn: conn, frameMax: negotiatedFrameMax, channelMax: serverChannelMax, heartbeat: 0, errorMessage: "" };
        }

        /*
         * Schließt die Verbindung spec-konform: connection.close senden
         * und auf close-ok warten (kurzes Timeout-Risiko wird v1 bewusst
         * in Kauf genommen — kein Heartbeat/Timeout-Mechanismus), dann den
         * Socket schließen.
         */
        fn close() -> Nothing
        {
            let w = AmqpWriter091::new();
            w.short(200); // reply-code: normal shutdown (RabbitMQ-Konvention)
            w.shortstr("OK");
            w.short(0); // class-id (kein Bezug)
            w.short(0); // method-id (kein Bezug)
            let closePayload = Amqp091::encodeMethodPayload(10, 50, w.bytes);
            Amqp091::writeFrame(this.conn, 1, 0, closePayload);
            Amqp091::readFrame(this.conn); // erwartet close-ok, v1 ungeprüft
            httpConnClose(this.conn);
        }
    }

    /*
     * Ein geöffneter Channel auf einer AmqpConnection091 (§1.4.2.2). v1:
     * genau ein fester Channel pro Verbindung (Channel-ID 1), kein Pool —
     * s. tasklist.md "Später" für Multi-Channel.
     */
    class AmqpChannel091
    {
        var conn: Int64;
        var chanId: Int64;
        var frameMax: Int64;
        var errorMessage: String;

        fn open(connection: AmqpConnection091) -> AmqpChannel091
        {
            if connection.conn <= 0 {
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "Connection nicht aufgebaut: " + connection.errorMessage };
            }
            let chanId = 1;
            let w = AmqpWriter091::new();
            w.shortstr(""); // reserved-1 (out-of-band, deprecated)
            let openPayload = Amqp091::encodeMethodPayload(20, 10, w.bytes);
            Amqp091::writeFrame(connection.conn, 1, chanId, openPayload);

            let f = Amqp091::readFrame(connection.conn);
            if f.frameType != 1 {
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "channel.open fehlgeschlagen (frameType=" + f.frameType.toString() + ")" };
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                let msg = Amqp091::describeAndAckClose(connection.conn, chanId, mf, 41);
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "channel.open fehlgeschlagen: " + msg };
            }
            if mf.classId != 20 || mf.methodId != 11 {
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "erwartete channel.open-ok, bekam class=" + mf.classId.toString() + " method=" + mf.methodId.toString() };
            }
            return AmqpChannel091 { conn: connection.conn, chanId: chanId, frameMax: connection.frameMax, errorMessage: "" };
        }

        /*
         * `queue.declare` + `-ok`. Liefert den tatsächlichen Queue-Namen
         * (wichtig bei server-generierten Namen, wenn `name` leer ist) oder
         * "" bei Fehler (echte Queue-Namen sind nie leer — `errorMessage`
         * beschreibt dann die Ursache).
         */
        fn declareQueue(name: String, durable: Bool, exclusive: Bool, autoDelete: Bool) -> String
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1 (ticket, deprecated)
            w.shortstr(name);
            var flags: Int64 = 0; // Bit 0 (passive) v1 immer 0
            if durable {
                flags = flags | 2;
            }
            if exclusive {
                flags = flags | 4;
            }
            if autoDelete {
                flags = flags | 8;
            }
            w.octet(flags); // Bit 4 (no-wait) v1 immer 0
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "Queue-Name zu lang (max 255 Byte, shortstr): " + name.len().toString() + " Byte";
                return "";
            }
            let payload = Amqp091::encodeMethodPayload(50, 10, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = Amqp091::readFrame(this.conn);
            if f.frameType != 1 {
                this.errorMessage = "queue.declare fehlgeschlagen (frameType=" + f.frameType.toString() + ")";
                return "";
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return "";
            }
            if mf.classId != 50 || mf.methodId != 11 {
                this.errorMessage = "erwartete queue.declare-ok, bekam class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return "";
            }
            let r = AmqpReader091::new(mf.args);
            return r.shortstr();
        }

        /*
         * `queue.bind` + `-ok`. v1 nutzt nur den Default-Exchange (`""`)
         * ohne `exchange.declare` — Routing-Key = Queue-Name deckt den
         * einfachsten Fall ab (s. tasklist.md "Später" für benannte
         * Exchanges).
         */
        fn bindQueue(queue: String, exchange: String, routingKey: String) -> Bool
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1
            w.shortstr(queue);
            w.shortstr(exchange);
            w.shortstr(routingKey);
            w.octet(0); // no-wait
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "Queue-/Exchange-/Routing-Key-Name zu lang (max 255 Byte, shortstr)";
                return false;
            }
            let payload = Amqp091::encodeMethodPayload(50, 20, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = Amqp091::readFrame(this.conn);
            if f.frameType != 1 {
                this.errorMessage = "queue.bind fehlgeschlagen (frameType=" + f.frameType.toString() + ")";
                return false;
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return false;
            }
            if mf.classId != 50 || mf.methodId != 21 {
                this.errorMessage = "erwartete queue.bind-ok, bekam class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return false;
            }
            return true;
        }

        /*
         * `basic.qos` + `-ok`: Prefetch-Limit vor `consume()` setzen
         * (sinnvoller Default, sonst schickt der Broker beliebig viele
         * unbestätigte Nachrichten auf einmal).
         */
        fn qos(prefetchCount: Int64) -> Bool
        {
            let w = AmqpWriter091::new();
            w.long(0); // prefetch-size: 0 = kein Byte-Limit
            w.short(prefetchCount);
            w.octet(0); // global = false (nur dieser Consumer)
            let payload = Amqp091::encodeMethodPayload(60, 10, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = Amqp091::readFrame(this.conn);
            if f.frameType != 1 {
                this.errorMessage = "basic.qos fehlgeschlagen (frameType=" + f.frameType.toString() + ")";
                return false;
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return false;
            }
            if mf.classId != 60 || mf.methodId != 11 {
                this.errorMessage = "erwartete basic.qos-ok, bekam class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return false;
            }
            return true;
        }

        /*
         * `basic.publish` (kein `-ok`, per Spec asynchron) + Content-Header
         * + Body-Frame(s). v1: genau zwei Properties unterstützt
         * (content-type optional, delivery-mode fest auf 2/persistent) —
         * s. tasklist.md "Später" für den vollen Property-Satz. Body wird
         * bei `frameMax` gesplittet (Frame-Overhead: 7-Byte-Header +
         * 1-Byte-Terminator = 8 Byte Sicherheitsabzug).
         */
        fn publish(exchange: String, routingKey: String, body: List<Int64>, contentType: String) -> Nothing
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1
            w.shortstr(exchange);
            w.shortstr(routingKey);
            w.octet(0); // mandatory=false, immediate=false
            if w.hasError() {
                this.errorMessage = "Exchange-/Routing-Key-Name zu lang (max 255 Byte, shortstr) -- basic.publish NICHT gesendet";
                return;
            }

            var flags: Int64 = 0;
            let pw = AmqpWriter091::new();
            if contentType.len() > 0 {
                flags = flags | 32768; // Bit 15: content-type
                pw.shortstr(contentType);
            }
            flags = flags | 4096; // Bit 12: delivery-mode
            pw.octet(2); // persistent
            if pw.hasError() {
                this.errorMessage = "Content-Type zu lang (max 255 Byte, shortstr) -- basic.publish NICHT gesendet";
                return;
            }

            let payload = Amqp091::encodeMethodPayload(60, 40, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let hw = AmqpWriter091::new();
            hw.short(60); // class-id
            hw.short(0);  // weight (ungenutzt)
            hw.longlong(body.len());
            hw.short(flags);
            hw.rawBytes(pw.bytes);
            Amqp091::writeFrame(this.conn, 2, this.chanId, hw.bytes);

            var frameOverhead: Int64 = 8;
            var chunkSize: Int64 = this.frameMax - frameOverhead;
            if chunkSize <= 0 {
                chunkSize = 4096;
            }
            var offset: Int64 = 0;
            let n = body.len();
            while offset < n {
                var end: Int64 = offset + chunkSize;
                if end > n {
                    end = n;
                }
                var chunk: List<Int64> = [];
                for i in offset..end {
                    chunk.push(body[i]);
                }
                Amqp091::writeFrame(this.conn, 3, this.chanId, chunk);
                offset = end;
            }
        }

        /*
         * `basic.consume` + `-ok`: registriert den Client als Consumer.
         * Liefert den (ggf. server-generierten) Consumer-Tag oder "" bei
         * Fehler. Danach pusht der Broker Nachrichten asynchron —
         * abholen über `nextMessage()` (blockierender Pull, kein
         * Lambda-Handler in v1, s. tasklist.md).
         */
        fn consume(queue: String) -> String
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1
            w.shortstr(queue);
            w.shortstr(""); // consumer-tag: server-generiert
            w.octet(0); // no-local=false, no-ack=false, exclusive=false, no-wait=false
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "Queue-Name zu lang (max 255 Byte, shortstr): " + queue.len().toString() + " Byte";
                return "";
            }
            let payload = Amqp091::encodeMethodPayload(60, 20, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = Amqp091::readFrame(this.conn);
            if f.frameType != 1 {
                this.errorMessage = "basic.consume fehlgeschlagen (frameType=" + f.frameType.toString() + ")";
                return "";
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return "";
            }
            if mf.classId != 60 || mf.methodId != 21 {
                this.errorMessage = "erwartete basic.consume-ok, bekam class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return "";
            }
            let r = AmqpReader091::new(mf.args);
            return r.shortstr();
        }

        /*
         * Blockierender Pull: liest genau EINE komplette Nachricht
         * (`basic.deliver`-Methode + Content-Header + Body-Frame(s), bis
         * `body-size` Bytes gelesen sind — analog zu `Ws::readMessage`).
         * `AmqpMessage091.ok == false` bei jedem Fehler (Aufrufer MUSS
         * prüfen), `errorMessage` beschreibt die Ursache.
         *
         * v1 dekodiert aus dem Content-Header nur `content-type` und
         * überspringt alle anderen 13 Basic-Properties korrekt anhand
         * ihres Bits (sonst würde der Byte-Cursor bei einer Nachricht mit
         * z. B. `headers` oder `correlation-id` aus der Spur laufen) —
         * s. tasklist.md "Später" für den vollen Property-Satz.
         */
        fn nextMessage() -> AmqpMessage091
        {
            let f1 = Amqp091::readFrame(this.conn);
            if f1.frameType != 1 {
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "erwartete basic.deliver (frameType=" + f1.frameType.toString() + ")" };
            }
            let mf = Amqp091::decodeMethodPayload(f1.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                let msg = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: msg };
            }
            if mf.classId != 60 || mf.methodId != 60 {
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "erwartete basic.deliver, bekam class=" + mf.classId.toString() + " method=" + mf.methodId.toString() };
            }
            let r = AmqpReader091::new(mf.args);
            r.shortstr(); // consumer-tag (v1 ungenutzt)
            let deliveryTag = r.longlong();
            r.octet(); // redelivered (eigenes Bit-Byte)
            let exchange = r.shortstr();
            let routingKey = r.shortstr();

            let f2 = Amqp091::readFrame(this.conn);
            if f2.frameType != 2 {
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "erwartete Content-Header-Frame (frameType=" + f2.frameType.toString() + ")" };
            }
            let hr = AmqpReader091::new(f2.payload);
            hr.short(); // class-id (60, ungeprüft)
            hr.short(); // weight (ungenutzt)
            let bodySize = hr.longlong();
            let flags = hr.short();
            var contentType: String = "";
            if (flags & 32768) != 0 {
                contentType = hr.shortstr();
            }
            if (flags & 16384) != 0 { hr.longstr(); }      // content-encoding
            if (flags & 8192) != 0 { hr.fieldTable(); }    // headers
            if (flags & 4096) != 0 { hr.octet(); }         // delivery-mode
            if (flags & 2048) != 0 { hr.octet(); }         // priority
            if (flags & 1024) != 0 { hr.shortstr(); }      // correlation-id
            if (flags & 512) != 0 { hr.shortstr(); }       // reply-to
            if (flags & 256) != 0 { hr.shortstr(); }       // expiration
            if (flags & 128) != 0 { hr.shortstr(); }       // message-id
            if (flags & 64) != 0 { hr.longlong(); }        // timestamp
            if (flags & 32) != 0 { hr.shortstr(); }        // type
            if (flags & 16) != 0 { hr.shortstr(); }        // user-id
            if (flags & 8) != 0 { hr.shortstr(); }         // app-id
            if (flags & 4) != 0 { hr.shortstr(); }         // cluster-id

            var body: List<Int64> = [];
            while body.len() < bodySize {
                let f3 = Amqp091::readFrame(this.conn);
                if f3.frameType != 3 {
                    return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "erwartete Body-Frame (frameType=" + f3.frameType.toString() + ")" };
                }
                for i in 0..f3.payload.len() {
                    body.push(f3.payload[i]);
                }
            }

            return AmqpMessage091 { deliveryTag: deliveryTag, exchange: exchange, routingKey: routingKey, contentType: contentType, body: body, ok: true, errorMessage: "" };
        }

        /* `basic.ack` (kein `-ok`, per Spec asynchron). */
        fn ack(deliveryTag: Int64) -> Nothing
        {
            let w = AmqpWriter091::new();
            w.longlong(deliveryTag);
            w.octet(0); // multiple = false
            let payload = Amqp091::encodeMethodPayload(60, 80, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);
        }
    }

    /*
     * Eine per `nextMessage()` empfangene Nachricht. `ok == false` bei
     * jedem Fehler (Aufrufer MUSS prüfen, kein Silent-Garbage) —
     * `errorMessage` beschreibt dann die Ursache.
     */
    class AmqpMessage091
    {
        var deliveryTag: Int64;
        var exchange: String;
        var routingKey: String;
        var contentType: String;
        var body: List<Int64>;
        var ok: Bool;
        var errorMessage: String;
    }
}
