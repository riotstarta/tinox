module tinox.core.oauth2;

import tinox.core.http;
import tinox.core.uri;
import tinox.core.crypto;
import tinox.core.base64;
import tinox.core.hex;
import tinox.core.json;

namespace tinox.core.oauth2
{
    /*
     * OAuth2-Client für den Authorization Code Grant mit PKCE (RFC 6749 +
     * RFC 7636, issue #131) — der empfohlene Standard-Flow für sowohl
     * Server- als auch Public-Clients. `authorizeUrl`/`tokenUrl` sind die
     * beiden Provider-Endpunkte (z. B. Google:
     * "https://accounts.google.com/o/oauth2/v2/auth" /
     * "https://oauth2.googleapis.com/token"), `redirectUri` die beim
     * Provider registrierte Callback-URL dieser Anwendung.
     *
     * Ablauf:
     *   1. buildAuthorizeUrl(scope) -> Aufrufer leitet den User-Agent zu
     *      .url weiter, speichert .state + .codeVerifier session-seitig
     *      (s. OAuth2AuthorizeRequest).
     *   2. Callback-Handler: .state gegen den gespeicherten Wert prüfen
     *      (CSRF), dann exchangeCode(code, codeVerifier) mit dem
     *      gespeicherten codeVerifier aufrufen.
     *   3. Bei Bedarf später refresh(refreshToken).
     *
     * Bewusste v1-Lücken (s. issue #131 für die volle Begründung):
     *   - Kein OIDC-ID-Token-Verifizieren (bräuchte RS256/JWKS in Jwt,
     *     UND Jwt selbst hat noch ein eigenes Wire-Format-Problem,
     *     s. issue #137 — beides eigene, größere Folge-Arbeit).
     *   - Nur Authorization Code + PKCE, kein client_credentials/
     *     implicit/device_code.
     *   - Kein Token-Storage/Session-Integration — Aufrufer-Sache, wie
     *     beim Rest des rest/http_server-Frameworks.
     */
    class OAuth2Client
    {
        var authorizeUrl: String;
        var tokenUrl: String;
        var clientId: String;
        var clientSecret: String;
        var redirectUri: String;

        fn new(authorizeUrl: String, tokenUrl: String, clientId: String, clientSecret: String, redirectUri: String) -> OAuth2Client
        {
            return OAuth2Client { authorizeUrl: authorizeUrl, tokenUrl: tokenUrl, clientId: clientId, clientSecret: clientSecret, redirectUri: redirectUri };
        }

        /*
         * Baut die Authorization-URL + generiert `state` (CSRF) und den
         * PKCE `code_verifier` (RFC 7636 §4.1: 32 kryptografisch sichere
         * Zufallsbytes, base64url-kodiert -> 43 Zeichen, erfüllt die
         * geforderten 43-128 Zeichen aus dem erlaubten Alphabet).
         * `code_challenge` ist SHA-256 des Verifiers, ebenfalls
         * base64url — S256-Methode (RFC 7636 §4.2), nicht das unsichere
         * "plain".
         */
        fn buildAuthorizeUrl(scope: String) -> OAuth2AuthorizeRequest
        {
            let stateBytes: List<Int64> = Crypto::secureRandomBytes(32);
            let state: String = Base64::encodeUrlBytes(stateBytes);

            let verifierBytes: List<Int64> = Crypto::secureRandomBytes(32);
            let codeVerifier: String = Base64::encodeUrlBytes(verifierBytes);

            // Crypto::sha256 liefert Hex-Text (kein Roh-Bytes-Primitiv in
            // Crypto, s. issue #137); Hex::decodeBytes holt die rohen 32
            // Digest-Bytes sicher zurück (kein String-basierter Umweg über
            // fromCharCode, der bei einem eingebetteten 0-Byte im Digest
            // stillschweigend abgeschnitten hätte).
            let challengeHex: String = Crypto::sha256(codeVerifier);
            let challengeBytes: List<Int64> = Hex::decodeBytes(challengeHex);
            let codeChallenge: String = Base64::encodeUrlBytes(challengeBytes);

            var url: String = this.authorizeUrl;
            if url.contains("?")
            {
                url = url + "&";
            }
            else
            {
                url = url + "?";
            }
            url = url + "response_type=code";
            url = url + "&client_id=" + Uri::encodeComponent(this.clientId);
            url = url + "&redirect_uri=" + Uri::encodeComponent(this.redirectUri);
            url = url + "&scope=" + Uri::encodeComponent(scope);
            url = url + "&state=" + Uri::encodeComponent(state);
            url = url + "&code_challenge=" + Uri::encodeComponent(codeChallenge);
            url = url + "&code_challenge_method=S256";

            return OAuth2AuthorizeRequest { url: url, state: state, codeVerifier: codeVerifier };
        }

        /*
         * Tauscht den Authorization Code gegen Access-/Refresh-Token
         * (RFC 6749 §4.1.3). `codeVerifier` MUSS der von
         * buildAuthorizeUrl() zurückgegebene und vom Aufrufer
         * gespeicherte Wert sein — der Server prüft ihn gegen den
         * `code_challenge`, den er beim Authorize-Request gesehen hat
         * (PKCE-Kernmechanismus: nur wer den ursprünglichen Verifier
         * kennt, kann den Code einlösen).
         */
        fn exchangeCode(code: String, codeVerifier: String) -> OAuth2TokenResponse
        {
            var body: String = "grant_type=authorization_code";
            body = body + "&code=" + Uri::encodeComponent(code);
            body = body + "&redirect_uri=" + Uri::encodeComponent(this.redirectUri);
            body = body + "&client_id=" + Uri::encodeComponent(this.clientId);
            body = body + "&client_secret=" + Uri::encodeComponent(this.clientSecret);
            body = body + "&code_verifier=" + Uri::encodeComponent(codeVerifier);
            return OAuth2Client::postToken(this.tokenUrl, body);
        }

        /* Tauscht einen Refresh-Token gegen ein frisches Token-Paar (RFC 6749 §6). */
        fn refresh(refreshToken: String) -> OAuth2TokenResponse
        {
            var body: String = "grant_type=refresh_token";
            body = body + "&refresh_token=" + Uri::encodeComponent(refreshToken);
            body = body + "&client_id=" + Uri::encodeComponent(this.clientId);
            body = body + "&client_secret=" + Uri::encodeComponent(this.clientSecret);
            return OAuth2Client::postToken(this.tokenUrl, body);
        }

        /*
         * Gemeinsamer POST-Kern für exchangeCode()/refresh(): sendet
         * `application/x-www-form-urlencoded` (RFC 6749 §4.1.3 verlangt
         * genau das, nicht JSON) und parst die JSON-Antwort. `ok == false`
         * bei jedem Fehler — Netzwerk-/TLS-Fehler (Http liefert dann
         * statusCode()==0, s. issue #131s TLS-Arbeit an Http.tnx),
         * HTTP-Fehlerstatus, RFC-6749-§5.2-Fehlerantwort
         * (`error`/`error_description`), oder eine 2xx-Antwort ohne
         * `access_token`-Feld werden alle hart als Fehler gemeldet statt
         * ein leeres/falsches Token still durchzureichen.
         */
        fn postToken(url: String, body: String) -> OAuth2TokenResponse
        {
            Http::clearHeaders();
            Http::setHeader("Content-Type", "application/x-www-form-urlencoded");
            Http::setHeader("Accept", "application/json");
            let resp = Http::post(url, body);
            Http::clearHeaders();

            if resp.statusCode() == 0
            {
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, ok: false, errorMessage: "network error contacting token endpoint (connection failed or TLS/certificate error)" };
            }

            let fields: Map<String, JsonValue> = Json::parse(resp.body()).asTable();

            if fields.contains("error")
            {
                var msg: String = fields["error"].getString();
                if fields.contains("error_description")
                {
                    msg = msg + ": " + fields["error_description"].getString();
                }
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, ok: false, errorMessage: msg };
            }

            if resp.statusCode() < 200 || resp.statusCode() >= 300
            {
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, ok: false, errorMessage: "token endpoint returned HTTP " + resp.statusCode().toString() };
            }

            if !fields.contains("access_token")
            {
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, ok: false, errorMessage: "token endpoint response has no access_token field" };
            }

            var refreshTok: String = "";
            if fields.contains("refresh_token")
            {
                refreshTok = fields["refresh_token"].getString();
            }
            var tokType: String = "Bearer";
            if fields.contains("token_type")
            {
                tokType = fields["token_type"].getString();
            }
            var expIn: Int64 = 0;
            if fields.contains("expires_in")
            {
                expIn = fields["expires_in"].asInt();
            }

            return OAuth2TokenResponse { accessToken: fields["access_token"].getString(), refreshToken: refreshTok, tokenType: tokType, expiresIn: expIn, ok: true, errorMessage: "" };
        }
    }
}
