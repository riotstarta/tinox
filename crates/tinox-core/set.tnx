module tinox.core.set;

namespace tinox.core.set
{
    class Set<T>
    {
        fnc new() -> Set<T>
        {
            return Set<T> { items: [] };
        }

        fnc add(set: Set<T>, item: T) -> Unit
        {
            if Set::contains(set, item) == false
            {
                set.items.push(item);
            }
        }

        fnc remove(set: Set<T>, item: T) -> Bool
        {
            var i: Int64 = 0;
            while i < set.items.len()
            {
                if set.items[i] == item
                {
                    set.items.removeAt(i);
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        fnc contains(set: Set<T>, item: T) -> Bool
        {
            var i: Int64 = 0;
            while i < set.items.len()
            {
                if set.items[i] == item
                {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        fnc size(set: Set<T>) -> Int64
        {
            return set.items.len();
        }

        fnc isEmpty(set: Set<T>) -> Bool
        {
            return set.items.len() == 0;
        }

        fnc union(a: Set<T>, b: Set<T>) -> Set<T>
        {
            let result: Set<T> = Set::new();
            var i: Int64 = 0;
            while i < a.items.len()
            {
                Set::add(result, a.items[i]);
                i = i + 1;
            }
            i = 0;
            while i < b.items.len()
            {
                Set::add(result, b.items[i]);
                i = i + 1;
            }
            return result;
        }

        fnc intersection(a: Set<T>, b: Set<T>) -> Set<T>
        {
            let result: Set<T> = Set::new();
            var i: Int64 = 0;
            while i < a.items.len()
            {
                if Set::contains(b, a.items[i])
                {
                    Set::add(result, a.items[i]);
                }
                i = i + 1;
            }
            return result;
        }

        fnc difference(a: Set<T>, b: Set<T>) -> Set<T>
        {
            let result: Set<T> = Set::new();
            var i: Int64 = 0;
            while i < a.items.len()
            {
                if Set::contains(b, a.items[i]) == false
                {
                    Set::add(result, a.items[i]);
                }
                i = i + 1;
            }
            return result;
        }

        fnc isSubsetOf(a: Set<T>, b: Set<T>) -> Bool
        {
            var i: Int64 = 0;
            while i < a.items.len()
            {
                if Set::contains(b, a.items[i]) == false
                {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
    }
}