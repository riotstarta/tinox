namespace math {
    class Math {
        fnc pi() -> Float64 { return 3.14159; }
        fnc abs(n: Int64) -> Int64 { if n < 0 { return -n; } return n; }
        fnc min(a: Int64, b: Int64) -> Int64 { if a < b { return a; } return b; }
        fnc max(a: Int64, b: Int64) -> Int64 { if a > b { return a; } return b; }
    }
}

namespace array {
    class Arrays {
        fnc sum(arr: List<Int64>) -> Int64 { return 0; }
    }
}

fn main() -> Int64
{
    print("Math.pi(): ");
    println(Math.pi());
    print("Math.abs(-5): ");
    println(Math.abs(-5));
    print("Math.min(3, 7): ");
    println(Math.min(3, 7));
    print("Math.max(3, 7): ");
    println(Math.max(3, 7));
    return 0;
}
