module tinox.core.env;

namespace tinox.core.env
{
    class Env
    {
        fnc getVar(name: String) -> String
        {
            return envGet(name);
        }

        fnc setVar(name: String, value: String) -> Unit
        {
            envSet(name, value);
        }

        fnc removeVar(name: String) -> Unit
        {
            envRemove(name);
        }

        fnc currentDir() -> String
        {
            return envCurrentDir();
        }

        fnc setCurrentDir(path: String) -> Unit
        {
            envSetCurrentDir(path);
        }
    }
}