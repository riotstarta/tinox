module tinox.core.regex;

namespace tinox.core.regex
{
    class Regex
    {
        fnc isMatch(pattern: String, text: String) -> Bool
        {
            return regexIsMatch(pattern, text);
        }

        fnc findFirst(pattern: String, text: String) -> String
        {
            return regexFindFirst(pattern, text);
        }

        fnc findAll(pattern: String, text: String) -> List<String>
        {
            return regexFindAll(pattern, text);
        }

        fnc replaceAll(pattern: String, text: String, replacement: String) -> String
        {
            return regexReplaceAll(pattern, text, replacement);
        }

        fnc split(pattern: String, text: String) -> List<String>
        {
            return regexSplit(pattern, text);
        }
    }
}