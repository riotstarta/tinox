module tinox.core.fs;

namespace tinox.core.fs
{
    class Fs
    {
        fn readFile(path: String) -> String
        {
            return fileReadAllText(path);
        }

        fn writeFile(path: String, content: String) -> Unit
        {
            fileWriteAllText(path, content);
        }

        fn appendFile(path: String, content: String) -> Unit
        {
            let existing: String = Fs::readFile(path);
            Fs::writeFile(path, existing + content);
        }

        fn deleteFile(path: String) -> Unit
        {
            fileDelete(path);
        }

        fn copyFile(src: String, dest: String) -> Unit
        {
            let content: String = Fs::readFile(src);
            Fs::writeFile(dest, content);
        }

        fn moveFile(src: String, dest: String) -> Unit
        {
            Fs::copyFile(src, dest);
            Fs::deleteFile(src);
        }

        fn listDirectory(path: String) -> List<String>
        {
            return dirList(path);
        }

        fn createDirectory(path: String) -> Unit
        {
            dirCreate(path);
        }

        fn deleteDirectory(path: String) -> Unit
        {
            dirDelete(path);
        }
    }
}