module tinox.core.json;

namespace tinox.core.json
{
    // ========================================================================
    // Serialization Annotations
    // ========================================================================

    /**
     * Marks a class for automatic JSON serialization and deserialization.
     * The compiler generates toJson() and fromJson(JsonValue) methods.
     *
     * Usage:
     *   @JsonSerializable
     *   class User
     *   {
     *       var id: Int64;
     *       var name: String;
     *   }
     *
     *   let json: String = Json::serialize(user);
     *   let user: User = Json::deserialize<User>(json);
     */
    @annotation
    class JsonSerializable {}

    /**
     * Overrides the JSON field name for a class field.
     * Without this annotation, the field's Tinox name is used as-is.
     *
     * Usage:
     *   @JsonField("first_name")
     *   var firstName: String;
     */
    @annotation
    class JsonField
    {
        var name: String;

        fn new(name: String) -> JsonField
        {
            return JsonField { name: name };
        }
    }

    // ========================================================================
    // JSON Runtime
    // ========================================================================

    extern fn jsonParse(text: String) -> JsonValue;
    extern fn jsonStringify(value: JsonValue) -> String;
    extern fn jsonGetString(value: JsonValue) -> String;
    extern fn jsonGetInt(value: JsonValue) -> Int64;
    extern fn jsonGetFloat(value: JsonValue) -> Float64;
    extern fn jsonGetBool(value: JsonValue) -> Bool;
    extern fn jsonIsNull(value: JsonValue) -> Bool;
    extern fn jsonIsString(value: JsonValue) -> Bool;
    extern fn jsonIsInt(value: JsonValue) -> Bool;
    extern fn jsonIsFloat(value: JsonValue) -> Bool;
    extern fn jsonIsBool(value: JsonValue) -> Bool;
    extern fn jsonIsObject(value: JsonValue) -> Bool;
    extern fn jsonIsArray(value: JsonValue) -> Bool;
    extern fn jsonGetField(obj: JsonValue, key: String) -> JsonValue;
    extern fn jsonIntArrayFromJson(arr: JsonValue) -> List<Int64>;
    extern fn jsonIntArrayToString(arr: List<Int64>) -> String;
    extern fn jsonIntArrayWrap(key: String, arr: List<Int64>) -> String;

    class Json
    {
        fnc parse(text: String) -> JsonValue
        {
            return jsonParse(text);
        }

        fnc stringify(value: JsonValue) -> String
        {
            return jsonStringify(value);
        }

        fnc getField(obj: JsonValue, key: String) -> JsonValue
        {
            return jsonGetField(obj, key);
        }

        fnc intArrayFromJson(arr: JsonValue) -> List<Int64>
        {
            return jsonIntArrayFromJson(arr);
        }

        fnc intArrayToString(arr: List<Int64>) -> String
        {
            return jsonIntArrayToString(arr);
        }

        fnc intArrayWrap(key: String, arr: List<Int64>) -> String
        {
            return jsonIntArrayWrap(key, arr);
        }

        fnc serialize<T>(obj: T) -> String
        {
            return obj.toJson();
        }

        fnc deserialize<T>(text: String) -> T
        {
            let value: JsonValue = jsonParse(text);
            return T::fromJson(value);
        }
    }

    class JsonValue
    {
        fn getString() -> String
        {
            return jsonGetString(this);
        }

        fn getInt() -> Int64
        {
            return jsonGetInt(this);
        }

        fn getFloat() -> Float64
        {
            return jsonGetFloat(this);
        }

        fn getBool() -> Bool
        {
            return jsonGetBool(this);
        }

        fn isNull() -> Bool
        {
            return jsonIsNull(this);
        }

        fn isString() -> Bool
        {
            return jsonIsString(this);
        }

        fn isInt() -> Bool
        {
            return jsonIsInt(this);
        }

        fn isFloat() -> Bool
        {
            return jsonIsFloat(this);
        }

        fn isBool() -> Bool
        {
            return jsonIsBool(this);
        }

        fn isObject() -> Bool
        {
            return jsonIsObject(this);
        }

        fn isArray() -> Bool
        {
            return jsonIsArray(this);
        }

        fn getField(key: String) -> JsonValue
        {
            return jsonGetField(this, key);
        }
    }
}
