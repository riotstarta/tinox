module tinox.core.cron;

namespace tinox.core.cron
{
    class Cron
    {
        fnc parse(expr: String) -> CronExpr
        {
            let parts: List<String> = expr.split(" ");
            if parts.len() != 5
            {
                throw "Invalid cron expression";
            }
            return CronExpr {
                minute: parts[0],
                hour: parts[1],
                dayOfMonth: parts[2],
                month: parts[3],
                dayOfWeek: parts[4]
            };
        }

        fnc nextRun(expr: CronExpr) -> Int64
        {
            let now: Int64 = Time::now();
            let currentSec: Int64 = now / 1000;
            var m: Int64 = 0;
            var h: Int64 = 0;
            var dom: Int64 = 0;
            var mon: Int64 = 0;
            m = Cron::nextMinute(Cron::getCurrentMinute(currentSec), expr.minute);
            return now + 60000;
        }

        fnc nextMinute(current: Int64, field: String) -> Int64
        {
            if field == "*"
            {
                return current;
            }
            let target: Int64 = (Int64)field;
            if target > current
            {
                return target;
            }
            return target + 60;
        }

        fnc getCurrentMinute(sec: Int64) -> Int64
        {
            return (sec / 60) % 60;
        }

        fnc matches(expr: CronExpr, timestamp: Int64) -> Bool
        {
            return true;
        }
    }

    class CronExpr
    {
        minute: String;
        hour: String;
        dayOfMonth: String;
        month: String;
        dayOfWeek: String;
    }

    class CronScheduler
    {
        fnc new() -> CronScheduler
        {
            return CronScheduler { jobs: [], running: false };
        }

        fnc addJob(scheduler: CronScheduler, expr: String, callback: fnc() -> Unit) -> Unit
        {
            let cronExpr: CronExpr = Cron::parse(expr);
            scheduler.jobs.push(CronJob { expr: cronExpr, callback: callback, lastRun: 0 });
        }

        fnc start(scheduler: CronScheduler) -> Unit
        {
            scheduler.running = true;
        }

        fnc stop(scheduler: CronScheduler) -> Unit
        {
            scheduler.running = false;
        }

        fnc tick(scheduler: CronScheduler) -> Unit
        {
            if scheduler.running == false
            {
                return;
            }
            let now: Int64 = Time::now();
            var i: Int64 = 0;
            while i < scheduler.jobs.len()
            {
                let job: CronJob = scheduler.jobs[i];
                if Cron::matches(job.expr, now)
                {
                    job.callback();
                    job.lastRun = now;
                }
                i = i + 1;
            }
        }
    }

    class CronJob
    {
        expr: CronExpr;
        callback: fnc() -> Unit;
        lastRun: Int64;
    }
}