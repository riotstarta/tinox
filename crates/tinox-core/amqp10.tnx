module tinox.core.amqp10;

/*
 * AMQP-1.0-Client (kein Broker), Phase 1 (tasklist.md): Transport-Dial +
 * Protokoll-Header-Handshake. Kein gemeinsamer Code mit amqp091.tnx außer
 * demselben Grundmuster (Conn-Handle-Dial über socketCreateTcp/
 * socketConnect/httpConnFromFd, binärsicheres Lesen/Schreiben über
 * httpConnReadN/httpConnWriteBytes) — AMQP 1.0 ist protokoll- und
 * datenmodell-technisch ein eigenes Tier (generisches Typsystem statt
 * fester Feld-Tags, Connection→Session→Link statt Connection→Channel).
 * Details s. tasklist.md Sondierung (2026-07-24, gegen die OASIS-Spec
 * verifiziert, nicht aus Erinnerung übernommen).
 */

import tinox.core.socket;

namespace tinox.core.amqp10
{
    /*
     * Ein generischer AMQP-1.0-Wert (Phase 2, tasklist.md). Anders als
     * 0-9-1s AmqpFieldValue091 (nur für Field-Table-Einträge) wird dieser
     * Typ für ALLES genutzt: Performative-Felder, Message-Sections, sogar
     * die Performative-Hülle selbst (Phase 3) — AMQP 1.0 hat EIN Typsystem
     * für den gesamten Frame-Body statt getrennter Method-Argument- und
     * Field-Table-Kodierungen.
     *
     * Bewusste v1-Lücken (Formatcodes werden vom Reader erkannt und mit
     * korrektem Byte-Skip verarbeitet, aber der Wert selbst kommt als
     * ErrorVal zurück statt echt dekodiert zu werden — kein Silent-Garbage,
     * der Cursor bleibt trotzdem synchron für nachfolgende Felder):
     * `float`/`double` (IEEE-754-Bit-Konvertierung bräuchte einen
     * Bitcast-Primitive, den es in der Runtime nicht gibt, und die
     * Kern-Performatives nutzen laut Spec nirgends float/double — nur
     * Message-Bodies könnten das theoretisch tun), `decimal32/64/128`
     * (praktisch nie genutzt, noch exotischer als float/double).
     *
     * MapVal ist eine FLACHE Liste (key0, val0, key1, val1, ...) statt
     * eines Tinox-Map<K,V> — AMQP-1.0-Map-Keys sind beliebige Werte, kein
     * einheitlicher K-Typ wie bei 0-9-1s immer-String-Keys.
     */
    enum Amqp10Value
    {
        NullVal;
        BoolVal(Bool);
        UByteVal(Int64);
        UShortVal(Int64);
        UIntVal(Int64);
        ULongVal(Int64);
        ByteVal(Int64);
        ShortVal(Int64);
        IntVal(Int64);
        LongVal(Int64);
        CharVal(Int64);       // UTF-32-Codepoint, roh (kein Tinox-String)
        TimestampVal(Int64);  // ms seit Unix-Epoch
        UuidVal(List<Int64>); // exakt 16 rohe Bytes
        BinaryVal(List<Int64>);
        StrVal(String);
        SymbolVal(String);
        ListVal(List<Amqp10Value>);
        MapVal(List<Amqp10Value>);      // flach: key,val,key,val,...
        DescribedVal(Amqp10Described);  // Performatives/SASL-Frames/Sections
        ErrorVal(String);
    }

    /*
     * Ein Described-Type-Wert (§1.2 des Typsystems): Formatcode 0x00 +
     * Descriptor + Wert. v1 beschränkt den Descriptor auf Int64 (numerisch,
     * als smallulong kodiert) — deckt alle 9 Performatives, die 5
     * SASL-Frame-Typen und die 9 Message-Section-Typen ab (alle nutzen
     * numerische ulong-Descriptoren laut Spec, s. tasklist.md-Sondierung);
     * symbol-Descriptoren (die andere von der Spec erlaubte Form) kommen
     * im AMQP-Kernprotokoll nicht vor.
     */
    class Amqp10Described
    {
        var descriptor: Int64;
        var value: Amqp10Value;
    }

    /*
     * Byte-Builder für die AMQP-1.0-Typsystem-Kodierung (Big-Endian).
     * Schreibt IMMER die volle Breite (kein smalluint/uint0/etc.-Picking —
     * das ist nur eine optionale Größenoptimierung, kein Korrektheits-
     * erfordernis) UND bei variabler Breite (Binary/String/Symbol/List/Map)
     * IMMER die 32-Bit-Form — anders als 0-9-1s shortstr/longstr-Zwei-
     * Methoden-Unterscheidung gibt es hier keinen Größen-Cutover-Zweig und
     * keine künstliche 255-Byte-Fehlergrenze: die 32-Bit-Form ist für JEDE
     * Länge spec-konform, kostet nur ein paar Bytes mehr bei kleinen
     * Werten. Der Reader MUSS trotzdem alle Kurzformen lesen können, weil
     * der Broker sie nutzen darf (asymmetrisch wie bei 0-9-1).
     */
    class Amqp10Writer
    {
        var bytes: List<Int64>;

        fn new() -> Amqp10Writer
        {
            return Amqp10Writer { bytes: [] };
        }

        fn pushU8(v: Int64) -> Nothing
        {
            this.bytes.push(v & 0xFF);
        }

        fn pushU16(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn pushU32(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 24) & 0xFF);
            this.bytes.push((v >> 16) & 0xFF);
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn pushU64(v: Int64) -> Nothing
        {
            var shift: Int64 = 56;
            while shift >= 0 {
                this.bytes.push((v >> shift) & 0xFF);
                shift = shift - 8;
            }
        }

        fn pushRawStr(s: String) -> Nothing
        {
            for i in 0..s.len() {
                this.bytes.push(s.charCodeAt(i) & 0xFF);
            }
        }

        fn pushRawBytes(data: List<Int64>) -> Nothing
        {
            for i in 0..data.len() {
                this.bytes.push(data[i] & 0xFF);
            }
        }

        fn writeNull() -> Nothing
        {
            this.pushU8(0x40);
        }

        fn writeBoolean(v: Bool) -> Nothing
        {
            this.pushU8(0x56);
            if v {
                this.pushU8(1);
            } else {
                this.pushU8(0);
            }
        }

        fn writeUbyte(v: Int64) -> Nothing
        {
            this.pushU8(0x50);
            this.pushU8(v);
        }

        fn writeUshort(v: Int64) -> Nothing
        {
            this.pushU8(0x60);
            this.pushU16(v);
        }

        fn writeUint(v: Int64) -> Nothing
        {
            this.pushU8(0x70);
            this.pushU32(v);
        }

        fn writeUlong(v: Int64) -> Nothing
        {
            this.pushU8(0x80);
            this.pushU64(v);
        }

        fn writeByte(v: Int64) -> Nothing
        {
            this.pushU8(0x51);
            this.pushU8(v);
        }

        fn writeShort(v: Int64) -> Nothing
        {
            this.pushU8(0x61);
            this.pushU16(v);
        }

        fn writeInt(v: Int64) -> Nothing
        {
            this.pushU8(0x71);
            this.pushU32(v);
        }

        fn writeLong(v: Int64) -> Nothing
        {
            this.pushU8(0x81);
            this.pushU64(v);
        }

        fn writeChar(v: Int64) -> Nothing
        {
            this.pushU8(0x73);
            this.pushU32(v);
        }

        fn writeTimestamp(v: Int64) -> Nothing
        {
            this.pushU8(0x83);
            this.pushU64(v);
        }

        /* `bytes` muss exakt 16 Elemente haben (Aufrufer-Verantwortung,
         * analog zu 0-9-1s ungeprüften Bounds-Annahmen bei Frame-Payloads). */
        fn writeUuid(uuidBytes: List<Int64>) -> Nothing
        {
            this.pushU8(0x98);
            this.pushRawBytes(uuidBytes);
        }

        fn writeBinary(data: List<Int64>) -> Nothing
        {
            this.pushU8(0xb0);
            this.pushU32(data.len());
            this.pushRawBytes(data);
        }

        fn writeString(s: String) -> Nothing
        {
            this.pushU8(0xb1);
            this.pushU32(s.len());
            this.pushRawStr(s);
        }

        fn writeSymbol(s: String) -> Nothing
        {
            this.pushU8(0xb3);
            this.pushU32(s.len());
            this.pushRawStr(s);
        }

        fn writeList(items: List<Amqp10Value>) -> Nothing
        {
            let inner = Amqp10Writer::new();
            for i in 0..items.len() {
                inner.writeValue(items[i]);
            }
            this.pushU8(0xd0);
            this.pushU32(4 + inner.bytes.len());
            this.pushU32(items.len());
            this.pushRawBytes(inner.bytes);
        }

        /* `pairs` ist flach (key0, val0, key1, val1, ...) — MUSS eine
         * gerade Anzahl Elemente haben (Aufrufer-Verantwortung). */
        fn writeMap(pairs: List<Amqp10Value>) -> Nothing
        {
            let inner = Amqp10Writer::new();
            for i in 0..pairs.len() {
                inner.writeValue(pairs[i]);
            }
            this.pushU8(0xd1);
            this.pushU32(4 + inner.bytes.len());
            this.pushU32(pairs.len());
            this.pushRawBytes(inner.bytes);
        }

        /* Descriptor immer als smallulong (0x53 + 1 Byte) — alle in v1
         * genutzten Descriptor-Codes sind < 256 (Performatives 0x10-0x18,
         * SASL 0x40-0x44, Sections 0x70-0x78), s. Amqp10Described. */
        fn writeDescribed(d: Amqp10Described) -> Nothing
        {
            this.pushU8(0x00);
            this.pushU8(0x53);
            this.pushU8(d.descriptor);
            this.writeValue(d.value);
        }

        fn writeValue(v: Amqp10Value) -> Nothing
        {
            match v
            {
                NullVal => { this.writeNull(); }
                BoolVal(b) => { this.writeBoolean(b); }
                UByteVal(n) => { this.writeUbyte(n); }
                UShortVal(n) => { this.writeUshort(n); }
                UIntVal(n) => { this.writeUint(n); }
                ULongVal(n) => { this.writeUlong(n); }
                ByteVal(n) => { this.writeByte(n); }
                ShortVal(n) => { this.writeShort(n); }
                IntVal(n) => { this.writeInt(n); }
                LongVal(n) => { this.writeLong(n); }
                CharVal(n) => { this.writeChar(n); }
                TimestampVal(n) => { this.writeTimestamp(n); }
                UuidVal(b) => { this.writeUuid(b); }
                BinaryVal(b) => { this.writeBinary(b); }
                StrVal(s) => { this.writeString(s); }
                SymbolVal(s) => { this.writeSymbol(s); }
                ListVal(items) => { this.writeList(items); }
                MapVal(pairs) => { this.writeMap(pairs); }
                DescribedVal(d) => { this.writeDescribed(d); }
                ErrorVal(_msg) => {
                    // Ein ErrorVal wird nie gesendet (nur Decode-Ergebnis) —
                    // kein Silent-Garbage: harter Null-Marker statt Schweigen,
                    // falls doch versehentlich re-encodiert wird (analog zu
                    // 0-9-1s AmqpFieldValue091::ErrorVal-Handling).
                    this.writeNull();
                }
            }
        }
    }

    /*
     * Gegenstück zu Amqp10Writer: liest big-endian aus `bytes` ab einer
     * internen Cursor-Position `pos`. Formatcode-getrieben — anders als
     * 0-9-1s AmqpReader091 (Aufrufer sagt, WELCHEN Typ er an dieser
     * Position erwartet) bestimmt hier IMMER der nächste Formatcode-Byte
     * selbst den Typ (readValue()). Kein Bounds-Check auf Array-Ebene
     * (Aufrufer MUSS die Frame-Größe vorher kennen, analog zu 0-9-1).
     */
    class Amqp10Reader
    {
        var bytes: List<Int64>;
        var pos: Int64;

        fn new(bytes: List<Int64>) -> Amqp10Reader
        {
            return Amqp10Reader { bytes: bytes, pos: 0 };
        }

        fn remaining() -> Int64
        {
            return this.bytes.len() - this.pos;
        }

        fn readU8() -> Int64
        {
            let v = this.bytes[this.pos];
            this.pos = this.pos + 1;
            return v;
        }

        fn readU16() -> Int64
        {
            let hi = this.readU8();
            let lo = this.readU8();
            return (hi << 8) | lo;
        }

        fn readU32() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..4 {
                v = (v << 8) | this.readU8();
            }
            return v;
        }

        fn readU64() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..8 {
                v = (v << 8) | this.readU8();
            }
            return v;
        }

        fn toSigned8(v: Int64) -> Int64
        {
            if v >= 128 {
                return v - 256;
            }
            return v;
        }

        fn toSigned16(v: Int64) -> Int64
        {
            if v >= 32768 {
                return v - 65536;
            }
            return v;
        }

        fn toSigned32(v: Int64) -> Int64
        {
            if v >= 2147483648 {
                return v - 4294967296;
            }
            return v;
        }

        fn readRawStr(n: Int64) -> String
        {
            var s: String = "";
            for i in 0..n {
                let b = this.readU8();
                s = s + fromCharCode(b);
            }
            return s;
        }

        fn readRawBytes(n: Int64) -> List<Int64>
        {
            var out: List<Int64> = [];
            for i in 0..n {
                out.push(this.readU8());
            }
            return out;
        }

        /* Liest EINEN Wert des angegebenen Formatcodes (ohne den Codebyte
         * selbst zu lesen — der ist bei Array-Elementen NUR EINMAL vor
         * allen Elementen vorhanden, s. readArray). readValue() ist der
         * normale Einstiegspunkt (liest den Codebyte selbst); dieser hier
         * ist der gemeinsame Kern für beide Fälle. */
        fn readValueOfCode(code: Int64) -> Amqp10Value
        {
            if code == 0x40 { return Amqp10Value::NullVal; }
            if code == 0x41 { return Amqp10Value::BoolVal(true); }
            if code == 0x42 { return Amqp10Value::BoolVal(false); }
            if code == 0x56 { return Amqp10Value::BoolVal(this.readU8() != 0); }
            if code == 0x50 { return Amqp10Value::UByteVal(this.readU8()); }
            if code == 0x60 { return Amqp10Value::UShortVal(this.readU16()); }
            if code == 0x70 { return Amqp10Value::UIntVal(this.readU32()); }
            if code == 0x52 { return Amqp10Value::UIntVal(this.readU8()); }
            if code == 0x43 { return Amqp10Value::UIntVal(0); }
            if code == 0x80 { return Amqp10Value::ULongVal(this.readU64()); }
            if code == 0x53 { return Amqp10Value::ULongVal(this.readU8()); }
            if code == 0x44 { return Amqp10Value::ULongVal(0); }
            if code == 0x51 { return Amqp10Value::ByteVal(this.toSigned8(this.readU8())); }
            if code == 0x61 { return Amqp10Value::ShortVal(this.toSigned16(this.readU16())); }
            if code == 0x71 { return Amqp10Value::IntVal(this.toSigned32(this.readU32())); }
            if code == 0x54 { return Amqp10Value::IntVal(this.toSigned8(this.readU8())); }
            if code == 0x81 { return Amqp10Value::LongVal(this.readU64()); }
            if code == 0x55 { return Amqp10Value::LongVal(this.toSigned8(this.readU8())); }
            if code == 0x73 { return Amqp10Value::CharVal(this.readU32()); }
            if code == 0x83 { return Amqp10Value::TimestampVal(this.readU64()); }
            if code == 0x98 { return Amqp10Value::UuidVal(this.readRawBytes(16)); }
            if code == 0xa0 { return Amqp10Value::BinaryVal(this.readRawBytes(this.readU8())); }
            if code == 0xb0 { return Amqp10Value::BinaryVal(this.readRawBytes(this.readU32())); }
            if code == 0xa1 { return Amqp10Value::StrVal(this.readRawStr(this.readU8())); }
            if code == 0xb1 { return Amqp10Value::StrVal(this.readRawStr(this.readU32())); }
            if code == 0xa3 { return Amqp10Value::SymbolVal(this.readRawStr(this.readU8())); }
            if code == 0xb3 { return Amqp10Value::SymbolVal(this.readRawStr(this.readU32())); }
            if code == 0x45 { return Amqp10Value::ListVal([]); }
            if code == 0xc0 { return this.readList(this.readU8(), this.readU8()); }
            if code == 0xd0 { return this.readList(this.readU32(), this.readU32()); }
            if code == 0xc1 { return this.readMap(this.readU8(), this.readU8()); }
            if code == 0xd1 { return this.readMap(this.readU32(), this.readU32()); }
            if code == 0xe0 { return this.readArray(this.readU8(), this.readU8()); }
            if code == 0xf0 { return this.readArray(this.readU32(), this.readU32()); }
            if code == 0x00 { return this.readDescribed(); }
            // float/double/decimal32/64/128: nicht unterstützt (s.
            // Amqp10Value-Kommentar) — Cursor trotzdem korrekt weiterrücken
            // (kein Resync-Verlust für nachfolgende Felder), aber der Wert
            // selbst ist ein harter Fehlermarker statt Silent-Garbage.
            if code == 0x72 { this.readU32(); return Amqp10Value::ErrorVal("float nicht unterstuetzt in v1"); }
            if code == 0x82 { this.readU64(); return Amqp10Value::ErrorVal("double nicht unterstuetzt in v1"); }
            if code == 0x74 { this.readU32(); return Amqp10Value::ErrorVal("decimal32 nicht unterstuetzt in v1"); }
            if code == 0x84 { this.readU64(); return Amqp10Value::ErrorVal("decimal64 nicht unterstuetzt in v1"); }
            if code == 0x94 { this.readRawBytes(16); return Amqp10Value::ErrorVal("decimal128 nicht unterstuetzt in v1"); }
            // Unbekannter Formatcode: Breite unbekannt, Cursor kann NICHT
            // sicher resynchronisiert werden — fataler Fehler, Aufrufer MUSS
            // das gesamte Decodieren abbrechen (analog zu 0-9-1s frameType -2).
            return Amqp10Value::ErrorVal("unbekannter Formatcode: " + code.toString());
        }

        fn readValue() -> Amqp10Value
        {
            return this.readValueOfCode(this.readU8());
        }

        fn readList(size: Int64, count: Int64) -> Amqp10Value
        {
            var items: List<Amqp10Value> = [];
            for i in 0..count {
                items.push(this.readValue());
            }
            return Amqp10Value::ListVal(items);
        }

        fn readMap(size: Int64, count: Int64) -> Amqp10Value
        {
            var pairs: List<Amqp10Value> = [];
            for i in 0..count {
                pairs.push(this.readValue());
            }
            return Amqp10Value::MapVal(pairs);
        }

        /* Array-Elemente teilen sich EINEN Formatcode (nach size+count),
         * jedes Element selbst hat KEIN eigenes Codebyte mehr — deshalb
         * readValueOfCode(elementCode) statt readValue() in der Schleife. */
        fn readArray(size: Int64, count: Int64) -> Amqp10Value
        {
            let elementCode = this.readU8();
            var items: List<Amqp10Value> = [];
            for i in 0..count {
                items.push(this.readValueOfCode(elementCode));
            }
            return Amqp10Value::ListVal(items);
        }

        /* Descriptor wird generisch als Amqp10Value gelesen (Spec erlaubt
         * jeden Wert als Descriptor), aber v1 akzeptiert NUR numerische
         * Descriptoren (s. Amqp10Described) — alles andere ist ein harter
         * Fehler statt eines stillschweigend ignorierten Descriptors. */
        fn readDescribed() -> Amqp10Value
        {
            let descVal = this.readValue();
            var descriptor: Int64 = -1;
            var descOk: Bool = false;
            match descVal
            {
                UByteVal(n) => { descriptor = n; descOk = true; }
                UShortVal(n) => { descriptor = n; descOk = true; }
                UIntVal(n) => { descriptor = n; descOk = true; }
                ULongVal(n) => { descriptor = n; descOk = true; }
                _ => {}
            }
            let inner = this.readValue();
            if !descOk {
                return Amqp10Value::ErrorVal("Described-Type mit nicht-numerischem Descriptor (v1 nicht unterstuetzt)");
            }
            return Amqp10Value::DescribedVal(Amqp10Described { descriptor: descriptor, value: inner });
        }
    }

    /*
     * Ein gelesenes AMQP-1.0-Frame (§2.3.1 der Sondierung in tasklist.md).
     * frameType: 0 = AMQP-Frame, 1 = SASL-Frame (Broker darf beide auf
     * derselben Verbindung schicken, je nach Negotiation-Phase);
     * zusätzlich als Lese-Ergebnis: -1 = Verbindung zu/EOF, -2 =
     * Protokollfehler (unplausible size/doff, s. Amqp10::readFrame).
     */
    class Amqp10Frame
    {
        var frameType: Int64;
        var chanId: Int64;
        var body: List<Int64>;
    }

    /*
     * Eine dekodierte Performative-Hülle (§2.3.1: jede der 9 Performatives
     * ist ein Described List — EIN generisches Encoding für alle, anders
     * als 0-9-1s classId+methodId+methodenspezifisches Feld-Schema).
     * descriptor: -1 = Decode-Fehler (unerwartete Struktur — s.
     * Amqp10::decodePerformative). fields sind POSITIONELL, die
     * Feldbedeutung ergibt sich aus der jeweiligen Performative-Spec
     * (Phase 5/6), nicht aus diesem generischen Baustein.
     */
    class Amqp10Performative
    {
        var descriptor: Int64;
        var fields: List<Amqp10Value>;
    }

    /*
     * Ergebnis von Amqp10::negotiateSasl (Phase 4). ok == false bei jedem
     * Fehlschlag (falscher Frame-Typ, unerwartete Performative, PLAIN nicht
     * angeboten, sasl-outcome-code != 0) — errorMessage beschreibt dann die
     * Ursache, analog zu 0-9-1s errorMessage-Feld-Konvention.
     */
    class Amqp10SaslResult
    {
        var ok: Bool;
        var errorMessage: String;
    }

    class Amqp10
    {
        /*
         * Verbindet zum Broker (rohes TCP), noch OHNE Protokoll-Handshake.
         * Rückgabe: Conn-Handle (>0) oder -1 bei Verbindungsfehler.
         */
        fn dial(host: String, port: Int64) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                return -1;
            }
            return httpConnFromFd(fd);
        }

        /*
         * amqps:// — TLS-Variante von dial(). OpenSSL ist standardmäßig
         * gelinkt (s. HttpServer::listenTls); mit TINOX_TLS=0 gebaut
         * liefert httpConnFromFdTls -1. verify=true prüft Zertifikatskette
         * + Hostname gegen die System-CA-Stores; verify=false ist ein
         * bewusster Opt-out für selbstsignierte Testzertifikate.
         */
        fn dialTls(host: String, port: Int64, verify: Bool) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                return -1;
            }
            return httpConnFromFdTls(fd, host, verify);
        }

        /*
         * Sendet den 8-Byte-AMQP-Protokoll-Header (Protocol-ID 0):
         * "AMQP" 0x00 0x01 0x00 0x00.
         */
        fn sendAmqpProtocolHeader(conn: Int64) -> Nothing
        {
            httpConnWriteBytes(conn, [65, 77, 81, 80, 0, 1, 0, 0]);
        }

        /*
         * Sendet den 8-Byte-SASL-Protokoll-Header (Protocol-ID 3):
         * "AMQP" 0x03 0x01 0x00 0x00. Läuft VOR dem AMQP-Header auf
         * derselben Verbindung, wenn SASL-Auth genutzt wird (v1 macht das
         * immer, analog zu 0-9-1s SASL-PLAIN-Weg).
         */
        fn sendSaslProtocolHeader(conn: Int64) -> Nothing
        {
            httpConnWriteBytes(conn, [65, 77, 81, 80, 3, 1, 0, 0]);
        }

        /*
         * Liest 8 Byte und vergleicht sie exakt mit dem zuvor gesendeten
         * Header (§2.2: der Empfänger bestätigt eine unterstützte Version,
         * indem er DENSELBEN Header zurücksendet — anders als 0-9-1, wo
         * Erfolg am ersten Byte eines echten Frames statt eines Echo-Headers
         * erkannt wird). Ungleicher Header (Broker schlägt eine andere
         * Version vor) ODER EOF/Kurzread gelten beide als harter
         * Fehlschlag; der Aufrufer schließt dann die Verbindung.
         */
        fn checkProtocolHeaderEcho(conn: Int64, sent: List<Int64>) -> Bool
        {
            let resp = httpConnReadN(conn, 8);
            if resp.len() != 8 {
                return false;
            }
            for i in 0..8 {
                if resp[i] != sent[i] {
                    return false;
                }
            }
            return true;
        }

        /*
         * Liest EIN Frame (§2.3.1): size(4B) | doff(1B) | type(1B) |
         * chanId(2B) | [extended header, (doff-2)*4 Byte] | body. `size`
         * ist die GESAMTgröße inkl. der 8 Fixed-Header-Bytes (anders als
         * 0-9-1s `long`, das nur die Payload-Länge zählt). Extended Header
         * wird gelesen und verworfen (v1 nutzt ihn nicht, aber Broker
         * dürfen ihn setzen — überspringen statt zu crashen). Fehlerhafte
         * size/doff (kleiner als der Fixed-Header, oder header > size)
         * sind ein harter Protokollfehler (-2) statt Silent-Garbage, exakt
         * wie 0-9-1s Frame-Terminator-Check.
         */
        fn readFrame(conn: Int64) -> Amqp10Frame
        {
            let bad = Amqp10Frame { frameType: -1, chanId: 0, body: [] };
            let hdr = httpConnReadN(conn, 8);
            if hdr.len() < 8 {
                return bad;
            }
            let size = (hdr[0] << 24) | (hdr[1] << 16) | (hdr[2] << 8) | hdr[3];
            let doff = hdr[4];
            let frameType = hdr[5];
            let chanId = (hdr[6] << 8) | hdr[7];
            if size < 8 || doff < 2 {
                return Amqp10Frame { frameType: -2, chanId: chanId, body: [] };
            }
            let headerBytes = doff * 4;
            if headerBytes > size {
                return Amqp10Frame { frameType: -2, chanId: chanId, body: [] };
            }
            let extendedBytes = headerBytes - 8;
            if extendedBytes > 0 {
                let ext = httpConnReadN(conn, extendedBytes);
                if ext.len() < extendedBytes {
                    return bad;
                }
            }
            let bodyBytes = size - headerBytes;
            if bodyBytes > 16777216 {
                return Amqp10Frame { frameType: -2, chanId: chanId, body: [] };
            }
            var body: List<Int64> = [];
            if bodyBytes > 0 {
                let raw = httpConnReadN(conn, bodyBytes);
                if raw.len() < bodyBytes {
                    return bad;
                }
                body = raw;
            }
            return Amqp10Frame { frameType: frameType, chanId: chanId, body: body };
        }

        /*
         * Wie readFrame(), aber absorbiert eingehende Heartbeat-Frames
         * (§2.4.5: ein "empty frame", also ein Frame ganz ohne Body) statt
         * sie an den Aufrufer durchzureichen (Issue 82). Der Broker darf
         * jederzeit einen Heartbeat schicken, sobald `open`/`open-ok` das
         * idle-time-out ausgehandelt haben — jede Stelle, die auf eine
         * ECHTE Performative wartet (aktuell: nextMessage(), das lange
         * blockierend auf den nächsten transfer wartet, s. Amqp10Link),
         * MUSS Heartbeats transparent überspringen statt sie fälschlich
         * als Protokollfehler zu werten. Andere Call-Sites (begin/attach/
         * detach/end/close) bleiben bei readFrame() — dort läuft nie genug
         * Zeit zwischen Send und erwarteter Antwort, dass ein Heartbeat
         * dazwischenkäme (v1-Annahme, analog zu awaitFlow()s Kommentar
         * zum fehlenden echten Frame-Dispatcher).
         */
        fn readFrameSkipHeartbeats(conn: Int64) -> Amqp10Frame
        {
            while true {
                let f = Amqp10::readFrame(conn);
                if f.frameType < 0 {
                    return f; // EOF/Protokollfehler, unveraendert durchreichen
                }
                if f.body.len() > 0 {
                    return f; // echtes Frame
                }
                // Leerer Body = Heartbeat: absorbieren, weiterwarten.
            }
            return Amqp10Frame { frameType: -1, chanId: 0, body: [] };
        }

        /*
         * Schreibt ein Frame (§2.3.1). v1: `doff` immer 2 (kein Extended
         * Header) — die Runde 0/1-Frame-Type-Unterscheidung (AMQP/SASL)
         * entscheidet der Aufrufer je nach Handshake-Phase.
         */
        fn writeFrame(conn: Int64, frameType: Int64, chanId: Int64, body: List<Int64>) -> Nothing
        {
            let w = Amqp10Writer::new();
            w.pushU32(8 + body.len());
            w.pushU8(2);
            w.pushU8(frameType);
            w.pushU16(chanId);
            w.pushRawBytes(body);
            httpConnWriteBytes(conn, w.bytes);
        }

        /*
         * Baut den Frame-Body einer Performative (§2.3.1): Described Type
         * mit `descriptorCode` (als smallulong) + einem ListVal der
         * positionellen Felder — EIN generischer Baustein für alle 9
         * Performatives, anders als 0-9-1s methodenspezifisches
         * encodeMethodPayload (classId+methodId+eigenes Argument-Schema
         * pro Methode).
         */
        fn encodePerformative(descriptorCode: Int64, fields: List<Amqp10Value>) -> List<Int64>
        {
            let w = Amqp10Writer::new();
            let d = Amqp10Described { descriptor: descriptorCode, value: Amqp10Value::ListVal(fields) };
            w.writeDescribed(d);
            return w.bytes;
        }

        /*
         * Zerlegt einen Frame-Body in Descriptor-Code + positionelle
         * Felder. Erwartet EXAKT die Struktur, die encodePerformative
         * erzeugt (Described Type über einer ListVal) — jede Abweichung
         * (kein Described Type, Wert ist keine Liste, nicht-numerischer
         * Descriptor) ist ein harter Fehler: descriptor -1, leere fields,
         * kein Best-Effort-Parsing.
         */
        fn decodePerformative(body: List<Int64>) -> Amqp10Performative
        {
            let r = Amqp10Reader::new(body);
            let v = r.readValue();
            var descriptor: Int64 = -1;
            var fields: List<Amqp10Value> = [];
            match v
            {
                DescribedVal(d) => {
                    match d.value
                    {
                        ListVal(innerFields) => {
                            descriptor = d.descriptor;
                            fields = innerFields;
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            return Amqp10Performative { descriptor: descriptor, fields: fields };
        }

        /*
         * Baut den Frame-Body einer Nachricht (Phase 6, §3.2): eine
         * `properties`-Section (0x73, nur `content-type` gesetzt, alle
         * davorliegenden Felder als Platzhalter — Listenfelder dürfen nur
         * am ENDE weggelassen werden) gefolgt von einer `data`-Section
         * (0x75, Rohbytes-Body). v1 nutzt bewusst NUR diese zwei Sections
         * (kein `header`, keine `application-properties`) — analog zu
         * 0-9-1s Content-Type/Body-Konzept, aber als eigene Described-
         * Type-Sections statt eines separaten Content-Header-Frames.
         */
        fn encodeMessageBody(body: List<Int64>, contentType: String) -> List<Int64>
        {
            let w = Amqp10Writer::new();
            var propFields: List<Amqp10Value> = [
                Amqp10Value::NullVal, // message-id
                Amqp10Value::NullVal, // user-id
                Amqp10Value::NullVal, // to
                Amqp10Value::NullVal, // subject
                Amqp10Value::NullVal, // reply-to
                Amqp10Value::NullVal, // correlation-id
                Amqp10Value::SymbolVal(contentType)
            ];
            let propDesc = Amqp10Described { descriptor: 0x73, value: Amqp10Value::ListVal(propFields) };
            w.writeDescribed(propDesc);
            let dataDesc = Amqp10Described { descriptor: 0x75, value: Amqp10Value::BinaryVal(body) };
            w.writeDescribed(dataDesc);
            return w.bytes;
        }

        /* 4-Byte-Big-Endian-Encoding eines Zählers als delivery-tag
         * (binary, beliebige Byte-Folge laut Spec — muss nur innerhalb
         * unsettled Deliveries auf demselben Link eindeutig sein). */
        fn deliveryTagBytes(n: Int64) -> List<Int64>
        {
            return [(n >> 24) & 0xFF, (n >> 16) & 0xFF, (n >> 8) & 0xFF, n & 0xFF];
        }

        /*
         * SASL-PLAIN-Response: "\0user\0pass" als Rohbytes — identische
         * Byte-Struktur zu 0-9-1s Amqp091::saslPlainResponse, aber neu
         * implementiert im neuen Modul (kein Cross-Import zwischen den
         * beiden AMQP-Modulen).
         */
        fn saslPlainResponse(user: String, pass: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            bytes.push(0);
            for i in 0..user.len() {
                bytes.push(user.charCodeAt(i) & 0xFF);
            }
            bytes.push(0);
            for i in 0..pass.len() {
                bytes.push(pass.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        /*
         * SASL-Negotiation (Descriptor-Codes s. tasklist.md-Sondierung):
         * sasl-mechanisms (0x40) empfangen -> PLAIN suchen -> sasl-init
         * (0x41) senden -> sasl-outcome (0x44) empfangen -> code prüfen.
         * Läuft NACH dem SASL-Protokoll-Header (sendSaslProtocolHeader +
         * checkProtocolHeaderEcho, Phase 1) auf DERSELBEN Verbindung, auf
         * der danach der AMQP-Header + `open` folgen (Phase 5). v1: nur
         * PLAIN, keine sasl-challenge/-response-Runde (nur für
         * Mechanismen wie SCRAM nötig).
         */
        fn negotiateSasl(conn: Int64, user: String, pass: String) -> Amqp10SaslResult
        {
            // --- sasl-mechanisms empfangen ---
            let f1 = Amqp10::readFrame(conn);
            if f1.frameType != 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "erwartete SASL-Frame (type=1), bekam frameType=" + f1.frameType.toString() };
            }
            let p1 = Amqp10::decodePerformative(f1.body);
            if p1.descriptor != 0x40 {
                return Amqp10SaslResult { ok: false, errorMessage: "erwartete sasl-mechanisms (0x40), bekam descriptor=" + p1.descriptor.toString() };
            }
            if p1.fields.len() < 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-mechanisms ohne Mechanismen-Feld" };
            }
            var hasPlain: Bool = false;
            match p1.fields[0]
            {
                // sasl-server-mechanisms ist laut Spec immer ein
                // symbol-array (auch bei genau einem Mechanismus) —
                // ListVal ist der generische Rueckgabetyp von
                // Amqp10Reader::readArray. Der SymbolVal-Zweig ist reine
                // Verteidigung gegen abweichende Broker, nicht spec-noetig.
                ListVal(mechs) => {
                    for i in 0..mechs.len() {
                        match mechs[i] {
                            SymbolVal(s) => { if s == "PLAIN" { hasPlain = true; } }
                            _ => {}
                        }
                    }
                }
                SymbolVal(s) => { if s == "PLAIN" { hasPlain = true; } }
                _ => {}
            }
            if !hasPlain {
                return Amqp10SaslResult { ok: false, errorMessage: "Broker bietet SASL-Mechanismus PLAIN nicht an" };
            }

            // --- sasl-init senden: mechanism, initial-response, hostname(null) ---
            var initFields: List<Amqp10Value> = [
                Amqp10Value::SymbolVal("PLAIN"),
                Amqp10Value::BinaryVal(Amqp10::saslPlainResponse(user, pass)),
                Amqp10Value::NullVal
            ];
            let initBody = Amqp10::encodePerformative(0x41, initFields);
            Amqp10::writeFrame(conn, 1, 0, initBody);

            // --- sasl-outcome empfangen ---
            let f2 = Amqp10::readFrame(conn);
            if f2.frameType != 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "erwartete SASL-Frame (type=1), bekam frameType=" + f2.frameType.toString() };
            }
            let p2 = Amqp10::decodePerformative(f2.body);
            if p2.descriptor != 0x44 {
                return Amqp10SaslResult { ok: false, errorMessage: "erwartete sasl-outcome (0x44), bekam descriptor=" + p2.descriptor.toString() };
            }
            if p2.fields.len() < 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-outcome ohne code-Feld" };
            }
            var code: Int64 = -1;
            match p2.fields[0]
            {
                UByteVal(n) => { code = n; }
                _ => {}
            }
            if code != 0 {
                return Amqp10SaslResult { ok: false, errorMessage: "SASL-Auth fehlgeschlagen, sasl-outcome-code=" + code.toString() };
            }
            return Amqp10SaslResult { ok: true, errorMessage: "" };
        }
    }

    /*
     * Eine ausgehandelte AMQP-1.0-Verbindung (Phase 5, nach vollständigem
     * SASL-Header/Negotiation + AMQP-Header/`open`/`open-ok`-Handshake).
     * `conn` ist -1 bei jedem Fehlschlag (Aufrufer MUSS prüfen, kein
     * Silent-Garbage) — `errorMessage` beschreibt dann die Ursache.
     */
    class Amqp10Connection
    {
        var conn: Int64;
        var maxFrameSize: Int64;
        var channelMax: Int64;
        var errorMessage: String;
        // Issue 82: gespeicherte Verbindungsparameter (fuer reconnect()) +
        // Heartbeat-Zustand. idleTimeoutMs ist das vom BROKER in open-ok
        // angebotene idle-time-out (0 = keins angeboten) — die Empfehlung
        // der Spec ist, deutlich haeufiger als dieses Intervall zu senden
        // (Taktungenauigkeiten), s. startHeartbeat().
        var host: String;
        var port: Int64;
        var user: String;
        var pass: String;
        var idleTimeoutMs: Int64;
        var heartbeatRunning: Bool;
        var heartbeatHandle: Int64;

        /*
         * Baut eine komplette AMQP-1.0-Verbindung auf: dial + SASL-Header +
         * SASL-Negotiation (Phase 4) + AMQP-Header + `open`/`open-ok`.
         * v1 übernimmt die Server-Vorschläge aus `open-ok`
         * (`max-frame-size`/`channel-max`) wie 0-9-1s `connection.tune`,
         * kein eigenes Verhandeln. Schickt im eigenen `open` ein festes
         * idle-time-out von 30s (Issue 82) — der Client verspricht dem
         * Broker damit, spaetestens alle 30s ein Lebenszeichen zu senden
         * (s. startHeartbeat()); rein informativ, solange niemand
         * startHeartbeat() aufruft, bricht der Broker bei Inaktivitaet
         * ggf. selbst ab (v1-Tradeoff: kein automatischer Heartbeat ohne
         * expliziten Aufruf, analog zum expliziten grantCredit()-Muster).
         */
        fn connect(host: String, port: Int64, user: String, pass: String) -> Amqp10Connection
        {
            let conn = Amqp10::dial(host, port);
            if conn <= 0 {
                return Amqp10Connection { conn: -1, maxFrameSize: 0, channelMax: 0, errorMessage: "dial fehlgeschlagen", host: host, port: port, user: user, pass: pass, idleTimeoutMs: 0, heartbeatRunning: false, heartbeatHandle: -1 };
            }

            // --- SASL-Header + Negotiation ---
            Amqp10::sendSaslProtocolHeader(conn);
            if !Amqp10::checkProtocolHeaderEcho(conn, [65, 77, 81, 80, 3, 1, 0, 0]) {
                httpConnClose(conn);
                return Amqp10Connection { conn: -1, maxFrameSize: 0, channelMax: 0, errorMessage: "SASL-Protokoll-Header-Handshake fehlgeschlagen", host: host, port: port, user: user, pass: pass, idleTimeoutMs: 0, heartbeatRunning: false, heartbeatHandle: -1 };
            }
            let sasl = Amqp10::negotiateSasl(conn, user, pass);
            if !sasl.ok {
                httpConnClose(conn);
                return Amqp10Connection { conn: -1, maxFrameSize: 0, channelMax: 0, errorMessage: sasl.errorMessage, host: host, port: port, user: user, pass: pass, idleTimeoutMs: 0, heartbeatRunning: false, heartbeatHandle: -1 };
            }

            // --- AMQP-Header ---
            Amqp10::sendAmqpProtocolHeader(conn);
            if !Amqp10::checkProtocolHeaderEcho(conn, [65, 77, 81, 80, 0, 1, 0, 0]) {
                httpConnClose(conn);
                return Amqp10Connection { conn: -1, maxFrameSize: 0, channelMax: 0, errorMessage: "AMQP-Protokoll-Header-Handshake fehlgeschlagen", host: host, port: port, user: user, pass: pass, idleTimeoutMs: 0, heartbeatRunning: false, heartbeatHandle: -1 };
            }

            // --- open senden: container-id, hostname(null), max-frame-size/
            // channel-max (Spec-Defaults, unveraendert), idle-time-out(30s) ---
            var openFields: List<Amqp10Value> = [
                Amqp10Value::StrVal("tinox-client"),
                Amqp10Value::NullVal,
                Amqp10Value::UIntVal(4294967295),
                Amqp10Value::UShortVal(65535),
                Amqp10Value::UIntVal(30000)
            ];
            let openBody = Amqp10::encodePerformative(0x10, openFields);
            Amqp10::writeFrame(conn, 0, 0, openBody);

            // --- open empfangen ---
            let f = Amqp10::readFrame(conn);
            if f.frameType != 0 {
                httpConnClose(conn);
                return Amqp10Connection { conn: -1, maxFrameSize: 0, channelMax: 0, errorMessage: "erwartete AMQP-Frame (type=0), bekam frameType=" + f.frameType.toString(), host: host, port: port, user: user, pass: pass, idleTimeoutMs: 0, heartbeatRunning: false, heartbeatHandle: -1 };
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x10 {
                httpConnClose(conn);
                return Amqp10Connection { conn: -1, maxFrameSize: 0, channelMax: 0, errorMessage: "erwartete open (0x10), bekam descriptor=" + p.descriptor.toString(), host: host, port: port, user: user, pass: pass, idleTimeoutMs: 0, heartbeatRunning: false, heartbeatHandle: -1 };
            }
            // Feldpositionen: container-id(0), hostname(1), max-frame-size(2),
            // channel-max(3), idle-time-out(4) — trailing Felder duerfen
            // fehlen (Listen koennen kuerzer sein als das volle Schema),
            // Default gilt dann weiter.
            var maxFrameSize: Int64 = 4294967295;
            var channelMax: Int64 = 65535;
            var idleTimeoutMs: Int64 = 0;
            if p.fields.len() > 2 {
                match p.fields[2] { UIntVal(n) => { maxFrameSize = n; } _ => {} }
            }
            if p.fields.len() > 3 {
                match p.fields[3] { UShortVal(n) => { channelMax = n; } _ => {} }
            }
            if p.fields.len() > 4 {
                match p.fields[4] { UIntVal(n) => { idleTimeoutMs = n; } _ => {} }
            }
            return Amqp10Connection { conn: conn, maxFrameSize: maxFrameSize, channelMax: channelMax, errorMessage: "", host: host, port: port, user: user, pass: pass, idleTimeoutMs: idleTimeoutMs, heartbeatRunning: false, heartbeatHandle: -1 };
        }

        /*
         * Sendet EIN Heartbeat (§2.4.5 "empty frame" — ein Frame ganz ohne
         * Body, Groesse exakt 8 Byte). Kann auch manuell aufgerufen werden,
         * fuer den ueblichen Fall aber s. startHeartbeat().
         */
        fn sendHeartbeat() -> Nothing
        {
            Amqp10::writeFrame(this.conn, 0, 0, []);
        }

        /*
         * Startet einen Hintergrund-Task (echter Thread, s. spawn), der
         * alle `intervalMs` ein Heartbeat sendet, bis stopHeartbeat()
         * (oder close()) aufgerufen wird. Noetig, weil das Aufrufer-Thread
         * lange blockierend in Amqp10Link::nextMessage() haengen kann,
         * waehrend trotzdem regelmaessig etwas aufs Wire muss, damit der
         * Broker die Verbindung nicht wegen Inaktivitaet schliesst.
         *
         * Thread-Sicherheit: httpConnWriteBytes() ist seit Issue 82 pro
         * Connection-Handle gemutext (runtime.c, conn_send_all) — ohne das
         * koennten zwei Threads (App-Thread + dieser Heartbeat-Task) ihre
         * Bytes mitten in einem Frame verschraenkt aufs Wire schreiben.
         * `intervalMs` sollte deutlich unter dem vom Broker in open-ok
         * angebotenen idleTimeoutMs liegen (Spec-Empfehlung: haeufiger
         * senden als das ausgehandelte Intervall, wegen Taktungenauigkeit
         * — v1 ueberlaesst die konkrete Wahl bewusst dem Aufrufer statt
         * sie automatisch aus idleTimeoutMs abzuleiten, analog zum
         * expliziten grantCredit()-Muster).
         */
        fn startHeartbeat(intervalMs: Int64) -> Nothing
        {
            this.heartbeatRunning = true;
            this.heartbeatHandle = spawn amqp10HeartbeatLoop(this, intervalMs);
        }

        /*
         * Stoppt den Heartbeat-Task und wartet, bis er wirklich beendet
         * ist (await joint den Task) — WICHTIG vor close()/httpConnClose(),
         * sonst koennte der Heartbeat-Task noch versuchen, ueber ein
         * bereits geschlossenes Handle zu schreiben.
         */
        fn stopHeartbeat() -> Nothing
        {
            if this.heartbeatRunning {
                this.heartbeatRunning = false;
                await this.heartbeatHandle;
            }
        }

        /*
         * Schließt die Verbindung: Heartbeat-Task zuerst sauber stoppen
         * (s. stopHeartbeat()), dann `close` senden und auf `close` vom
         * Broker warten (v1 ungeprüft, analog zu 0-9-1s
         * `AmqpConnection091::close`).
         */
        fn close() -> Nothing
        {
            this.stopHeartbeat();
            let closeBody = Amqp10::encodePerformative(0x18, []);
            Amqp10::writeFrame(this.conn, 0, 0, closeBody);
            Amqp10::readFrame(this.conn);
            httpConnClose(this.conn);
        }

        /*
         * Baut die Verbindung mit denselben Zugangsdaten neu auf (Issue
         * 82) — z.B. nach einem erkannten Verbindungsabbruch. v1-Grenze:
         * REBUILDET NUR die Connection selbst, keine automatische,
         * transparente Wiederherstellung bereits bestehender Session-/
         * Link-Objekte (die halten eigene conn/chanId-Werte, die nach
         * einem Reconnect veraltet sind) — der Aufrufer MUSS Session/Link
         * nach einem reconnect() explizit neu aufbauen (Amqp10Session::
         * begin(neueConn), Amqp10Link::attach(...)). Fuer echtes
         * Link-Recovery ueber Reconnects hinweg (unsettled-Map beim
         * attach) s. das separate, ebenfalls offene "Später"-Issue.
         */
        fn reconnect() -> Amqp10Connection
        {
            return Amqp10Connection::connect(this.host, this.port, this.user, this.pass);
        }
    }

    /*
     * Hintergrund-Schleife fuer Amqp10Connection::startHeartbeat() — als
     * freie Funktion statt Instanzmethode, weil spawn eine eigenstaendige
     * Funktion braucht (kein spawnbarer this-gebundener Methodenaufruf);
     * `conn` ist dieselbe (Referenz-)Instanz wie beim Aufrufer, Mutationen
     * an conn.heartbeatRunning sind fuer beide Threads sichtbar (Class-
     * Instanzen sind Heap-Objekte).
     */
    async fn amqp10HeartbeatLoop(conn: Amqp10Connection, intervalMs: Int64) -> Int64
    {
        while conn.heartbeatRunning {
            sleep_ms(intervalMs);
            if conn.heartbeatRunning {
                conn.sendHeartbeat();
            }
        }
        return 1;
    }

    /*
     * Eine Session auf einer Amqp10Connection (§2.7.3, entspricht 0-9-1s
     * Channel, aber mit fenster-basierter Flow-Control statt reinem
     * "offen"-Status). v1: fester Kanal 1 pro Verbindung (kein Pool,
     * analog zur 0-9-1-v1-Entscheidung), `incoming-window`/
     * `outgoing-window` großzügig fest (kein echtes Fenster-Tracking in
     * v1 — Phase 6 (`flow`) fügt das für den eigentlichen
     * Nachrichtenfluss hinzu, `begin` selbst braucht nur plausible
     * Startwerte).
     */
    class Amqp10Session
    {
        var conn: Int64;
        var chanId: Int64;
        var maxFrameSize: Int64;
        var errorMessage: String;

        fn begin(connection: Amqp10Connection) -> Amqp10Session
        {
            var beginFields: List<Amqp10Value> = [
                Amqp10Value::NullVal,             // remote-channel (nur in Antworten gesetzt)
                Amqp10Value::UIntVal(0),           // next-outgoing-id
                Amqp10Value::UIntVal(2147483647),  // incoming-window
                Amqp10Value::UIntVal(2147483647)   // outgoing-window
            ];
            let beginBody = Amqp10::encodePerformative(0x11, beginFields);
            Amqp10::writeFrame(connection.conn, 0, 1, beginBody);

            let f = Amqp10::readFrame(connection.conn);
            if f.frameType != 0 {
                return Amqp10Session { conn: connection.conn, chanId: -1, maxFrameSize: connection.maxFrameSize, errorMessage: "erwartete AMQP-Frame (type=0), bekam frameType=" + f.frameType.toString() };
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x11 {
                return Amqp10Session { conn: connection.conn, chanId: -1, maxFrameSize: connection.maxFrameSize, errorMessage: "erwartete begin (0x11), bekam descriptor=" + p.descriptor.toString() };
            }
            return Amqp10Session { conn: connection.conn, chanId: 1, maxFrameSize: connection.maxFrameSize, errorMessage: "" };
        }

        /*
         * Beendet die Session: `end` senden und auf `end` vom Broker
         * warten (v1 ungeprüft, analog zu Amqp10Connection::close).
         */
        fn end() -> Nothing
        {
            let endBody = Amqp10::encodePerformative(0x17, []);
            Amqp10::writeFrame(this.conn, 0, this.chanId, endBody);
            Amqp10::readFrame(this.conn);
        }
    }

    /*
     * Eine per Amqp10Link::nextMessage() empfangene Nachricht (Phase 6).
     * ok == false bei jedem Fehler (falscher Frame-/Performative-Typ) —
     * errorMessage beschreibt dann die Ursache, analog zu 0-9-1s
     * AmqpMessage091. `deliveryId` wird für Amqp10Link::ack() gebraucht.
     */
    class Amqp10Message
    {
        var body: List<Int64>;
        var contentType: String;
        var deliveryId: Int64;
        var ok: Bool;
        var errorMessage: String;
    }

    /*
     * Ein Link auf einer Amqp10Session (§2.7.4) — explizite, gerichtete
     * Sender- ODER Receiver-Rolle mit `source`/`target`-Adressen, kein
     * Äquivalent in 0-9-1 (dort laufen `basic.publish`/`basic.consume`
     * implizit auf dem Channel). v1: ein Link pro Zweck (ein Sender-Link
     * zum Publishen, ein separater Receiver-Link zum Konsumieren), fester
     * `handle` 0 (kein Multi-Link-Pool pro Session).
     */
    class Amqp10Link
    {
        var conn: Int64;
        var chanId: Int64;
        var handle: Int64;
        var maxFrameSize: Int64;
        var linkCredit: Int64;
        var deliveryCount: Int64;
        var errorMessage: String;

        /*
         * role: false = Sender (target trägt die Zieladresse, z. B. eine
         * Queue zum Publishen), true = Receiver (source trägt die
         * Quelladresse, z. B. eine Queue zum Konsumieren) — Spec-
         * Konvention. Die jeweils andere Seite bekommt ein leeres,
         * adressloses Source/Target (Described Type mit leerer Feldliste,
         * nicht `NullVal` — die meisten Broker erwarten die Hülle auch
         * ohne Adresse).
         */
        fn attach(session: Amqp10Session, name: String, role: Bool, address: String) -> Amqp10Link
        {
            var sourceVal: Amqp10Value = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x28, value: Amqp10Value::ListVal([]) });
            var targetVal: Amqp10Value = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x29, value: Amqp10Value::ListVal([]) });
            if role {
                sourceVal = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x28, value: Amqp10Value::ListVal([Amqp10Value::StrVal(address)]) });
            } else {
                targetVal = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x29, value: Amqp10Value::ListVal([Amqp10Value::StrVal(address)]) });
            }

            // initial-delivery-count (Feld 10) ist per Spec PFLICHT, wenn
            // role=Sender ("MUST be set if the role is sender") — RabbitMQ
            // 4.x' rabbit_amqp_session:handle_attach pattern-matched das
            // Feld hart auf einen echten uint-Wert und crasht mit
            // function_clause, wenn es fehlt (live gegen echten Broker
            // gefunden, s. bugs.md). Braucht deshalb unsettled(8)/
            // incomplete-unsettled(9) als Platzhalter davor, weil
            // Listenfelder nur am ENDE weggelassen werden dürfen, nicht in
            // der Mitte.
            var attachFields: List<Amqp10Value> = [
                Amqp10Value::StrVal(name),
                Amqp10Value::UIntVal(0),   // handle (v1: immer 0, ein Link pro Session)
                Amqp10Value::BoolVal(role),
                Amqp10Value::UByteVal(2),  // snd-settle-mode: mixed (Spec-Default, explizit gesetzt)
                Amqp10Value::UByteVal(0),  // rcv-settle-mode: first (Spec-Default, explizit gesetzt)
                sourceVal,
                targetVal,
                Amqp10Value::NullVal,      // unsettled (v1 ungenutzt)
                Amqp10Value::BoolVal(false), // incomplete-unsettled: false (Spec-Default, explizit gesetzt)
                Amqp10Value::UIntVal(0)    // initial-delivery-count (nur fuer role=Sender relevant, sonst ignoriert)
            ];
            let attachBody = Amqp10::encodePerformative(0x12, attachFields);
            Amqp10::writeFrame(session.conn, 0, session.chanId, attachBody);

            let f = Amqp10::readFrame(session.conn);
            if f.frameType != 0 {
                return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: -1, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "erwartete AMQP-Frame (type=0), bekam frameType=" + f.frameType.toString() };
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x12 {
                return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: -1, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "erwartete attach (0x12), bekam descriptor=" + p.descriptor.toString() };
            }
            return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: 0, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "" };
        }

        /*
         * Löst den Link: `detach` senden und auf `detach` vom Broker
         * warten (v1 ungeprüft). `closed`-Feld weggelassen (Default
         * false — normales Detach, kein permanentes Löschen des Links).
         */
        fn detach() -> Nothing
        {
            var detachFields: List<Amqp10Value> = [Amqp10Value::UIntVal(this.handle)];
            let detachBody = Amqp10::encodePerformative(0x16, detachFields);
            Amqp10::writeFrame(this.conn, 0, this.chanId, detachBody);
            Amqp10::readFrame(this.conn);
        }

        /*
         * Liest EIN Frame und erwartet ein `flow` (0x13) — RabbitMQ
         * schickt es z. B. unaufgefordert direkt nach einem Sender-Attach
         * (live gegen echten Broker gefunden, s. bugs.md Bug 70/Phase-5-
         * Live-Erkenntnisse). Aktualisiert `this.linkCredit` aus dem
         * `link-credit`-Feld (Position 6). v1 hat noch KEINEN echten
         * Frame-Dispatcher (der genau dafür in der Sondierung als
         * Phase-6-Bedarf vermerkt wurde) — wer auf `flow` wartet, MUSS
         * also sicher sein, dass als Nächstes wirklich nur `flow` kommen
         * kann (hier: direkt nach Attach oder wenn Credit erschöpft ist).
         */
        fn awaitFlow() -> Nothing
        {
            let f = Amqp10::readFrame(this.conn);
            if f.frameType != 0 {
                this.errorMessage = "erwartete AMQP-Frame (type=0) beim Warten auf flow, bekam frameType=" + f.frameType.toString();
                return;
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x13 {
                this.errorMessage = "erwartete flow (0x13), bekam descriptor=" + p.descriptor.toString();
                return;
            }
            // Feldpositionen: next-incoming-id(0), incoming-window(1),
            // next-outgoing-id(2), outgoing-window(3), handle(4),
            // delivery-count(5), link-credit(6).
            if p.fields.len() > 6 {
                match p.fields[6] { UIntVal(n) => { this.linkCredit = n; } _ => {} }
            }
        }

        /*
         * Sendet `flow` und vergibt `amount` Link-Credit an den Broker
         * (Receiver-Rolle — der Broker darf uns danach bis zu `amount`
         * `transfer`s schicken). Kein Äquivalent in 0-9-1, wo
         * `basic.consume` sofort unbegrenzt liefert; hier zwingend, sonst
         * schickt der Broker gar nichts.
         */
        fn grantCredit(amount: Int64) -> Nothing
        {
            var flowFields: List<Amqp10Value> = [
                Amqp10Value::NullVal,               // next-incoming-id (v1 ungetrackt)
                Amqp10Value::UIntVal(2147483647),   // incoming-window
                Amqp10Value::UIntVal(0),            // next-outgoing-id
                Amqp10Value::UIntVal(2147483647),   // outgoing-window
                Amqp10Value::UIntVal(this.handle),
                Amqp10Value::UIntVal(this.deliveryCount),
                Amqp10Value::UIntVal(amount)
            ];
            let flowBody = Amqp10::encodePerformative(0x13, flowFields);
            Amqp10::writeFrame(this.conn, 0, this.chanId, flowBody);
            this.linkCredit = amount;
        }

        /*
         * Published eine Nachricht (Sender-Rolle). Wartet ggf. auf `flow`,
         * wenn kein Credit vorhanden ist (kreditbasierte Flow-Control ist
         * bei AMQP 1.0 für JEDEN Transfer zwingend, s. tasklist.md Phase
         * 6 — anders als 0-9-1, wo Publish immer sofort geht). v1:
         * `settled=true` (fire-and-forget wie 0-9-1s v1-Publish ohne
         * Publisher-Confirms, kein Disposition-Roundtrip pro Nachricht).
         * Body wird bei Überschreiten von `max-frame-size` auf mehrere
         * `transfer`-Frames mit `more=true` aufgeteilt (funktionales
         * Äquivalent zu 0-9-1s Multi-Frame-Body-Splitting, anderer
         * Mechanismus: `more`-Flag statt impliziter Fortsetzung).
         */
        fn publish(body: List<Int64>, contentType: String) -> Nothing
        {
            if this.linkCredit <= 0 {
                this.awaitFlow();
                if this.errorMessage.len() > 0 {
                    return;
                }
                if this.linkCredit <= 0 {
                    this.errorMessage = "kein Link-Credit trotz flow-Frame erhalten";
                    return;
                }
            }

            let msgBytes = Amqp10::encodeMessageBody(body, contentType);
            let deliveryTag = Amqp10::deliveryTagBytes(this.deliveryCount);

            // Grober, aber sicherer Overhead-Puffer für die Transfer-
            // Performative-Hülle selbst (Handle/Delivery-Id/Tag/Flags) —
            // v1 schätzt hier bewusst großzügig statt exakt zu rechnen.
            var maxBodyPerFrame: Int64 = this.maxFrameSize - 64;
            if maxBodyPerFrame < 1 {
                maxBodyPerFrame = 1;
            }

            var offset: Int64 = 0;
            var isFirst: Bool = true;
            while offset < msgBytes.len() || isFirst {
                var remaining: Int64 = msgBytes.len() - offset;
                var chunkSize: Int64 = remaining;
                if chunkSize > maxBodyPerFrame {
                    chunkSize = maxBodyPerFrame;
                }
                var more: Bool = false;
                if (offset + chunkSize) < msgBytes.len() {
                    more = true;
                }
                var chunk: List<Int64> = [];
                for i in 0..chunkSize {
                    chunk.push(msgBytes[offset + i]);
                }

                var transferFields: List<Amqp10Value> = [
                    Amqp10Value::UIntVal(this.handle),
                    Amqp10Value::UIntVal(this.deliveryCount),
                    Amqp10Value::BinaryVal(deliveryTag),
                    Amqp10Value::UIntVal(0),      // message-format
                    Amqp10Value::BoolVal(true),   // settled
                    Amqp10Value::BoolVal(more)
                ];
                let transferBody = Amqp10::encodePerformative(0x14, transferFields);
                var fullFrame: List<Int64> = [];
                for i in 0..transferBody.len() {
                    fullFrame.push(transferBody[i]);
                }
                for i in 0..chunk.len() {
                    fullFrame.push(chunk[i]);
                }
                Amqp10::writeFrame(this.conn, 0, this.chanId, fullFrame);

                offset = offset + chunkSize;
                isFirst = false;
            }

            this.linkCredit = this.linkCredit - 1;
            this.deliveryCount = this.deliveryCount + 1;
        }

        /*
         * Blockierender Pull der nächsten Nachricht (Receiver-Rolle,
         * setzt grantCredit() voraus). v1 setzt KEIN Multi-Frame-
         * Reassembling für empfangene Transfers um (Gegenstück zum
         * Sender-seitigen Splitting) — das ist eine bewusste v1-Lücke
         * (s. tasklist.md „Später"), weil der hier genutzte Test-/
         * Live-Broker-Rundtrip mit den in v1 verwendeten Nachrichten-
         * größen nie mehrere Transfer-Frames pro Delivery erzeugt;
         * `more=true` wird erkannt und als Fehler gemeldet statt
         * stillschweigend nur den ersten Teil zurückzugeben.
         */
        fn nextMessage() -> Amqp10Message
        {
            let f = Amqp10::readFrameSkipHeartbeats(this.conn);
            if f.frameType != 0 {
                return Amqp10Message { body: [], contentType: "", deliveryId: -1, ok: false, errorMessage: "erwartete AMQP-Frame (type=0), bekam frameType=" + f.frameType.toString() };
            }
            let r = Amqp10Reader::new(f.body);
            let v = r.readValue();
            var descriptor: Int64 = -1;
            var fields: List<Amqp10Value> = [];
            match v
            {
                DescribedVal(d) => {
                    match d.value { ListVal(fl) => { descriptor = d.descriptor; fields = fl; } _ => {} }
                }
                _ => {}
            }
            if descriptor != 0x14 {
                return Amqp10Message { body: [], contentType: "", deliveryId: -1, ok: false, errorMessage: "erwartete transfer (0x14), bekam descriptor=" + descriptor.toString() };
            }
            var deliveryId: Int64 = -1;
            if fields.len() > 1 {
                match fields[1] { UIntVal(n) => { deliveryId = n; } _ => {} }
            }
            if fields.len() > 5 {
                match fields[5] {
                    BoolVal(more) => {
                        if more {
                            return Amqp10Message { body: [], contentType: "", deliveryId: deliveryId, ok: false, errorMessage: "Multi-Frame-Transfer (more=true) wird in v1 nicht zusammengesetzt" };
                        }
                    }
                    _ => {}
                }
            }

            // Rest des Frame-Bodys nach der Performative sind die
            // Message-Sections (properties/data ODER amqp-value), roh
            // weiterlesen.
            //
            // Live-Cross-Check-Fund (python-qpid-proton, s. bugs.md):
            // andere Implementierungen kodieren einen einfachen String-
            // Body NICHT zwingend als `data`-Section (0x75, Rohbytes) —
            // Proton nutzt fuer `Message(body="...")` eine `amqp-value`-
            // Section (0x77) mit einem `StrVal` darin. Ohne Behandlung
            // dieses Falls kaeme hier ein leerer Body zurueck, OBWOHL
            // `ok=true` gemeldet wuerde — genau das Silent-Garbage-Muster,
            // das dieses Projekt vermeiden will. v1 behandelt deshalb
            // BEIDE Formen UND schlaegt hart fehl (ok=false), wenn gar
            // keine erkannte Body-Section gefunden wurde, statt
            // stillschweigend einen leeren Body zurueckzugeben.
            let restBytes = r.readRawBytes(r.remaining());
            var body: List<Int64> = [];
            var contentType: String = "";
            var bodyFound: Bool = false;
            let mr = Amqp10Reader::new(restBytes);
            while mr.remaining() > 0 {
                let sv = mr.readValue();
                match sv
                {
                    DescribedVal(sd) => {
                        if sd.descriptor == 0x75 {
                            match sd.value { BinaryVal(b) => { body = b; bodyFound = true; } _ => {} }
                        }
                        if sd.descriptor == 0x77 {
                            match sd.value {
                                BinaryVal(b) => { body = b; bodyFound = true; }
                                StrVal(s) => {
                                    for i in 0..s.len() {
                                        body.push(s.charCodeAt(i) & 0xFF);
                                    }
                                    bodyFound = true;
                                }
                                _ => {}
                            }
                        }
                        if sd.descriptor == 0x73 {
                            match sd.value {
                                ListVal(propFields) => {
                                    if propFields.len() > 6 {
                                        match propFields[6] { SymbolVal(s) => { contentType = s; } _ => {} }
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
            }
            if !bodyFound {
                return Amqp10Message { body: [], contentType: contentType, deliveryId: deliveryId, ok: false, errorMessage: "keine erkannte Body-Section (data/amqp-value) im Transfer gefunden" };
            }

            this.deliveryCount = this.deliveryCount + 1;
            this.linkCredit = this.linkCredit - 1;
            return Amqp10Message { body: body, contentType: contentType, deliveryId: deliveryId, ok: true, errorMessage: "" };
        }

        /*
         * Bestätigt eine per nextMessage() erhaltene Nachricht (Receiver-
         * Rolle) — sendet `disposition` mit `state=accepted`, `settled=
         * true`. AMQP-1.0-Äquivalent zu 0-9-1s `basic.ack`, hier mit
         * granularerem Delivery-State-Modell (v1 nutzt nur `accepted`,
         * s. tasklist.md „Später" für rejected/released/modified).
         */
        fn ack(deliveryId: Int64) -> Nothing
        {
            let acceptedDesc = Amqp10Described { descriptor: 0x24, value: Amqp10Value::ListVal([]) };
            var dispFields: List<Amqp10Value> = [
                Amqp10Value::BoolVal(true),                    // role: true=receiver
                Amqp10Value::UIntVal(deliveryId),              // first
                Amqp10Value::NullVal,                          // last (nur diese eine Delivery)
                Amqp10Value::BoolVal(true),                    // settled
                Amqp10Value::DescribedVal(acceptedDesc)        // state: accepted
            ];
            let dispBody = Amqp10::encodePerformative(0x15, dispFields);
            Amqp10::writeFrame(this.conn, 0, this.chanId, dispBody);
        }
    }
}
