{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"types": [
			"node",
			"mocha"
		],
		"typeRoots": [
			"./node_modules/@types"
		],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"rootDir": "src",
		"strict": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"out"
	]
}
