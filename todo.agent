# Tinox Compiler — Open Work for AI Agent
#
# Arbeite diese Tasks sequenziell ab. Nach jedem Task:
#   1. cargo build  (muss fehlerfrei sein)
#   2. cargo run --bin tinox -- check <relevante .tnx datei>
#   3. git add + commit mit aussagekräftiger Message
#
# Codebase: /ki/tinox
# Sprache:  Rust (Compiler), Tinox (.tnx, eigene Sprache mit Java-ähnlicher Syntax)
# Backend:  LLVM IR → llc → cc
# Struktur:
#   crates/tinox-lexer/src/lib.rs          — Tokenizer, Keyword enum
#   crates/tinox-parser/src/ast.rs         — AST-Typen
#   crates/tinox-parser/src/parser.rs      — Parser
#   crates/tinox-parser/src/formatter.rs   — tinox fmt
#   crates/tinox-typecheck/src/lib.rs      — Typprüfer
#   crates/tinox-typecheck/src/annotations.rs — REST-Annotation-Processing
#   crates/tinox-codegen/src/codegen.rs    — LLVM IR Codegen
#   crates/tinox-codegen/src/lib.rs        — pub re-exports
#   crates/tinox-lsp/src/analysis.rs       — LSP-Analyse
#   runtime/runtime.c                      — C-Laufzeit
#   crates/tinox-core/                     — Stdlib .tnx Dateien

# =============================================================================
# TASK 1 — String-Felder in Structs: inttoptr beim Laden
# =============================================================================
# Problem:
#   Wenn eine Klasse oder ein `unmodifiable` ein String-Feld hat und man es
#   liest (FieldAccess), wird der rohe i64-Wert zurückgegeben statt i8*.
#   Alle Struct-Felder werden als i64 gespeichert (via ptrtoint). Beim Lesen
#   eines String-Feldes fehlt die Rückkonvertierung inttoptr i64 → i8*.
#
# Symptom:
#   unmodifiable Person(name: String, age: Int64)
#   var p: Person = Person.new("Alice", 30);
#   print(p.name);   // gibt die Pointer-Adresse als Dezimalzahl aus statt "Alice"
#
# Wo fixen:
#   crates/tinox-codegen/src/codegen.rs
#   Suche: ExprKind::FieldAccess — dort wird ein i64 geladen.
#   Nach dem Load: wenn der Feldtyp String ist (i8*), dann:
#     %cast = inttoptr i64 %loaded to i8*
#     return ("%cast", "i8*")
#   Der Feldtyp kann bestimmt werden über struct_layouts + class_ast_map
#   oder über struct_field_class_types (für Named-Typen).
#   Für primitive Typen (Int64, Bool, Float64) ist keine Konversion nötig.
#   Für Named-Typen (andere Klassen) braucht man:
#     %cast = inttoptr i64 %loaded to i64*
#   Das gleiche gilt für Val/Let-Felder in class-Instanzen.
#
# Testdatei: erstelle /ki/tinox/examples/test_string_fields.tnx
#   unmodifiable Person(name: String, age: Int64)
#   class Product { var name: String; var price: Int64; }
#   fn main() {
#       var p: Person = Person.new("Alice", 30);
#       print(p.name);   // soll "Alice" ausgeben
#       print(p.age);    // soll "30" ausgeben
#   }

# =============================================================================
# TASK 2 — Function-Type-Felder in Klassen (fnc(...) -> T als Feldtyp)
# =============================================================================
# Problem:
#   Klassen können Felder vom Typ `fnc(X) -> Y` haben (Funktions-Callbacks),
#   z.B. in http_server.tnx:
#     class Route {
#         var handler: fnc(HttpContext) -> Unit;
#     }
#   Beim Aufruf `route.handler(ctx)` kann der Typchecker die Funktion nicht
#   auflösen → "undefined function: Route_handler"
#
# Was fehlt:
#   1. Typecheck (crates/tinox-typecheck/src/lib.rs):
#      In check_expr für MethodCall: wenn das Objekt eine Klassen-Instanz ist
#      und das "Feld" ein Funktionstyp ist, den Rückgabetyp des Funktionstyps
#      zurückgeben statt Fehler.
#      Alternativ: FieldAccess + Call kombinieren. In gen_expr für
#      ExprKind::MethodCall: wenn `route.handler` ein Funktionstyp-Feld ist,
#      lade den i64-Wert (=Funktionszeiger), cast zu Funktionstyp, und rufe auf.
#   2. Codegen (crates/tinox-codegen/src/codegen.rs):
#      Wenn `obj.method(args)` und `method` kein bekannter Methodenname ist,
#      prüfen ob `obj.method` ein Funktions-Feld ist. Falls ja:
#        %fp_i64 = [load field "method" from obj]
#        %fp = inttoptr i64 %fp_i64 to void (i64*)* (passend zum Typ)
#        call void %fp(args...)
#
# Testdatei: erstelle /ki/tinox/examples/test_fn_fields.tnx
#   class Handler { var fn_: fnc(Int64) -> Int64; }
#   fn main() {
#       var h: Handler = Handler { fn_: fnc(x: Int64) -> Int64 { return x * 2; } };
#       var r: Int64 = h.fn_(21);
#       print(r);   // soll "42" ausgeben
#   }

# =============================================================================
# TASK 3 — `toLowerCase` / `toUpperCase` String-Methoden
# =============================================================================
# Problem:
#   Der Typecheck registriert "String_toLowerCase" und "String_toUpperCase"
#   (Zeile ~524 in typecheck/src/lib.rs), aber der Codegen kennt nur
#   "toLower" und "toUpper" (codegen.rs ~2357, ~2804).
#
# Fehler:
#   rest_test.tnx:413: error: undefined function: Any_toLowerCase
#   (tritt auf weil der Typinferenz "Any" statt "String" ausgibt, aber das
#    eigentliche Problem ist die fehlende Methode im Codegen)
#
# Was zu tun:
#   crates/tinox-codegen/src/codegen.rs
#   In den MethodCall-Blöcken wo "toUpper"/"toLower" behandelt werden,
#   auch "toUpperCase" / "toLowerCase" als Alias hinzufügen.
#   Suche nach: "toUpper" => und "toLower" => (zwei Stellen, ~2357 und ~2804)
#   Für jede Stelle:
#     "toUpper" | "toUpperCase" => { ... call tinox_string_toUpper ... }
#     "toLower" | "toLowerCase" => { ... call tinox_string_toLower ... }
#
# Außerdem: in runtime/runtime.c prüfen ob tinox_string_toLower und
#   tinox_string_toUpper implementiert sind. Falls nicht, implementieren.
#   (Falls ja als tinox_str_toLower o.ä., Namen angleichen.)

# =============================================================================
# TASK 4 — `unmodifiable` im LSP unterstützen
# =============================================================================
# Problem:
#   crates/tinox-lsp/src/analysis.rs matcht auf DeclKind-Varianten.
#   Die neue Variante DeclKind::Unmodifiable wird nicht behandelt →
#   LSP ignoriert unmodifiable-Deklarationen (kein Hover, kein Go-to-def).
#
# Was zu tun:
#   crates/tinox-lsp/src/analysis.rs
#   Alle match-Arme auf DeclKind durchsuchen (grep "DeclKind::Class").
#   Für jeden Arm, der DeclKind::Class behandelt, auch DeclKind::Unmodifiable
#   analog behandeln:
#     - Symbol-Registrierung (Name, Span) für Hover/Go-to-def
#     - Feld-Registrierung (name.field → Typ) für Completions
#     - new()-Methode als Callable registrieren
#   Der Unmodifiable-Typ hat: name: Ident, fields: Vec<Param>, span: Span.
#   (Keine Methoden — nur fields und auto-generiertes new())

# =============================================================================
# TASK 5 — `RouteMatcher` Rückgabetyp-Inferenz in rest_test.tnx
# =============================================================================
# Problem:
#   Der Typecheck kann den Rückgabetyp von user-definierten statischen Methoden
#   wie `RouteMatcher::splitPath(...)` nicht immer korrekt zu `List<String>`
#   auflösen. Stattdessen gibt er `RouteMatcher` zurück, was downstream
#   Typfehler verursacht:
#     expected Array, found RouteMatcher
#
#   Ursache: In check_expr für ExprKind::StaticCall (ClassName::method(...))
#   wird der Rückgabetyp aus symbols.functions gelesen. Wenn der Return-Typ
#   List<String> ist, wird er aber als ValueType::Named("List") aufgelöst statt
#   als ValueType::Array.
#
# Was zu tun:
#   crates/tinox-typecheck/src/lib.rs
#   In type_to_value: wenn Type::Generic { name: "List", args: [...] } oder
#   Type::Generic { name: "Array", args: [...] } → ValueType::Array zurückgeben.
#   Prüfen ob das schon so ist; falls nicht, fixen.
#   Außerdem: StaticCall-Dispatch im Typechecker prüfen ob Rückgabetyp
#   korrekt aus der FunctionSignature übernommen wird.
#
# Testdatei: cargo run --bin tinox -- check /ki/tinox/examples/rest_test.tnx
#   Ziel: die "expected Array, found RouteMatcher" Fehler verschwinden.

# =============================================================================
# TASK 6 — `Map`-Typ Gleichheit in Typchecker
# =============================================================================
# Problem:
#   rest_test.tnx:810: error: expected Map, found Map
#   Zwei verschiedene Map-Typen (z.B. Map<String,String> vs Map<String,JsonValue>)
#   werden als unterschiedlich betrachtet, obwohl im Tinox-Typchecker Maps
#   als einheitlicher `ValueType::Map` behandelt werden sollten.
#
# Was zu tun:
#   crates/tinox-typecheck/src/lib.rs
#   In types_compatible / type_check_assign:
#   Wenn beide Typen ValueType::Map sind, als kompatibel behandeln.
#   (Tinox hat kein generisches Map-Typ-System auf Typcheck-Ebene —
#    alle Maps sind zur Laufzeit gleich behandelt.)

# =============================================================================
# TASK 7 — `HttpServer` Rückgabetyp bei `new()` in rest_test.tnx
# =============================================================================
# Problem:
#   rest_test.tnx:234: error: expected String, found HttpServer
#   HttpServer.new(port) wird korrekt als HttpServer-Instanz erkannt,
#   aber irgendwo wird erwartet dass es ein String ist.
#
# Was zu tun:
#   rest_test.tnx Zeile 234 anschauen und verstehen warum dort String
#   erwartet wird. Wahrscheinlich ein verketteter Ausdruck wie:
#     let s: String = "port: " + HttpServer.new(port);
#   Das wäre ein Typfehler im Tinox-Code selbst. Alternativ kann es ein
#   Typinferenz-Bug im Compiler sein.
#   Datei lesen: cat /ki/tinox/examples/rest_test.tnx | sed -n '230,240p'
#   Dann entscheiden: Bug im Compiler oder Bug in rest_test.tnx.

# =============================================================================
# TASK 8 — Compiler Warnings bereinigen
# =============================================================================
# Problem:
#   cargo build zeigt viele Warnings:
#   - unused imports (Pos, BinaryOp, Namespace, Param, UnaryOp, UnmodifiableDecl)
#   - unused variables (num_locals, arm_body_bbs, val_ty, rt, etc.)
#   - dead_code (closure_envs, struct_fields, get_field_offset, etc.)
#   - unreachable_patterns (Type::Generic doppelt in type_to_llvm)
#
# Was zu tun:
#   Alle Warnings aus `cargo build 2>&1 | grep "^warning:"` beheben:
#   1. Unused imports entfernen:
#      - crates/tinox-parser/src/parser.rs: Pos entfernen
#      - crates/tinox-codegen/src/codegen.rs: BinaryOp, Namespace, Param,
#        UnaryOp, UnmodifiableDecl aus dem use-Statement entfernen
#        (UnmodifiableDecl wird nur in emit_unmodifiable_new gebraucht,
#         dort als tinox_parser::UnmodifiableDecl direkt qualifiziert verwenden)
#   2. Unused variables mit _ prefixen oder entfernen
#   3. Unreachable Type::Generic Pattern in type_to_llvm fixen
#      (die erste Generic-Arm matcht alles, die zweite wird nie erreicht)
#   Ziel: cargo build produziert 0 Warnings.

# =============================================================================
# TASK 9 — `unmodifiable` in Namespace-Scope unterstützen
# =============================================================================
# Problem:
#   `unmodifiable` wird aktuell nur auf Top-Level-Deklarationsebene
#   verarbeitet. In Namespace-Scopes (wie alle stdlib-Klassen) wird es
#   vom Typchecker und Codegen nicht erkannt.
#
# Was zu tun:
#   crates/tinox-typecheck/src/lib.rs
#   Im Namespace-inner-Loop (wo DeclKind::Class in Namespaces behandelt wird,
#   ~Zeile 751) auch DeclKind::Unmodifiable analog behandeln.
#   (Gleiche Logik wie Top-Level: Felder und new()-Methode registrieren)
#
#   crates/tinox-codegen/src/codegen.rs
#   Im second-pass Namespace-Loop (~Zeile 482) auch DeclKind::Unmodifiable
#   behandeln: emit_unmodifiable_new aufrufen.
#   Außerdem im ersten Pass (struct layout registration): auch Namespace-
#   inner-Decls nach Unmodifiable durchsuchen.
#
# Test:
#   namespace myns { unmodifiable Vec2(x: Int64, y: Int64) }
#   fn main() { var v: Vec2 = Vec2.new(3, 4); print(v.x); }

# =============================================================================
# TASK 10 — `String.indexOf` / `String.substring` Codegen
# =============================================================================
# Problem:
#   rest_test.tnx und http_server.tnx nutzen String-Methoden wie:
#     str.indexOf("?")        → Int64
#     str.substring(0, n)     → String
#     str.trim()              → String
#   Diese sind im Typecheck registriert, aber im Codegen möglicherweise
#   nicht vollständig implementiert.
#
# Was zu tun:
#   1. crates/tinox-codegen/src/codegen.rs:
#      In MethodCall-Dispatch für String-Methoden prüfen ob indexOf und
#      substring implementiert sind. Falls nicht:
#        "indexOf" → call i64 @tinox_string_index_of(i8* %s, i8* %sub)
#        "substring" → call i8* @tinox_string_substring(i8* %s, i64 %start, i64 %end)
#   2. runtime/runtime.c:
#      Falls nicht vorhanden, implementieren:
#        int64_t tinox_string_index_of(const char* s, const char* sub) {
#            char* p = strstr(s, sub); return p ? (int64_t)(p - s) : -1; }
#        char* tinox_string_substring(const char* s, int64_t start, int64_t end) {
#            int64_t len = end - start; char* r = malloc(len+1);
#            strncpy(r, s+start, len); r[len] = '\0'; return r; }
#   3. Typecheck-Declarations (lib.rs ~Zeile 514) prüfen ob beide registriert.
#
# Test: cargo run --bin tinox -- check /ki/tinox/examples/rest_test.tnx
#   Ziel: indexOf/substring Fehler verschwinden.
