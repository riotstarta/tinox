import tinox.core.crypto;

class Main
{
    fnc main() -> Int32
    {
        let hash: String = Crypto::sha256("hello, tinox!");
        println(hash);

        let signature: String = Crypto::hmacSha256("payload", "secret-key");
        println(signature);

        let key: String = Crypto::generateKey(32);
        println("random key length: " + key.len().toString());
        return 0;
    }
}
