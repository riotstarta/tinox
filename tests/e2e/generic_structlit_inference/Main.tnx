import Box;
import Pair;

// B2 Schritt 2 (Fortsetzung): Typargument-Inferenz für generische
// StructLiterale. Der Typecheck unifiziert die Feld-Initialisierer gegen die
// unerased Feld-Deklarationstypen (`Box { value: "x" }` → Named("Box",[String]))
// und der Codegen emittiert das Literal als Spezialisierung (Box__i8P) statt
// als generische Basis. Deckt den unannotierten UND den zuvor ebenfalls
// kaputten annotierten Fall ab (die Annotation wurde vom Literal-Pfad
// überschrieben), plus zwei Typ-Params. Bindungen an Scope-Typ-Params
// (T→U im generischen Rumpf) bleiben bewusst außen vor (Wache).
// expect: hallo
// expect: 5
// expect: 42
// expect: hi
// expect: 2
// expect: 7
// expect: eins
// expect: 2.5

class Main
{
    fnc main() -> Int32 {
        // Unannotiert: T=String aus dem Initialisierer
        let bs = Box { value: "hallo" };
        println(bs.value);                    // hallo
        println(bs.value.len().toString());  // 5

        // Unannotiert: T=Int64
        let bi = Box { value: 42 };
        println(bi.value.toString());        // 42

        // Annotiert (war ebenfalls kaputt: Literal-Pfad überschrieb die Annotation)
        let ba: Box<String> = Box { value: "hi" };
        println(ba.value);                    // hi
        println(ba.value.len().toString());  // 2

        // var-Pfad
        var bv = Box { value: 7 };
        println(bv.value.toString());        // 7

        // Zwei Typ-Params unabhängig gebunden
        let p = Pair { a: "eins", b: 2.5 };
        println(p.a);                         // eins
        println(p.b.toString());             // 2.5
        return 0;
    }
}
