// db: CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER NOT NULL);
// db: INSERT INTO users (name, age) VALUES ('Alice', 30);
// expect: 2
// expect: Bob
// expect: 21
// expect: Bobby
// expect: 22
// expect: 1

import tinox.core.db;

@Entity
@Table("users")
class orm_sqlite_save_delete
{
    @Id @GeneratedValue
    var id: Int64;
    @Column("name")
    var name: String;
    @Column("age")
    var age: Int64;
}

fn main() -> Int32
{
    let bob = new orm_sqlite_save_delete();
    bob.name = "Bob";
    bob.age = 21;
    DB.of(orm_sqlite_save_delete).save(bob);

    let all: List<orm_sqlite_save_delete> = DB.of(orm_sqlite_save_delete).orderBy(u => u.id).list();
    println(all.len());
    println(all[1].name);
    println(all[1].age);

    let toUpdate: orm_sqlite_save_delete = DB.of(orm_sqlite_save_delete).filter(u => u.name == "Bob").first();
    toUpdate.name = "Bobby";
    toUpdate.age = 22;
    DB.of(orm_sqlite_save_delete).save(toUpdate);

    let updated: orm_sqlite_save_delete = DB.of(orm_sqlite_save_delete).filter(u => u.id == toUpdate.id).first();
    println(updated.name);
    println(updated.age);

    DB.of(orm_sqlite_save_delete).delete(updated);
    let remaining: List<orm_sqlite_save_delete> = DB.of(orm_sqlite_save_delete).list();
    println(remaining.len());

    return 0;
}
