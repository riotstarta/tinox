// Bug 10: List-Literal mit gemischten Enum-Varianten war korrupt
// expect: id
// expect: lit:x
// expect: fld:foo
// expect: id
enum Filter {
    Identity,
    LiteralStr(String),
    FieldAccess(String),
}

fn show(f: Filter) -> Nothing {
    match f {
        Identity => println("id");
        LiteralStr(s) => println("lit:" + s);
        FieldAccess(n) => println("fld:" + n);
    }
}

fn main() -> Int32 {
    let args: List<Filter> = [
        Filter::Identity,
        Filter::LiteralStr("x"),
        Filter::FieldAccess("foo"),
        Filter::Identity,
    ];
    var i = 0;
    while i < args.len() {
        show(args[i]);
        i += 1;
    }
    return 0;
}
