// Bug 10: List-Literal mit gemischten Enum-Varianten war korrupt
// expect: id
// expect: lit:x
// expect: fld:foo
// expect: id
enum bug10_mixed_enum_list_literal {
    Identity,
    LiteralStr(String),
    FieldAccess(String),
}

fn show(f: bug10_mixed_enum_list_literal) -> Nothing {
    match f {
        Identity => println("id");
        LiteralStr(s) => println("lit:" + s);
        FieldAccess(n) => println("fld:" + n);
    }
}

fn main() -> Int32 {
    let args: List<bug10_mixed_enum_list_literal> = [
        bug10_mixed_enum_list_literal::Identity,
        bug10_mixed_enum_list_literal::LiteralStr("x"),
        bug10_mixed_enum_list_literal::FieldAccess("foo"),
        bug10_mixed_enum_list_literal::Identity,
    ];
    var i = 0;
    while i < args.len() {
        show(args[i]);
        i += 1;
    }
    return 0;
}
