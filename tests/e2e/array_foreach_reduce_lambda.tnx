// Array.forEach(lambda) und Array.reduce(init, lambda): forEach ruft die
// Closure als void auf (Wert wird verworfen), reduce führt einen Akku vom
// Typ des Startwerts durch den Loop (Int64, Float64 und String gedeckt).
// expect: 1
// expect: 2
// expect: 3
// expect: 6
// expect: 6.5
// expect: a|bb|ccc
// expect: 60
fn main() -> Int32 {
    let xs = [1, 2, 3];

    // forEach (auch capturing wäre erlaubt; hier plain print)
    xs.forEach(x => println(x.toString()));

    // reduce Int64
    let total = xs.reduce(0, (acc, x) => acc + x);
    println(total.toString());

    // reduce Float64 (Akku-Typ = Init-Typ double)
    let fs = [1.0, 2.5, 3.0];
    let fsum = fs.reduce(0.0, (a, x) => a + x);
    println(fsum.toString());

    // reduce String (Akku i8*, capturing Separator)
    let sep = "|";
    let joined = ["a", "bb", "ccc"].reduce("", (acc, w) => {
        if (acc.len() == 0) {
            return w;
        }
        return acc + sep + w;
    });
    println(joined);

    // reduce mit capturing Faktor
    let factor = 10;
    let scaled = xs.reduce(0, (acc, x) => acc + x * factor);
    println(scaled.toString());
    return 0;
}
