// Bug 9: verschachtelte Enum-Payloads wurden korrupt
// expect: reduce
// expect: acc
// expect: a
// expect: b
enum bug09_nested_enum_payloads {
    Identity,
    FieldAccess(String),
    Pipe(bug09_nested_enum_payloads, bug09_nested_enum_payloads),
    Reduce(bug09_nested_enum_payloads, String, bug09_nested_enum_payloads, bug09_nested_enum_payloads),
}

fn main() -> Int32 {
    let f = bug09_nested_enum_payloads::Reduce(bug09_nested_enum_payloads::Identity, "acc", bug09_nested_enum_payloads::Identity,
        bug09_nested_enum_payloads::Pipe(bug09_nested_enum_payloads::FieldAccess("a"), bug09_nested_enum_payloads::FieldAccess("b")));
    match f {
        Reduce(gen, v, init, body) => {
            println("reduce");
            println(v);
            match body {
                Pipe(l, r) => {
                    match l {
                        FieldAccess(n1) => println(n1);
                        _ => println("-");
                    }
                    match r {
                        FieldAccess(n2) => println(n2);
                        _ => println("-");
                    }
                }
                _ => println("-");
            }
        }
        _ => println("-");
    }
    return 0;
}
