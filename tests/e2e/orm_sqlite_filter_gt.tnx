// db: CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER NOT NULL);
// db: INSERT INTO users (name, age) VALUES ('Alice', 30), ('Bob', 20), ('Carol', 35);
// expect: 2
// expect: Alice

import tinox.core.db;

@Entity
@Table("users")
class User
{
    @Id @GeneratedValue
    var id: Int64;
    @Column("name")
    var name: String;
    @Column("age")
    var age: Int64;
}

fn main() -> Int32
{
    let adults: List<User> = DB.of(User)
        .filter(u => u.age > 25)
        .list();
    println(adults.len());
    println(adults[0].name);
    return 0;
}
