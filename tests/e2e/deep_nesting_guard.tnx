// Rekursions-Tiefen-Guard (Bug 49): tief verschachtelter Ausdruck knapp unter dem
// Limit muss sauber kompilieren (der große Compiler-Stack + MAX_RECURSION_DEPTH
// verhindern den Stack-Overflow, den pathologisch tiefe Eingabe früher auslöste).
// Dieser Test prüft die legitime Seite — dass moderate Verschachtelung (hier ~40
// tief geklammert und ~30 verschachtelte if) NICHT fälschlich abgelehnt wird.
// expect: deep: 7
// expect: nested if ok

fn deep() -> Int64 {
    // 40-fach geklammerter Ausdruck — legitim, muss durchgehen
    return ((((((((((((((((((((((((((((((((((((((((7))))))))))))))))))))))))))))))))))))))));
}

fn nested(n: Int64) -> String {
    // verschachtelte if-Kette
    if n == 1 { if n == 1 { if n == 1 { if n == 1 { if n == 1 {
        return "nested if ok";
    } } } } }
    return "?";
}

fn main() -> Int32 {
    println("deep: " + deep().toString());
    println(nested(1));
    return 0;
}
