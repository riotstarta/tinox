// Array.filter(lambda) als Sprachfeature: Prädikat-Lambda wird als
// i1-Closure aufgerufen, passende Elemente werden unverändert (roher
// i64-Slot) in ein frisches Handle gepusht — der Eingabe-Elementmarker
// bleibt am Ergebnis erhalten (Array:String -> Array:String usw.).
// Deckt Int64, Float64, String, Objekte und capturing Prädikate ab.
// expect: 1
// expect: 2
// expect: 2
// expect: 2.5
// expect: 3
// expect: 2
// expect: hi
// expect: ok
// expect: 1
// expect: 7
// expect: 2
// expect: 1
// expect: 6
// expect: 0
class Point {
    var x: Int64;
    var y: Int64;
    fn sum() -> Int64 { return this.x + this.y; }
}

fn main() -> Int32 {
    // Int64
    let xs = [1, 2, 3];
    let evens = xs.filter(x => x % 2 == 0);
    println(evens.len().toString());
    println(evens[0].toString());

    // Float64
    let fs = [1.0, 2.5, 3.0];
    let big = fs.filter(x => x > 2.0);
    println(big.len().toString());
    println(big[0].toString());
    println(big[1].toString());

    // String: Marker bleibt, Ergebnis weiter methodenfähig
    let ws = ["hi", "world", "ok"].filter(s => s.len() <= 2);
    println(ws.len().toString());
    println(ws[0]);
    println(ws[1]);

    // Objekte: Feldzugriff im Prädikat, Methodenaufruf danach
    let ps = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    let bigp = ps.filter(p => p.x > 2);
    println(bigp.len().toString());
    println(bigp[0].sum().toString());

    // capturing Prädikat
    let limit = 3;
    let below = xs.filter(x => x < limit);
    println(below.len().toString());
    println(below[0].toString());

    // Chaining filter -> map
    let r = xs.filter(x => x >= 2).map(x => x * 2);
    println(r[1].toString());

    // leeres Array
    let e: List<Int64> = [];
    println(e.filter(x => x > 0).len().toString());
    return 0;
}
