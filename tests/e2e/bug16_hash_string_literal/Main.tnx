// Bug 16: a string literal with a leading # was lexed as a raw string (escapes broken)
// expect: 2
// expect: # top
// expect: a: 1
class Main
{
    fnc main() -> Int32 {
        let s = "# top\na: 1";
        let lines = s.split("\n");
        println(lines.len());
        println(lines[0]);
        println(lines[1]);
        return 0;
    }
}
