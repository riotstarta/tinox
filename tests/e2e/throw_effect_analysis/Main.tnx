// throw-Effekt-Analyse (Bug 48): der per-Statement-throw-Check (Bug 40) wird nur
// nach Aufrufen von Funktionen emittiert, die transitiv werfen KÖNNEN. Dieser
// Test prüft die Korrektheit beider Seiten: eine nicht-werfende Funktion (die
// keine Checks bekommt) läuft normal durch, und eine werfende Funktion propagiert
// weiterhin korrekt über mehrere Frames bis zum catch — die Analyse darf keinen
// throw übersehen.
// expect: pure: 28
// expect: c wirft, gefangen: tief
// expect: pure in mixed: 10
// expect: nach mixed
// expect: ende

class Main
{
    fnc pure(n: Int64) -> Int64 {
        // wirft nie → Aufrufer bekommt keinen throw-Check
        if n <= 0 { return 0; }
        return n + pure(n - 1);
    }


    fnc c() -> Nothing { throw "tief"; }

    fnc b() -> Nothing { c(); println("b (nie)"); }

    fnc a() -> Nothing { b(); println("a (nie)"); }


    fnc mixed() -> Nothing {
        // ruft BEIDES: eine nicht-werfende (pure) und eine werfende Kette (a)
        let s: Int64 = pure(4);            // 0+1+2+3+4 = 10, kein Check noetig
        println("pure in mixed: " + s.toString());
        a();                               // wirft → muss propagieren
        println("nach a in mixed (nie)");
    }


    fnc main() -> Int32 {
        println("pure: " + pure(7).toString());    // 0..7 = 28, reiner Pfad, kein throw
        try { a(); } catch e: String { println("c wirft, gefangen: " + e); }
        try { mixed(); } catch e: String { println("nach mixed"); }
        println("ende");
        return 0;
    }
}
