// Typecheck→Codegen-Typtabelle (TESTPLAN Phase 4, Schritt 2): Container aus
// Ausdrücken ohne Codegen-Heuristik (match als Wert) sind elementgenau
// typisiert — Index-Zugriff und for-in liefern Strings, keine i64-Bitmuster.
// expect: 3
// expect: 2
// expect: 3
// expect: 5
fn main() -> Int32 {
    let n = 1;
    let xs = match n { 1 => ["aa", "bbb"], _ => ["z"] };
    println(xs[1].len());
    for s in xs { println(s.len()); }
    let m = @{"k" => "hello"};
    println(m.get("k").len());
    return 0;
}
