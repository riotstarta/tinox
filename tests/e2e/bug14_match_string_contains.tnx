// Bug 14: s.contains() auf match-gebundenen Strings ging durch Map-Dispatch
// expect: yes
// expect: no
enum JV {
    Str(String),
    Num(Int64),
}

fn has(v: JV, needle: String) -> Bool {
    match v {
        Str(s) => return s.contains(needle);
        _ => return false;
    }
}

fn main() -> Int32 {
    if has(JV::Str("say hello!"), "hello") { println("yes"); } else { println("-"); }
    if has(JV::Str("say hello!"), "xyz") { println("-"); } else { println("no"); }
    return 0;
}
