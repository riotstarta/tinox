// expect: 3
// expect: 3
// expect: 4
// expect: 4
// expect: 3

fn addOne(xs: List<Int64>) -> Int64
{
    xs.push(99);
    return xs.len();
}

fn main() -> Int32
{
    var a: List<Int64> = [1, 2];
    let b = a;
    a.push(3);
    println(b.len());
    println(b[2]);
    println(addOne(a));
    println(a.len());
    a.pop();
    println(b.len());
    return 0;
}
