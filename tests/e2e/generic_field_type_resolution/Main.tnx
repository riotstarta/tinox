// B2 Schritt 1: ValueType trägt jetzt generische Typargumente
// (generic_field_type_resolution<Int64> -> Named("generic_field_type_resolution", [Int])), sodass ein T-typisiertes Feld einer
// Instanz zur konkreten Typ aufgelöst wird. Behebt drei vorbestehende Bugs (in
// B1-Phase 4 gefunden): T-Feld-.toString(), T-Feld-Assignment, und direkten
// T-Feld-Read. Deckt Int64-, String- und Float64-Instanziierungen ab.
// expect: 42
// expect: hi
// expect: 3.5
// expect: welt
// expect: 1

import generic_field_type_resolution;

class Main
{
    fnc main() -> Int32 {
        // T=Int64: .toString() auf T-Feld muss aufgelöst werden
        let bi: generic_field_type_resolution<Int64> = generic_field_type_resolution::make(42, 1);
        println(bi.value.toString());        // 42

        // T=String: direkter T-Feld-Read (println(String))
        let bs: generic_field_type_resolution<String> = generic_field_type_resolution::make("hi", 2);
        println(bs.value);                    // hi

        // T=Float64
        let bf: generic_field_type_resolution<Float64> = generic_field_type_resolution::make(3.5, 3);
        println(bf.value.toString());        // 3.5

        // T-Feld-Assignment: Literal muss zum aufgelösten T (String) passen
        bs.value = "welt";
        println(bs.value);                    // welt

        // Nicht-T-Feld (Int64) bleibt korrekt
        println(bi.tag.toString());          // 1
        return 0;
    }
}
