// db: CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER NOT NULL);
// db: INSERT INTO users (name, age) VALUES ('Alice', 30), ('Bob', 25), ('Carol', 35);
// expect: 3
// expect: Alice

import tinox.core.db;

@Entity
@Table("users")
class orm_sqlite_list
{
    @Id @GeneratedValue
    var id: Int64;
    @Column("name")
    var name: String;
    @Column("age")
    var age: Int64;
}

fn main() -> Int32
{
    let users: List<orm_sqlite_list> = DB.of(orm_sqlite_list).list();
    println(users.len());
    println(users[0].name);
    return 0;
}
