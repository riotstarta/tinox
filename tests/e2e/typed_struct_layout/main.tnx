import Inner;
import Outer;

// B1 Phase 1: getypte LLVM-Struct-Layouts (%class.<name>) für einfache Klassen.
// Feldzugriff nutzt jetzt ein getyptes GEP + direktes typed load statt i64-Slot +
// bitcast. Das Layout bleibt byte-identisch (jedes Feld ein 8-Byte-Slot), daher
// müssen Float-, String-, Int- und Objekt-Referenz-Felder unverändert korrekt
// gelesen werden — inkl. verschachtelter Objektzugriffe.
// Phase 2 ergänzt die Store-Seite: StructLiteral-Konstruktion schreibt Felder
// über getypte GEP + `store <slot>` (double/ptr/i64), inkl. Bool (i1 -> i64-Slot).
// expect: 7.5
// expect: hallo
// expect: 42
// expect: -3
// expect: flag-true
// expect: 5.5
// expect: welt
// expect: flag-false
// expect: 100

fn main() -> Int32 {
    let o: Outer = Outer::make();
    println((o.fx + o.fy).toString());   // 7.5 — Float-Felder (double-Slot)
    println(o.name);                      // hallo — String-Feld (ptr-Slot)
    println(o.inner.value.toString());    // 42 — Objekt-Feld -> Int-Feld
    println(o.inner.neg.toString());      // -3 — negativer Int
    if o.flag { println("flag-true"); } else { println("flag-false"); }  // Bool i1->i64-Slot

    // Phase 3: getypte Feld-Assignments (obj.f = v) über double/ptr/i64-Slots
    o.fx = 1.5;
    o.name = "welt";
    o.flag = false;
    o.inner.value = 100;                  // Assignment auf Objekt-Feld -> Int
    println((o.fx + o.fy).toString());    // 5.5
    println(o.name);                       // welt
    if o.flag { println("flag-true"); } else { println("flag-false"); }  // flag-false
    println(o.inner.value.toString());     // 100
    return 0;
}
