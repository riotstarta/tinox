// Bug 2: == auf match-gebundenen Strings gab immer false
// expect: eq
// expect: neq
enum JV {
    Str(String),
    Num(Int64),
}

fn same(a: JV, b: JV) -> Bool {
    match a {
        Str(sv) => {
            match b {
                Str(bs) => return sv == bs;
                _ => return false;
            }
        }
        _ => return false;
    }
}

fn main() -> Int32 {
    let x = "he" + "llo";
    if same(JV::Str("hello"), JV::Str(x)) { println("eq"); } else { println("-"); }
    if same(JV::Str("hello"), JV::Str("world")) { println("-"); } else { println("neq"); }
    return 0;
}
