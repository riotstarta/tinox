// Issue 71: throw-Unwinding lief nur auf Statement-Granularitaet (Bug 40) — in
// einem zusammengesetzten Ausdruck wie `a() + b()` lief `b()` trotzdem noch,
// wenn `a()` schon geworfen hatte; die Pruefung griff erst an der naechsten
// Statement-Grenze. Gefixt: gen_expr prueft jetzt nach JEDEM werfenden
// Teilausdruck sofort, nicht erst am Statement-Ende.
// expect: caught binary: boom-a
// expect: caught call-args: boom-a
// expect: caught array-lit: boom-a
// expect: caught method-args: boom-a
// expect: caught nested: boom-a
// expect: fertig

fn a() -> Int64 { throw "boom-a"; }
fn b() -> Int64 { println("b ran (should NOT happen)"); return 1; }

fn sum(x: Int64, y: Int64) -> Int64 { return x + y; }

class throw_substatement_unwinding {
    var total: Int64;
    fn add(x: Int64, y: Int64) -> Int64 { return x + y; }
}

fn main() -> Int32 {
    // Binaerer Ausdruck: a() wirft, b() darf nicht mehr laufen.
    try {
        let r: Int64 = a() + b();
        println("unreached:" + r.toString());
    } catch e: String {
        println("caught binary: " + e);
    }

    // Funktionsargumente: a() als erstes Argument wirft, b() (zweites
    // Argument) darf nicht mehr ausgewertet werden.
    try {
        let r: Int64 = sum(a(), b());
        println("unreached:" + r.toString());
    } catch e: String {
        println("caught call-args: " + e);
    }

    // Array-Literal: gleiche Regel fuer Elemente nach einem werfenden Element.
    try {
        let xs: List<Int64> = [a(), b()];
        println("unreached:" + xs.len().toString());
    } catch e: String {
        println("caught array-lit: " + e);
    }

    // Methodenaufruf-Argumente.
    try {
        let acc: throw_substatement_unwinding = throw_substatement_unwinding { total: 0 };
        let r: Int64 = acc.add(a(), b());
        println("unreached:" + r.toString());
    } catch e: String {
        println("caught method-args: " + e);
    }

    // Verschachtelt: der werfende Aufruf steckt selbst als ARGUMENT in einem
    // inneren Call (sum(a(), b())); das darf das AEUSSERE zweite Argument
    // (nochmal b()) genauso wenig mehr auswerten wie das innere.
    try {
        let r: Int64 = sum(sum(a(), b()), b());
        println("unreached:" + r.toString());
    } catch e: String {
        println("caught nested: " + e);
    }

    println("fertig");
    return 0;
}
