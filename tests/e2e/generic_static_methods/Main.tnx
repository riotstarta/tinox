// Generische statische Methoden: explizite Typargumente (deserialize<generic_static_methods>,
// T::fromJson-Substitution) und Inferenz aus Argumenten (serialize, auch List<T>)
// expect: {"id":7,"name":"Alice"}
// expect: 7
// expect: Alice
// expect: [{"id":1,"name":"A"},{"id":2,"name":"B"}]
import tinox.core.json;

import generic_static_methods;

class Main
{
    fnc main() -> Int32 {
        let u = generic_static_methods { id: 7, name: "Alice" };
        let j: String = Json::serialize(u);
        println(j);
        let back: generic_static_methods = Json::deserialize<generic_static_methods>(j);
        println(back.id);
        println(back.name);
        let users: List<generic_static_methods> = [generic_static_methods { id: 1, name: "A" }, generic_static_methods { id: 2, name: "B" }];
        println(Json::serialize(users));
        return 0;
    }
}
