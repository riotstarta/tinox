// db: CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER NOT NULL);
// db: INSERT INTO users (name, age) VALUES ('Zara', 28), ('Alice', 30), ('Bob', 25), ('Carol', 35);
// expect: 2
// expect: Alice
// expect: Bob

import tinox.core.db;

@Entity
@Table("users")
class User
{
    @Id @GeneratedValue
    var id: Int64;
    @Column("name")
    var name: String;
    @Column("age")
    var age: Int64;
}

fn main() -> Int32
{
    let top2: List<User> = DB.of(User)
        .orderBy(u => u.name)
        .limit(2)
        .list();
    println(top2.len());
    println(top2[0].name);
    println(top2[1].name);
    return 0;
}
