// Bug 52: eine generische Instanzmethode OHNE T-Parameter (fn get() -> T),
// aufgerufen als Class::get(obj), muss ihre Spezialisierung aus dem Empfänger-
// Marker ableiten (bs: Box<String> -> Box__i8P), nicht auf den i64-Default fallen.
// Zuvor rief Box::get(bs) fälschlich Box__i64_get und gab den String-Zeiger als
// Zahl aus (silent garbage). Deckt String-, Int64- und Float64-Empfänger ab.
// expect: hi
// expect: 42
// expect: 3.5

class Box<T> {
    var value: T;
    fn make(v: T) -> Box<T> { return Box { value: v }; }
    fn get() -> T { return this.value; }
}

fn main() -> Int32 {
    let bs: Box<String> = Box::make("hi");
    println(Box::get(bs));               // hi — Box__i8P (Empfänger-Bindung)

    let bi: Box<Int64> = Box::make(42);
    println(Box::get(bi).toString());    // 42 — Box__i64

    let bf: Box<Float64> = Box::make(3.5);
    println(Box::get(bf).toString());    // 3.5 — Box__double
    return 0;
}
