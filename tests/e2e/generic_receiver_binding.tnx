// Bug 52: eine generische Instanzmethode OHNE T-Parameter (fn get() -> T),
// aufgerufen als Class::get(obj), muss ihre Spezialisierung aus dem Empfänger-
// Marker ableiten (bs: generic_receiver_binding<String> -> Box__i8P), nicht auf den i64-Default fallen.
// Zuvor rief generic_receiver_binding::get(bs) fälschlich Box__i64_get und gab den String-Zeiger als
// Zahl aus (silent garbage). Deckt String-, Int64- und Float64-Empfänger ab.
// expect: hi
// expect: 42
// expect: 3.5

class generic_receiver_binding<T> {
    var value: T;
    fn make(v: T) -> generic_receiver_binding<T> { return generic_receiver_binding { value: v }; }
    fn get() -> T { return this.value; }
}

fn main() -> Int32 {
    let bs: generic_receiver_binding<String> = generic_receiver_binding::make("hi");
    println(generic_receiver_binding::get(bs));               // hi — Box__i8P (Empfänger-Bindung)

    let bi: generic_receiver_binding<Int64> = generic_receiver_binding::make(42);
    println(generic_receiver_binding::get(bi).toString());    // 42 — Box__i64

    let bf: generic_receiver_binding<Float64> = generic_receiver_binding::make(3.5);
    println(generic_receiver_binding::get(bf).toString());    // 3.5 — Box__double
    return 0;
}
