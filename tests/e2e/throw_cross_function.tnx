// Cross-Funktions-Throw: throw ohne lokales try propagiert zum
// nächsten try im Aufrufer (via @__tinox_err)
// expect: caught: kaputt
// expect: cleanup
// expect: ok: 5
// expect: done
fn divide(a: Int64, b: Int64) -> Int64 {
    if b == 0 {
        throw "kaputt";
    }
    return a / b;
}

fn main() -> Int32 {
    try {
        let r = divide(10, 0);
        println("unreachable");
    }
    catch e: String {
        println("caught: " + e);
    }
    finally {
        println("cleanup");
    }
    try {
        let r2 = divide(10, 2);
        println("ok: " + r2.toString());
    }
    catch e: String {
        println("nope");
    }
    println("done");
    return 0;
}
