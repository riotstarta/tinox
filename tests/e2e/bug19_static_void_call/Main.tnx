// Bug 19: Class::method(obj, …) auf einer Nothing-Methode emittierte
// "%tmp.N = call void …" — benannte void-Calls sind ungültiges IR.
// Gefunden vom Stdlib-Smoke-Gate (Trie::insert, Env::setVar, …).
// expect: 5
// expect: ok

import bug19_static_void_call;

class Main
{
    fnc main() -> Int32 {
        let c: bug19_static_void_call = bug19_static_void_call::mk();
        bug19_static_void_call::voidy(c, 5);
        println("ok");
        return 0;
    }
}
