// Array.map(lambda) als Sprachfeature: inline IR-Loop über das
// {len,cap,data}-Handle, Lambda-Aufruf über den Closure-Block {fn_ptr, env}.
// Deckt Int64, Float64, String, Objekte, capturing Lambdas, typwechselnde
// Lambdas (Int->String, String->Int) und Chaining ab. Der Ergebnis-Marker
// wird aus dem Lambda-Rückgabetyp abgeleitet (Typecheck-Wertbrücke).
// expect: 2
// expect: 4
// expect: 6
// expect: 3
// expect: 7
// expect: ANNA
// expect: CARL
// expect: 30
// expect: 1!
// expect: 3
// expect: 3
// expect: 7
// expect: 8
// expect: 0
import array_map_lambda;

class Main
{
    fnc main() -> Int32 {
        // Int64
        let xs = [1, 2, 3];
        let doubled = xs.map(x => x * 2);
        println(doubled[0].toString());
        println(doubled[1].toString());
        println(doubled[2].toString());

        // Float64 (Slots sind bitcast-doubles)
        let fs = [1.5, 3.5];
        let fdoubled = fs.map(x => x * 2.0);
        println(fdoubled[0].toString());
        println(fdoubled[1].toString());

        // String (Marker Array:String bleibt am Ergebnis nutzbar)
        let names = ["anna", "carl"];
        let upper = names.map(s => s.toUpper());
        println(upper[0]);
        println(upper[1]);

        // capturing Lambda
        let factor = 10;
        let scaled = xs.map(x => x * factor);
        println(scaled[2].toString());

        // typwechselnd: Int -> String und String -> Int
        let strs = xs.map(x => x.toString() + "!");
        println(strs[0]);
        let lens = ["a", "bb", "ccc"].map(s => s.len());
        println(lens[2].toString());

        // Objekt-Array: Methoden-Dispatch im Lambda-Body
        let ps = [array_map_lambda { x: 1, y: 2 }, array_map_lambda { x: 3, y: 4 }];
        let sums = ps.map(p => p.sum());
        println(sums[0].toString());
        println(sums[1].toString());

        // Chaining: map auf map-Ergebnis
        let chained = xs.map(x => x * 2).map(x => x + 2);
        println(chained[2].toString());

        // leeres Array
        let e: List<Int64> = [];
        println(e.map(x => x * 2).len().toString());
        return 0;
    }
}
