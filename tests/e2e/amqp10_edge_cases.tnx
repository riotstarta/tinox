// AMQP-1.0 Phase 7 (tasklist.md): Haertung + Grenzfaelle, analog zu
// 0-9-1 Phase 5.2 (amqp_edge_cases.tnx/amqp_shortstr_limits.tnx).
//
// Teil A (netzwerkfrei): str8/sym8/vbin8-Kurzformen an ihrer 255-Byte-
// Grenze (Reader MUSS sie lesen koennen, auch wenn der Writer sie nie
// schreibt, s. Phase 2.2/2.5) + Rundtrip von >255-Byte-Strings/Symbolen/
// Binaerdaten ueber den Writer (v1 schreibt IMMER die 32-Bit-Form
// vbin32/str32/sym32, s. tasklist.md 2.2 -- deshalb existiert anders als
// bei 0-9-1s shortstr KEINE 255-Byte-Schreibgrenze, die einen Bug 71-
// artigen Silent-Truncate-Fund erlauben wuerde; dieser Test bestaetigt
// das empirisch statt es nur in der Doku zu behaupten).
//
// Teil B (simulierter Broker via spawn/await): leerer Message-Body im
// vollen Publish/Consume-Roundtrip + Multi-Frame-Transfer-Grenze exakt
// am max-frame-size-Cutoff (ein Byte drunter = 1 Frame, ein Byte drueber
// = 2 Frames -- Off-by-one-Absicherung fuer Amqp10Link::publish()s
// Split-Logik). overhead wird zur Laufzeit ueber echtes
// encodeMessageBody() gemessen statt hart codiert, damit der Test robust
// gegen Aenderungen an der Section-Kodierung bleibt.
//
// Workaround fuer Bug 67 (bugs.md, async fn -> Bool verliert Rueckgabetyp):
// fakeBroker gibt Int64 (0/1) zurueck statt Bool.
// expect: ok-str8-255
// expect: ok-str8-empty
// expect: ok-vbin8-empty
// expect: ok-sym8-255
// expect: ok-longstring
// expect: ok-longsymbol
// expect: ok-longbinary
// expect: ok-connect
// expect: ok-publish-empty
// expect: ok-publish-exact
// expect: ok-publish-plus1
// expect: ok-consume-empty
// expect: ok-consume-exact
// expect: ok-consume-plus1
// expect: ok-broker-empty-1frame
// expect: ok-broker-exact-1frame
// expect: ok-broker-plus1-2frames
// expect: ok-broker-saw-all

import tinox.core.amqp10;
import tinox.core.socket;

class amqp10_edge_cases {
    var frameCount: Int64;
    var bytes: List<Int64>;
}

// Liest transfer-Frames bis more=false, haengt die Message-Section-
// Rohbytes aneinander. Gemeinsamer Baustein fuer alle drei
// Broker-seitigen Empfangspfade unten (statt dreifacher Kopie wie in
// amqp10_transfer_flow.tnx, wo es nur zwei waren).
fn reassembleTransfer(sconn: Int64) -> amqp10_edge_cases {
    var bytes: List<Int64> = [];
    var more: Bool = true;
    var count: Int64 = 0;
    while more {
        let fT = Amqp10::readFrame(sconn);
        count = count + 1;
        let r = Amqp10Reader::new(fT.body);
        let v = r.readValue();
        more = false;
        match v {
            DescribedVal(d) => {
                match d.value {
                    ListVal(tf) => {
                        if tf.len() > 5 {
                            match tf[5] { BoolVal(b) => { more = b; } _ => {} }
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        let rest = r.readRawBytes(r.remaining());
        for i in 0..rest.len() { bytes.push(rest[i]); }
    }
    return amqp10_edge_cases { frameCount: count, bytes: bytes };
}

fn relayMessage(sconn: Int64, chanId: Int64, handle: Int64, tag: Int64, msgBytes: List<Int64>) -> Nothing {
    var transferFields: List<Amqp10Value> = [
        Amqp10Value::UIntVal(handle), Amqp10Value::UIntVal(tag),
        Amqp10Value::BinaryVal([tag]), Amqp10Value::UIntVal(0),
        Amqp10Value::BoolVal(true), Amqp10Value::BoolVal(false)
    ];
    let transferBody = Amqp10::encodePerformative(0x14, transferFields);
    var fullFrame: List<Int64> = [];
    for i in 0..transferBody.len() { fullFrame.push(transferBody[i]); }
    for i in 0..msgBytes.len() { fullFrame.push(msgBytes[i]); }
    Amqp10::writeFrame(sconn, 0, chanId, fullFrame);
}

async fn fakeBroker(srv: Int64) -> Int64 {
    let sconn = httpServerAcceptConnHandle(srv);

    // --- SASL-Header + Negotiation ---
    httpConnReadN(sconn, 8);
    httpConnWriteBytes(sconn, [65, 77, 81, 80, 3, 1, 0, 0]);
    let mechBody = Amqp10::encodePerformative(0x40, [Amqp10Value::ListVal([Amqp10Value::SymbolVal("PLAIN")])]);
    Amqp10::writeFrame(sconn, 1, 0, mechBody);
    Amqp10::readFrame(sconn);
    let outcomeBody = Amqp10::encodePerformative(0x44, [Amqp10Value::UByteVal(0)]);
    Amqp10::writeFrame(sconn, 1, 0, outcomeBody);

    // --- AMQP-Header ---
    httpConnReadN(sconn, 8);
    httpConnWriteBytes(sconn, [65, 77, 81, 80, 0, 1, 0, 0]);

    // --- open / open-ok: max-frame-size=100 -> maxBodyPerFrame=36 (100-64) ---
    Amqp10::readFrame(sconn);
    var openFields: List<Amqp10Value> = [
        Amqp10Value::StrVal("fake-broker"),
        Amqp10Value::NullVal,
        Amqp10Value::UIntVal(100),
        Amqp10Value::UShortVal(2047)
    ];
    Amqp10::writeFrame(sconn, 0, 0, Amqp10::encodePerformative(0x10, openFields));

    // --- begin / begin-ok ---
    let fBegin = Amqp10::readFrame(sconn);
    var beginFields: List<Amqp10Value> = [
        Amqp10Value::UShortVal(fBegin.chanId), Amqp10Value::UIntVal(0),
        Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(2147483647)
    ];
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x11, beginFields));

    // --- attach (Sender) / attach-ok + flow(credit=3) -- alle drei Publishes brauchen Credit ---
    let fAttach1 = Amqp10::readFrame(sconn);
    let pAttach1 = Amqp10::decodePerformative(fAttach1.body);
    var okAttach1: Bool = pAttach1.descriptor == 0x12;
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, pAttach1.fields));
    var flowFields: List<Amqp10Value> = [
        Amqp10Value::NullVal, Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(0),
        Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(0), Amqp10Value::UIntVal(0),
        Amqp10Value::UIntVal(3)
    ];
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x13, flowFields));

    // --- drei Transfers empfangen + reassemblieren: leer, exakte Grenze, Grenze+1 ---
    let rEmpty = reassembleTransfer(sconn);
    let rExact = reassembleTransfer(sconn);
    let rPlus1 = reassembleTransfer(sconn);

    // --- detach (Sender) / detach-ok ---
    let fDetach1 = Amqp10::readFrame(sconn);
    let pDetach1 = Amqp10::decodePerformative(fDetach1.body);
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x16, pDetach1.fields));

    // --- attach (Receiver) / attach-ok ---
    let fAttach2 = Amqp10::readFrame(sconn);
    let pAttach2 = Amqp10::decodePerformative(fAttach2.body);
    // Issue 76: Link-Handles sind jetzt fortlaufend (Sender-Link=0,
    // dieser Receiver-Link=1) statt immer 0 — relayMessage() muss das
    // echte Handle aus dem Attach uebernehmen, sonst schlaegt
    // Amqp10Link::nextMessage()s neue Handle-Pruefung fehl.
    var subLinkHandle: Int64 = 0;
    if pAttach2.fields.len() > 1 {
        match pAttach2.fields[1] { UIntVal(n) => { subLinkHandle = n; } _ => {} }
    }
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, pAttach2.fields));

    // --- flow vom Client (Credit-Vergabe fuer den Receiver-Link) lesen ---
    Amqp10::readFrame(sconn);

    // --- alle drei Nachrichten byte-identisch zurueckspiegeln + je auf disposition warten ---
    relayMessage(sconn, fBegin.chanId, subLinkHandle, 11, rEmpty.bytes);
    let fDisp1 = Amqp10::readFrame(sconn);
    let pDisp1 = Amqp10::decodePerformative(fDisp1.body);
    var okAck1: Bool = pDisp1.descriptor == 0x15;

    relayMessage(sconn, fBegin.chanId, subLinkHandle, 12, rExact.bytes);
    let fDisp2 = Amqp10::readFrame(sconn);
    let pDisp2 = Amqp10::decodePerformative(fDisp2.body);
    var okAck2: Bool = pDisp2.descriptor == 0x15;

    relayMessage(sconn, fBegin.chanId, subLinkHandle, 13, rPlus1.bytes);
    let fDisp3 = Amqp10::readFrame(sconn);
    let pDisp3 = Amqp10::decodePerformative(fDisp3.body);
    var okAck3: Bool = pDisp3.descriptor == 0x15;

    // --- detach / end / close ---
    let fDetach2 = Amqp10::readFrame(sconn);
    let pDetach2 = Amqp10::decodePerformative(fDetach2.body);
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x16, pDetach2.fields));
    Amqp10::readFrame(sconn);
    Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x17, []));
    Amqp10::readFrame(sconn);
    Amqp10::writeFrame(sconn, 0, 0, Amqp10::encodePerformative(0x18, []));

    httpConnClose(sconn);

    if rEmpty.frameCount == 1 {
        println("ok-broker-empty-1frame");
    }
    if rExact.frameCount == 1 {
        println("ok-broker-exact-1frame");
    }
    if rPlus1.frameCount == 2 {
        println("ok-broker-plus1-2frames");
    }
    var allOk: Int64 = 0;
    if okAttach1 { if okAck1 { if okAck2 { if okAck3 {
        allOk = 1;
    } } } }
    return allOk;
}

fn main() -> Int32 {
    // --- Teil A: netzwerkfreie Typsystem-Grenzfaelle ---

    // str8 (0xa1) an der 255-Byte-Grenze -- Formcode + 1-Byte-Laenge +
    // 255 Datenbytes, von Hand gebaut (der Writer schreibt nur str32).
    var str8Bytes: List<Int64> = [0xa1, 255];
    for i in 0..255 { str8Bytes.push(65); }
    let str8Reader = Amqp10Reader::new(str8Bytes);
    match str8Reader.readValue() {
        StrVal(s) => { if s.len() == 255 { println("ok-str8-255"); } }
        _ => {}
    }

    // str8 mit Laenge 0 -- Randfall am UNTEREN Ende der 1-Byte-Laenge.
    let str8EmptyReader = Amqp10Reader::new([0xa1, 0]);
    match str8EmptyReader.readValue() {
        StrVal(s) => { if s.len() == 0 { println("ok-str8-empty"); } }
        _ => {}
    }

    // vbin8 (0xa0) mit Laenge 0.
    let vbin8EmptyReader = Amqp10Reader::new([0xa0, 0]);
    match vbin8EmptyReader.readValue() {
        BinaryVal(b) => { if b.len() == 0 { println("ok-vbin8-empty"); } }
        _ => {}
    }

    // sym8 (0xa3) an der 255-Byte-Grenze.
    var sym8Bytes: List<Int64> = [0xa3, 255];
    for i in 0..255 { sym8Bytes.push(66); }
    let sym8Reader = Amqp10Reader::new(sym8Bytes);
    match sym8Reader.readValue() {
        SymbolVal(s) => { if s.len() == 255 { println("ok-sym8-255"); } }
        _ => {}
    }

    // Writer-seitiger Rundtrip fuer > 255 Byte -- v1 schreibt IMMER die
    // 32-Bit-Form (str32/sym32/vbin32), es gibt also KEINE
    // Schreib-Obergrenze wie bei 0-9-1s shortstr (Bug-Fund dort).
    var longStr: String = "";
    for i in 0..300 { longStr = longStr + "A"; }
    let wStr = Amqp10Writer::new();
    wStr.writeString(longStr);
    match Amqp10Reader::new(wStr.bytes).readValue() {
        StrVal(s) => { if s.len() == 300 { println("ok-longstring"); } }
        _ => {}
    }

    var longSym: String = "";
    for i in 0..300 { longSym = longSym + "B"; }
    let wSym = Amqp10Writer::new();
    wSym.writeSymbol(longSym);
    match Amqp10Reader::new(wSym.bytes).readValue() {
        SymbolVal(s) => { if s.len() == 300 { println("ok-longsymbol"); } }
        _ => {}
    }

    var longBin: List<Int64> = [];
    for i in 0..300 { longBin.push(67); }
    let wBin = Amqp10Writer::new();
    wBin.writeBinary(longBin);
    match Amqp10Reader::new(wBin.bytes).readValue() {
        BinaryVal(b) => { if b.len() == 300 { println("ok-longbinary"); } }
        _ => {}
    }

    // --- Teil B: simulierter Broker, leerer Body + Multi-Frame-Grenze ---
    let srv = httpServerCreate(47630);
    if srv < 0 {
        println("bind fehlgeschlagen");
        return 1;
    }
    let handle = spawn fakeBroker(srv);

    let conn = Amqp10Connection::connect("127.0.0.1", 47630, "guest", "guest");
    if conn.conn <= 0 {
        println("connect fehlgeschlagen: " + conn.errorMessage);
        return 1;
    }
    println("ok-connect");

    let session = Amqp10Session::begin(conn);
    var link = Amqp10Link::attach(session, "pub-link", false, "test-target");

    // overhead zur Laufzeit messen statt hart zu codieren -- robust
    // gegen Aenderungen an encodeMessageBody()s Section-Layout.
    let overhead = Amqp10::encodeMessageBody([], "t").len();
    let maxBodyPerFrame = link.maxFrameSize - 64; // s. Amqp10Link::publish()
    let exactLen = maxBodyPerFrame - overhead;
    let plus1Len = exactLen + 1;

    var exactBody: List<Int64> = [];
    for i in 0..exactLen { exactBody.push(66); }
    var plus1Body: List<Int64> = [];
    for i in 0..plus1Len { plus1Body.push(67); }

    link.publish([], "t");
    if link.errorMessage.len() == 0 {
        println("ok-publish-empty");
    }
    link.publish(exactBody, "t");
    if link.errorMessage.len() == 0 {
        println("ok-publish-exact");
    }
    link.publish(plus1Body, "t");
    if link.errorMessage.len() == 0 {
        println("ok-publish-plus1");
    }

    link.detach();

    let subLink = Amqp10Link::attach(session, "sub-link", true, "test-source");
    subLink.grantCredit(5);

    let mEmpty = subLink.nextMessage();
    if mEmpty.ok {
        if mEmpty.body.len() == 0 {
            println("ok-consume-empty");
        }
        subLink.ack(mEmpty.deliveryId);
    }

    let mExact = subLink.nextMessage();
    if mExact.ok {
        if mExact.body.len() == exactLen {
            println("ok-consume-exact");
        }
        subLink.ack(mExact.deliveryId);
    }

    let mPlus1 = subLink.nextMessage();
    if mPlus1.ok {
        if mPlus1.body.len() == plus1Len {
            println("ok-consume-plus1");
        }
        subLink.ack(mPlus1.deliveryId);
    }

    subLink.detach();
    session.end();
    conn.close();

    let brokerOk = await handle;
    if brokerOk == 1 {
        println("ok-broker-saw-all");
    }

    httpServerClose(srv);
    return 0;
}
