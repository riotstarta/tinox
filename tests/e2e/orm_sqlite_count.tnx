// db: CREATE TABLE products (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, price INTEGER NOT NULL);
// db: INSERT INTO products (name, price) VALUES ('Widget', 50), ('Gadget', 150), ('Doohickey', 75);
// expect: 3
// expect: 2

import tinox.core.db;

@Entity
@Table("products")
class orm_sqlite_count
{
    @Id @GeneratedValue
    var id: Int64;
    @Column("name")
    var name: String;
    @Column("price")
    var price: Int64;
}

fn main() -> Int32
{
    let total: Int64 = DB.of(orm_sqlite_count).count();
    println(total);
    let cheap: Int64 = DB.of(orm_sqlite_count)
        .filter(p => p.price < 100)
        .count();
    println(cheap);
    return 0;
}
