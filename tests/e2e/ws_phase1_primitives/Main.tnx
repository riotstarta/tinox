// WebSocket Phase 1 (tasklist.md 1.1–1.3): SHA-1 + wsAcceptKey + binärsichere
// Conn-Primitiven. SHA-1-Vektoren aus RFC 3174 (leer, "abc") plus ein
// Mehrblock-Input (128×"a"); wsAcceptKey gegen das RFC-6455-Beispiel
// (dGhlIHNhbXBsZSBub25jZQ== → s3pPLMBiTxaQ9kYGzzhZRbK+xOo=). Danach Loopback:
// Bytes MIT NUL (72,0,255,7,200) durch httpConnWriteBytes/httpConnReadN in
// beide Richtungen — genau der Fall, an dem die C-String-Primitiven abreißen.
// expect: da39a3ee5e6b4b0d3255bfef95601890afd80709
// expect: a9993e364706816aba3e25717850c26c9cd0d89d
// expect: ad5b3fdbcb526778c2839d2f151ea753995e26a0
// expect: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
// expect: 5
// expect: 72 0 255 7 200
// expect: 3
// expect: 0 128 0

import tinox.core.crypto;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // SHA-1 Testvektoren
        println(Crypto::sha1(""));
        println(Crypto::sha1("abc"));
        var longInput: String = "";
        for i in 0..128 {
            longInput = longInput + "a";
        }
        println(Crypto::sha1(longInput));

        // Sec-WebSocket-Accept (RFC 6455 §1.3 Beispiel)
        println(wsAcceptKey("dGhlIHNhbXBsZSBub25jZQ=="));

        // Loopback: Server + Client im selben Prozess (Backlog hält die pending
        // Connection, daher geht connect-vor-accept single-threaded).
        let srv = httpServerCreate(47613);
        if srv < 0 {
            println("bind fehlgeschlagen");
            return 1;
        }
        let cfd = socketCreateTcp();
        if !socketConnect(cfd, "127.0.0.1", 47613) {
            println("connect fehlgeschlagen");
            return 1;
        }
        let sconn = httpServerAcceptConnHandle(srv);
        let cconn = httpConnFromFd(cfd);

        // Client → Server: 5 Bytes inkl. NUL und 0xFF
        let out = [72, 0, 255, 7, 200];
        httpConnWriteBytes(cconn, out);
        let got = httpConnReadN(sconn, 5);
        println(got.len().toString());
        println(got[0].toString() + " " + got[1].toString() + " " + got[2].toString() + " " + got[3].toString() + " " + got[4].toString());

        // Server → Client: NUL am Anfang und Ende
        let back = [0, 128, 0];
        httpConnWriteBytes(sconn, back);
        let got2 = httpConnReadN(cconn, 3);
        println(got2.len().toString());
        println(got2[0].toString() + " " + got2[1].toString() + " " + got2[2].toString());

        httpConnClose(sconn);
        httpConnClose(cconn);
        httpServerClose(srv);
        return 0;
    }
}
