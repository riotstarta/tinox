// Bug 13: sv + bs auf match-gebundenen Strings machte Integer-Addition
// expect: hello world
enum bug13_match_string_concat {
    Str(String),
    Num(Int64),
}

fn cat(a: bug13_match_string_concat, b: bug13_match_string_concat) -> String {
    match a {
        Str(sv) => {
            match b {
                Str(bs) => return sv + bs;
                _ => return "";
            }
        }
        _ => return "";
    }
}

fn main() -> Int32 {
    println(cat(bug13_match_string_concat::Str("hello "), bug13_match_string_concat::Str("world")));
    return 0;
}
