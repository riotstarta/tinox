import User;
import Res;

// Bug 18: Klassen-Payloads aus match-Bindungen waren ungetypt ("Other") —
// Feldzugriff las immer Offset 0 mit i64-Typisierung (u.name druckte die id)
// expect: Alice
// expect: 7
// expect: Hi Alice
// expect: err: kaputt

fn main() -> Int32 {
    let r = Res::Ok(User { id: 7, name: "Alice" });
    match r {
        Ok(u) => {
            println(u.name);
            println(u.id);
            println(u.greet());
        }
        Err(m) => println(m);
    }
    let e = Res::Err("kaputt");
    match e {
        Ok(u) => println(u.name);
        Err(m) => println("err: " + m);
    }
    return 0;
}
