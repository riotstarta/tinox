// AMQP-0-9-1 Phase 3 (tasklist.md): Connection/Channel-Handshake.
// Ein per `spawn` gestarteter simulierter Broker (async fn) laeuft parallel
// zum blockierenden `AmqpConnection091::connect`/`AmqpChannel091::open` und
// spielt den kompletten Negotiation-Ablauf per Hand aus: connection.start ->
// start-ok -> tune -> tune-ok -> open -> open-ok, dann channel.open ->
// open-ok. Deckt den Erfolgspfad der State-Machine ab, ohne einen echten
// Broker zu brauchen (der wurde live gegen RabbitMQ 3-management manuell
// verifiziert, s. bugs.md/tasklist.md — inkl. SASL-Fehler und
// Unknown-Vhost-Fehlerpfad über echtes connection.close).
//
// Workaround fuer Bug 67 (bugs.md): `async fn -> Bool` + `await` verliert
// den Rueckgabetyp (Typechecker fuehrt das Ergebnis als Int64) -- fakeBroker
// gibt deshalb Int64 (0/1) zurueck statt Bool.
// expect: ok-connect
// expect: ok-framemax
// expect: ok-channel
// expect: ok-broker-saw-all

import tinox.core.amqp091;
import tinox.core.socket;

class Main
{

    async fnc fakeBroker(srv: Int64) -> Int64 {
        let sconn = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn, 8); // Protokoll-Header, schon in Phase 1 getestet

        // connection.start (10,10): version-major/minor, server-properties
        // (leere Table reicht - v1 wertet sie nicht aus), mechanisms, locales.
        let w1 = AmqpWriter091::new();
        w1.octet(0);
        w1.octet(9);
        var emptyProps: Map<String, AmqpFieldValue091> = Map::new();
        w1.fieldTable(emptyProps);
        w1.longstr("PLAIN");
        w1.longstr("en_US");
        let startPayload = Amqp091::encodeMethodPayload(10, 10, w1.bytes);
        Amqp091::writeFrame(sconn, 1, 0, startPayload);

        let f1 = Amqp091::readFrame(sconn);
        let startOk = Amqp091::decodeMethodPayload(f1.payload);
        var ok1: Bool = false;
        if startOk.classId == 10 {
            if startOk.methodId == 11 {
                ok1 = true;
            }
        }

        // connection.tune (10,30): channel-max, frame-max, heartbeat.
        let w2 = AmqpWriter091::new();
        w2.short(2047);
        w2.long(131072);
        w2.short(60);
        let tunePayload = Amqp091::encodeMethodPayload(10, 30, w2.bytes);
        Amqp091::writeFrame(sconn, 1, 0, tunePayload);

        let f2 = Amqp091::readFrame(sconn);
        let tuneOk = Amqp091::decodeMethodPayload(f2.payload);
        var ok2: Bool = false;
        if tuneOk.classId == 10 {
            if tuneOk.methodId == 31 {
                ok2 = true;
            }
        }

        // connection.open (10,40) erwarten, dann open-ok (10,41) senden.
        let f3 = Amqp091::readFrame(sconn);
        let openM = Amqp091::decodeMethodPayload(f3.payload);
        var ok3: Bool = false;
        if openM.classId == 10 {
            if openM.methodId == 40 {
                ok3 = true;
            }
        }

        let w3 = AmqpWriter091::new();
        w3.shortstr("");
        let openOkPayload = Amqp091::encodeMethodPayload(10, 41, w3.bytes);
        Amqp091::writeFrame(sconn, 1, 0, openOkPayload);

        // channel.open (20,10) auf Channel 1 erwarten, dann open-ok (20,11).
        let f4 = Amqp091::readFrame(sconn);
        let chanOpenM = Amqp091::decodeMethodPayload(f4.payload);
        var ok4: Bool = false;
        if chanOpenM.classId == 20 {
            if chanOpenM.methodId == 10 {
                if f4.chanId == 1 {
                    ok4 = true;
                }
            }
        }

        let w4 = AmqpWriter091::new();
        w4.longstr("");
        let chanOpenOkPayload = Amqp091::encodeMethodPayload(20, 11, w4.bytes);
        Amqp091::writeFrame(sconn, 1, 1, chanOpenOkPayload);

        httpConnClose(sconn);

        var allOk: Int64 = 0;
        if ok1 {
            if ok2 {
                if ok3 {
                    if ok4 {
                        allOk = 1;
                    }
                }
            }
        }
        return allOk;
    }


    fnc main() -> Int32 {
        let srv = httpServerCreate(47621);
        if srv < 0 {
            println("bind fehlgeschlagen");
            return 1;
        }
        let handle = spawn fakeBroker(srv);

        let c = AmqpConnection091::connect("127.0.0.1", 47621, "/", "guest", "guest");
        let ch = AmqpChannel091::open(c);

        let brokerOk = await handle;

        if c.conn > 0 {
            println("ok-connect");
        }
        if c.frameMax == 131072 {
            println("ok-framemax");
        }
        if ch.chanId == 1 {
            println("ok-channel");
        }
        if brokerOk == 1 {
            println("ok-broker-saw-all");
        }

        httpServerClose(srv);
        return 0;
    }
}
