// expect: 25
// expect: 27

class static_methods
{
    fnc square(n: Int64) -> Int64
    {
        return n * n;
    }
    fnc cube(n: Int64) -> Int64
    {
        return n * n * n;
    }
}
fn main() -> Int32
{
    println(static_methods::square(5));
    println(static_methods::cube(3));
    return 0;
}
