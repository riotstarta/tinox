// AMQP-0-9-1 Phase 1 (tasklist.md): Transport-Dial + Protokoll-Header-
// Handshake über eine echte Loopback-Conn. Diese Datei spielt beide Rollen:
// Amqp091 (Client-Modul unter Test) verbindet sich, ein hier per Hand
// gescripteter "Fake-Broker" (Server-Rolle über httpServerCreate/
// httpServerAcceptConnHandle) liest den Header und antwortet gezielt mit
// Erfolgs- bzw. Mismatch-Bytes. Send/Read sind bewusst in getrennten
// Amqp091-Methoden (sendProtocolHeader/checkHandshakeResponse) statt einer
// blockierenden Rundtrip-Funktion, damit sich Client- und Server-Schritte in
// einem einzigen Thread verschränken lassen (Muster wie
// ws_handshake_frames.tnx).
// expect: ok-dial-refused
// expect: ok-header-bytes
// expect: ok-handshake-success
// expect: ok-handshake-mismatch
// expect: ok-handshake-eof

import tinox.core.amqp091;
import tinox.core.socket;

fn main() -> Int32 {
    // --- dial() gegen einen Port ohne Listener: schneller, harter Fehlschlag ---
    let refused = Amqp091::dial("127.0.0.1", 39218);
    if refused == -1 {
        println("ok-dial-refused");
    }

    let srv = httpServerCreate(47615);
    if srv < 0 {
        println("bind fehlgeschlagen");
        return 1;
    }

    // --- Erfolgspfad: Fake-Broker antwortet mit Byte 1 (Beginn eines
    // METHOD-Frames, wie ein echter connection.start) ---
    let conn1 = Amqp091::dial("127.0.0.1", 47615);
    Amqp091::sendProtocolHeader(conn1);
    let sconn1 = httpServerAcceptConnHandle(srv);
    let hdr1 = httpConnReadN(sconn1, 8);
    if hdr1.len() == 8 {
        if hdr1[0] == 65 {
            if hdr1[1] == 77 {
                if hdr1[2] == 81 {
                    if hdr1[3] == 80 {
                        if hdr1[4] == 0 {
                            if hdr1[5] == 0 {
                                if hdr1[6] == 9 {
                                    if hdr1[7] == 1 {
                                        println("ok-header-bytes");
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    httpConnWriteBytes(sconn1, [1]);
    if Amqp091::checkHandshakeResponse(conn1) {
        println("ok-handshake-success");
    }
    httpConnClose(conn1);
    httpConnClose(sconn1);

    // --- Mismatch-Pfad: Fake-Broker echot den Protokoll-Header zurück
    // (erstes Byte 'A' = 65, kein Frame-Typ-Oktett) ---
    let conn2 = Amqp091::dial("127.0.0.1", 47615);
    Amqp091::sendProtocolHeader(conn2);
    let sconn2 = httpServerAcceptConnHandle(srv);
    httpConnReadN(sconn2, 8);
    httpConnWriteBytes(sconn2, [65, 77, 81, 80, 0, 0, 9, 1]);
    if !Amqp091::checkHandshakeResponse(conn2) {
        println("ok-handshake-mismatch");
    }
    httpConnClose(conn2);
    httpConnClose(sconn2);

    // --- EOF-Pfad: Fake-Broker schließt sofort ohne Antwort ---
    let conn3 = Amqp091::dial("127.0.0.1", 47615);
    Amqp091::sendProtocolHeader(conn3);
    let sconn3 = httpServerAcceptConnHandle(srv);
    httpConnReadN(sconn3, 8);
    httpConnClose(sconn3);
    if !Amqp091::checkHandshakeResponse(conn3) {
        println("ok-handshake-eof");
    }
    httpConnClose(conn3);

    httpServerClose(srv);
    return 0;
}
