// try-finally OHNE catch (Bug 42): finally läuft, dann wird der Fehler
// re-geworfen (propagiert) statt still geschluckt. Zuvor kompilierte dieser Fall
// gar nicht (fehlender Terminator im leeren-catches-Zweig -> ungültiges IR).
// Deckt ab: re-throw in aeusseren catch, normaler Pfad ohne Fehler (kein
// re-throw), und dass try-catch-finally mit gefangenem Fehler NICHT re-wirft.
// expect: vor throw
// expect: finally A
// expect: aeusserer catch: fehler
// expect: im try
// expect: finally B
// expect: nach try normal
// expect: gefangen: x
// expect: finally C
// expect: nach catch

fn risky() -> Nothing {
    try {
        println("vor throw");
        throw "fehler";
        println("nach throw (nie)");
    } finally {
        println("finally A");
    }
    println("nach try (nie — re-propagiert)");
}

fn noError() -> Nothing {
    try {
        println("im try");
    } finally {
        println("finally B");
    }
    println("nach try normal");
}

fn caught() -> Nothing {
    try {
        throw "x";
    } catch e: String {
        println("gefangen: " + e);
    } finally {
        println("finally C");
    }
    println("nach catch");
}

fn main() -> Int32 {
    try { risky(); } catch e: String { println("aeusserer catch: " + e); }
    noError();
    caught();
    return 0;
}
