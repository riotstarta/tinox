fn main() -> Int64 {
    let limit: Int64 = 1000000;
    var count: Int64 = 0;
    var i: Int64 = 2;
    var j: Int64 = 2;
    var is_prime: Int64 = 1;
    while i <= limit {
        is_prime = 1;
        j = 2;
        while j * j <= i {
            if i % j == 0 {
                is_prime = 0;
                break;
            }
            j = j + 1;
        }
        if is_prime == 1 {
            count = count + 1;
        }
        i = i + 1;
    }
    println("primes up to 1000000: ${count}");
    return 0;
}
