class Fib {
    fn compute(n: Int64) -> Int64 {
        if n <= 1 {
            return n;
        }
        return this.compute(n - 1) + this.compute(n - 2);
    }
}

fn main() -> Int64 {
    let f: Fib = Fib {};
    let result: Int64 = f.compute(40);
    println("fib(40) = ${result}");
    return 0;
}
