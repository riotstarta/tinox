<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

  <!-- Content-Type für .tinox Dateien -->
  <extension point="org.eclipse.core.contenttype.contentTypes">
    <content-type
      id="tinox.contenttype"
      name="Tinox Source File"
      base-type="org.eclipse.core.runtime.text"
      file-extensions="tinox"
      priority="normal"/>
  </extension>

  <!-- Language Server registrieren und an Content-Type binden -->
  <extension point="org.eclipse.lsp4e.languageServer">
    <server
      id="tinox.lsp"
      label="Tinox Language Server"
      class="tinox.eclipse.TinoxLanguageServer"/>
    <contentTypeMapping
      id="tinox.lsp"
      contentType="tinox.contenttype"/>
  </extension>

  <!-- Preference-Page für Binary-Pfad -->
  <extension point="org.eclipse.ui.preferencePages">
    <page
      id="tinox.preferences"
      name="Tinox"
      category="org.eclipse.ui.preferencePages.GeneralTextEditor"
      class="tinox.eclipse.TinoxPreferencePage"/>
  </extension>

  <!-- Preference-Store initialisieren -->
  <extension point="org.eclipse.core.runtime.preferences">
    <initializer class="tinox.eclipse.TinoxPreferenceInitializer"/>
  </extension>

  <!-- Run-Kommando -->
  <extension point="org.eclipse.ui.commands">
    <command id="tinox.run" name="Run Tinox File"/>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler commandId="tinox.run" class="tinox.eclipse.RunTinoxHandler"/>
  </extension>

  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <command commandId="tinox.run" label="Run Tinox File" style="push">
        <visibleWhen checkEnabled="false">
          <with variable="activeMenuSelection">
            <iterate>
              <adapt type="org.eclipse.core.resources.IFile">
                <test property="org.eclipse.core.resources.extension" value="tinox"/>
              </adapt>
            </iterate>
          </with>
        </visibleWhen>
      </command>
    </menuContribution>
    <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
      <toolbar id="tinox.toolbar">
        <command commandId="tinox.run" label="Run Tinox File" tooltip="Run Tinox File" style="push"/>
      </toolbar>
    </menuContribution>
  </extension>

  <!-- Keybinding: Ctrl+F11 für Tinox Run -->
  <extension point="org.eclipse.ui.bindings">
    <key sequence="M1+F11" commandId="tinox.run"
        schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
  </extension>

  <!-- TextMate-Grammatik für Syntax Highlighting -->
  <extension point="org.eclipse.tm4e.registry.grammars">
    <grammar
      scopeName="source.tinox"
      path="grammars/tinox.tmLanguage.json">
      <contentTypeBinding contentTypeId="tinox.contenttype"/>
    </grammar>
  </extension>

</plugin>
