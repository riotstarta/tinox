#!/usr/bin/env bash
# Pre-push-Gate: kein Push ohne grünes `make check` (TESTPLAN 0.1/Phase 3).
# Installieren mit: make install-hooks    Umgehen (Notfall): git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: make check läuft (Umgehen: git push --no-verify) …"
make check
