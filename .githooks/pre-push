#!/usr/bin/env bash
# Pre-push gate: no push without a green `make check` (TESTPLAN 0.1/Phase 3).
# Install with: make install-hooks    Bypass (emergency): git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: running make check (bypass: git push --no-verify) …"
make check
